nuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option                     | Description                                |\n| -------------------------- | ------------------------------------------ |\n| `-q, --hide-non-printable` | Replace non-printable characters with `?`. |","locale":"en","table":"table-5"},"3008":{"id":"/docs/User-Manuals/Operations/cli-92","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option            | Description       |\n| ----------------- | ----------------- |\n| `-R, --recursive` | List recursively. |","locale":"en","table":"table-5"},"3009":{"id":"/docs/User-Manuals/Operations/cli-93","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option          | Description         |\n| --------------- | ------------------- |\n| `-r, --reverse` | Reverse sort order. |","locale":"en","table":"table-5"},"3010":{"id":"/docs/User-Manuals/Operations/cli-94","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option        | Description                |\n| ------------- | -------------------------- |\n| `-t, --mtime` | Sort by modification time. |","locale":"en","table":"table-5"},"3011":{"id":"/docs/User-Manuals/Operations/cli-95","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option       | Description   |\n| ------------ | ------------- |\n| `-S, --size` | Sort by size. |","locale":"en","table":"table-5"},"3012":{"id":"/docs/User-Manuals/Operations/cli-96","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option        | Description                              |\n| ------------- | ---------------------------------------- |\n| `-u, --atime` | Use access time for display and sorting. |","locale":"en","table":"table-5"},"3013":{"id":"/docs/User-Manuals/Operations/cli-97","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"| Option              | Description          |\n| ------------------- | -------------------- |\n| `-l, --long-format` | Long listing format. |","locale":"en","table":"table-5"},"3014":{"id":"/docs/User-Manuals/Operations/cli-98","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"`chmod` / `chown` recurse with the `--recursive` flag, given before or after the other arguments. Permission strings support octal values such as `755` / `0o755` and symbolic forms such as `u=rwx,g=rx,o=rx`. `chown` supports `user:group`, `user:`, and `:group`.","locale":"en"},"3015":{"id":"/docs/User-Manuals/Operations/cli-99","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"The current implementation uses `mount` for three related workflows:","locale":"en"},"3016":{"id":"/docs/User-Manuals/Operations/cli-100","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`cv mount`: list all mount points","locale":"en"},"3017":{"id":"/docs/User-Manuals/Operations/cli-101","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`cv mount --check`: list mount points and validate UFS reachability","locale":"en"},"3018":{"id":"/docs/User-Manuals/Operations/cli-102","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`cv mount <UFS_PATH> <CV_PATH> [OPTIONS]`: create or update a mount","locale":"en"},"3019":{"id":"/docs/User-Manuals/Operations/cli-103","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`cv mount resync <CV_PATH> [OPTIONS]`: run metadata resync for an `fs_mode` mount","locale":"en"},"3020":{"id":"/docs/User-Manuals/Operations/cli-104","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"Common options:","locale":"en"},"3021":{"id":"/docs/User-Manuals/Operations/cli-105","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                 | Description                               |\n| ---------------------- | ----------------------------------------- |\n| `--config <key=value>` | UFS configuration entry. Can be repeated. |","locale":"en","table":"table-6"},"3022":{"id":"/docs/User-Manuals/Operations/cli-106","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option     | Description                             |\n| ---------- | --------------------------------------- |\n| `--update` | Update an existing mount configuration. |","locale":"en","table":"table-6"},"3023":{"id":"/docs/User-Manuals/Operations/cli-107","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                               | Description                                                                           |\n| ------------------------------------ | ------------------------------------------------------------------------------------- |\n| `--check-path-consist <true\\|false>` | Whether to enforce path consistency between `UFS_PATH` and `CV_PATH`. Default `true`. |","locale":"en","table":"table-6"},"3024":{"id":"/docs/User-Manuals/Operations/cli-108","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option              | Description                                              |\n| ------------------- | -------------------------------------------------------- |\n| `--read-verify-ufs` | Validate cached reads against UFS using `mtime` / `len`. |","locale":"en","table":"table-6"},"3025":{"id":"/docs/User-Manuals/Operations/cli-109","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                | Description                                                  |\n| --------------------- | ------------------------------------------------------------ |\n| `--ttl-ms <DURATION>` | TTL, default `7d`. Supports durations such as `1h` and `7d`. |","locale":"en","table":"table-6"},"3026":{"id":"/docs/User-Manuals/Operations/cli-110","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option           | Description             |\n| ---------------- | ----------------------- |\n| `--replicas <N>` | Override replica count. |","locale":"en","table":"table-6"},"3027":{"id":"/docs/User-Manuals/Operations/cli-111","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                | Description                               |\n| --------------------- | ----------------------------------------- |\n| `--block-size <SIZE>` | Override block size, for example `128MB`. |","locale":"en","table":"table-6"},"3028":{"id":"/docs/User-Manuals/Operations/cli-112","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                      | Description            |\n| --------------------------- | ---------------------- |\n| `-s, --storage-type <TYPE>` | Override storage type. |","locale":"en","table":"table-6"},"3029":{"id":"/docs/User-Manuals/Operations/cli-113","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                               | Description                                                               |\n| ------------------------------------ | ------------------------------------------------------------------------- |\n| `--write-type <cache_mode\\|fs_mode>` | The current source only distinguishes these two modes. Default `fs_mode`. |","locale":"en","table":"table-6"},"3030":{"id":"/docs/User-Manuals/Operations/cli-114","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option                                 | Description                             |\n| -------------------------------------- | --------------------------------------- |\n| `--provider <auto\\|oss-hdfs\\|opendal>` | Select the UFS provider implementation. |","locale":"en","table":"table-6"},"3031":{"id":"/docs/User-Manuals/Operations/cli-115","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option    | Description                                                     |\n| --------- | --------------------------------------------------------------- |\n| `--check` | Only meaningful when listing mounts; also validates each entry. |","locale":"en","table":"table-6"},"3032":{"id":"/docs/User-Manuals/Operations/cli-116","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option      | Description                                                                  |\n| ----------- | ---------------------------------------------------------------------------- |\n| `--dry-run` | During `resync`, scan and print differences without delete / create changes. |","locale":"en","table":"table-6"},"3033":{"id":"/docs/User-Manuals/Operations/cli-117","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Option      | Description                                    |\n| ----------- | ---------------------------------------------- |\n| `--verbose` | During `resync`, print detailed per-file logs. |","locale":"en","table":"table-6"},"3034":{"id":"/docs/User-Manuals/Operations/cli-118","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"**About `--provider`**: some URI schemes can map to multiple implementations. For example, `oss://...` may be handled either by OSS-HDFS / JindoSDK or by OpenDAL, so `--provider` lets you force the implementation.","locale":"en"},"3035":{"id":"/docs/User-Manuals/Operations/cli-119","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Value  | Description                                         | Typical protocols     |\n| ------ | --------------------------------------------------- | --------------------- |\n| `auto` | Auto-select implementation based on the URI scheme. | All supported schemes |","locale":"en","table":"table-7"},"3036":{"id":"/docs/User-Manuals/Operations/cli-120","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Value      | Description                            | Typical protocols |\n| ---------- | -------------------------------------- | ----------------- |\n| `oss-hdfs` | Use JindoSDK / OSS-HDFS path handling. | `oss://`          |","locale":"en","table":"table-7"},"3037":{"id":"/docs/User-Manuals/Operations/cli-121","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"| Value     | Description                 | Typical protocols                                                                 |\n| --------- | --------------------------- | --------------------------------------------------------------------------------- |\n| `opendal` | Use OpenDAL-based backends. | `s3://`, `oss://`, `hdfs://`, `webhdfs://`, `cos://`, `gcs://`, `azblob://`, etc. |","locale":"en","table":"table-7"},"3038":{"id":"/docs/User-Manuals/Operations/cli-122","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"There are also a few implementation details worth calling out:","locale":"en"},"3039":{"id":"/docs/User-Manuals/Operations/cli-123","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"For `s3://...` paths, if `s3.bucket_name` is not provided explicitly, the CLI auto-fills it from the URI.","locale":"en"},"3040":{"id":"/docs/User-Manuals/Operations/cli-124","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"For `hdfs://...` paths, if `hdfs.namenode` / `hdfs.root` are not provided explicitly, the CLI derives them from the URI.","locale":"en"},"3041":{"id":"/docs/User-Manuals/Operations/cli-125","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"If the config contains `hdfs.kerberos.*` keys but neither `hdfs.kerberos.ccache` nor the `KRB5CCNAME` environment variable is present, the CLI prints a Kerberos ticket-cache warning.","locale":"en"},"3042":{"id":"/docs/User-Manuals/Operations/cli-126","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`validate_path_and_configs` currently applies extra path validation only to S3 paths; other schemes mostly rely on later provider initialization and connectivity checks.","locale":"en"},"3043":{"id":"/docs/User-Manuals/Operations/cli-127","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"Examples:","locale":"en"},"3044":{"id":"/docs/User-Manuals/Operations/cli-128","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"For detailed parameter lists of each UFS type (S3, OSS, HDFS, WebHDFS), see Appendix: UFS Mount Parameters at the end.","locale":"en"},"3045":{"id":"/docs/User-Manuals/Operations/cli-129","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"`--check-path-consist=true` is enabled by default. That means a path such as `s3://bucket/datasets` is normally expected to mount to `/bucket/datasets`. If you really need a different mapping, pass `--check-path-consist=false` explicitly.","locale":"en"},"3046":{"id":"/docs/User-Manuals/Operations/cli-130","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"In the current source, the first creation of an `fs_mode` mount automatically triggers a `resync`. Manual `cv mount resync ...` only works for `fs_mode` mount points.","locale":"en"},"3047":{"id":"/docs/User-Manuals/Operations/cli-131","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#5-umount-remove-a-mount","content":"**Usage:** `cv umount <CURVINE_PATH>`","locale":"en"},"3048":{"id":"/docs/User-Manuals/Operations/cli-132","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#5-umount-remove-a-mount","content":"Example:","locale":"en"},"3049":{"id":"/docs/User-Manuals/Operations/cli-133","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"**Usage:** `cv load [OPTIONS] <SOURCE_PATH> [TARGET_PATH]`","locale":"en"},"3050":{"id":"/docs/User-Manuals/Operations/cli-134","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"| Option / Argument | Description                                               |\n| ----------------- | --------------------------------------------------------- |\n| `<SOURCE_PATH>`   | UFS source URI or a Curvine path below an existing mount. |","locale":"en","table":"table-8"},"3051":{"id":"/docs/User-Manuals/Operations/cli-135","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"| Option / Argument | Description                                                                           |\n| ----------------- | ------------------------------------------------------------------------------------- |\n| `[TARGET_PATH]`   | Optional Curvine destination. A mounted source path derives its target automatically. |","locale":"en","table":"table-8"},"3052":{"id":"/docs/User-Manuals/Operations/cli-136","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"| Option / Argument | Description                                    |\n| ----------------- | ---------------------------------------------- |\n| `-w, --watch`     | Watch job status immediately after submission. |","locale":"en","table":"table-8"},"3053":{"id":"/docs/User-Manuals/Operations/cli-137","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"| Option / Argument | Description                                   |\n| ----------------- | --------------------------------------------- |\n| `--no-overwrite`  | Fail instead of replacing an existing target. |","locale":"en","table":"table-8"},"3054":{"id":"/docs/User-Manuals/Operations/cli-138","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"Examples:","locale":"en"},"3055":{"id":"/docs/User-Manuals/Operations/cli-139","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"With Transfer enabled, `load` submits a Transfer job. Otherwise it uses the\nlegacy Master job path. The command prints a job ID and target path in either\nmode.","locale":"en"},"3056":{"id":"/docs/User-Manuals/Operations/cli-140","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#transfer-routing","content":"The command line does not change when standalone Transfer is enabled:","locale":"en"},"3057":{"id":"/docs/User-Manuals/Operations/cli-141","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#transfer-routing","content":"| Client configuration         | `cv load` / `cv export` route                       |\n| ---------------------------- | --------------------------------------------------- |\n| `[transfer] enabled = false` | Legacy Master Load API, for backward compatibility. |","locale":"en","table":"table-9"},"3058":{"id":"/docs/User-Manuals/Operations/cli-142","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#transfer-routing","content":"| Client configuration        | `cv load` / `cv export` route                       |\n| --------------------------- | --------------------------------------------------- |\n| `[transfer] enabled = true` | Transfer service RPC, selected directly by the CLI. |","locale":"en","table":"table-9"},"3059":{"id":"/docs/User-Manuals/Operations/cli-143","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#transfer-routing","content":"The Transfer service and the client must both be configured for Transfer. Master\nand Worker configuration does not change for a client-side rollout. A client\nwith `transfer.enabled = false` continues to submit through the legacy Master\nAPI.","locale":"en"},"3060":{"id":"/docs/User-Manuals/Operations/cli-144","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"**Usage:** `cv export [OPTIONS] <PATH>`","locale":"en"},"3061":{"id":"/docs/User-Manuals/Operations/cli-145","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"`<PATH>` must be a Curvine path below a mount. Curvine infers the UFS target\nfrom that mount.","locale":"en"},"3062":{"id":"/docs/User-Manuals/Operations/cli-146","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"| Option / Argument | Description                    |\n| ----------------- | ------------------------------ |\n| `<PATH>`          | Curvine source path to export. |","locale":"en","table":"table-10"},"3063":{"id":"/docs/User-Manuals/Operations/cli-147","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"| Option / Argument | Description                                    |\n| ----------------- | ---------------------------------------------- |\n| `-w, --watch`     | Watch job status immediately after submission. |","locale":"en","table":"table-10"},"3064":{"id":"/docs/User-Manuals/Operations/cli-148","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"| Option / Argument | Description                              |\n| ----------------- | ---------------------------------------- |\n| `--no-overwrite`  | Fail when the UFS target already exists. |","locale":"en","table":"table-10"},"3065":{"id":"/docs/User-Manuals/Operations/cli-149","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#7-export-export-a-curvine-path-to-ufs","content":"Example:","locale":"en"},"3066":{"id":"/docs/User-Manuals/Operations/cli-150","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"**Usage:** `cv load-status [OPTIONS] <JOB_ID>`","locale":"en"},"3067":{"id":"/docs/User-Manuals/Operations/cli-151","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"| Option / Argument | Description          |\n| ----------------- | -------------------- |\n| `<JOB_ID>`        | Load job identifier. |","locale":"en","table":"table-11"},"3068":{"id":"/docs/User-Manuals/Operations/cli-152","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"| Option / Argument | Description     |\n| ----------------- | --------------- |\n| `-v, --verbose`   | Verbose output. |","locale":"en","table":"table-11"},"3069":{"id":"/docs/User-Manuals/Operations/cli-153","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"| Option / Argument        | Description                                                                 |\n| ------------------------ | --------------------------------------------------------------------------- |\n| `-w, --watch <INTERVAL>` | Poll interval, default `5s`. Supports formats such as `1s`, `1m`, and `1h`. |","locale":"en","table":"table-11"},"3070":{"id":"/docs/User-Manuals/Operations/cli-154","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"| Option / Argument | Description                                                        |\n| ----------------- | ------------------------------------------------------------------ |\n| `--conf <PATH>`   | Optional one-command config override; normal use does not need it. |","locale":"en","table":"table-11"},"3071":{"id":"/docs/User-Manuals/Operations/cli-155","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"Examples:","locale":"en"},"3072":{"id":"/docs/User-Manuals/Operations/cli-156","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#8-load-status-query-job-status","content":"In the current implementation, `load-status` enters watch mode by default with a `5s` refresh interval. The source does not currently expose a dedicated one-shot status-only switch.","locale":"en"},"3073":{"id":"/docs/User-Manuals/Operations/cli-157","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#9-cancel-load-cancel-a-load-job","content":"**Usage:** `cv cancel-load [OPTIONS] <JOB_ID>`","locale":"en"},"3074":{"id":"/docs/User-Manuals/Operations/cli-158","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#9-cancel-load-cancel-a-load-job","content":"| Option / Argument | Description               |\n| ----------------- | ------------------------- |\n| `<JOB_ID>`        | Job identifier to cancel. |","locale":"en","table":"table-12"},"3075":{"id":"/docs/User-Manuals/Operations/cli-159","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#9-cancel-load-cancel-a-load-job","content":"| Option / Argument | Description                                                        |\n| ----------------- | ------------------------------------------------------------------ |\n| `--conf <PATH>`   | Optional one-command config override; normal use does not need it. |","locale":"en","table":"table-12"},"3076":{"id":"/docs/User-Manuals/Operations/cli-160","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#9-cancel-load-cancel-a-load-job","content":"Example:","locale":"en"},"3077":{"id":"/docs/User-Manuals/Operations/cli-161","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"**Usage:** `cv load-list [OPTIONS]`","locale":"en"},"3078":{"id":"/docs/User-Manuals/Operations/cli-162","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option            | Description                                                     |\n| ----------------- | --------------------------------------------------------------- |\n| `--path <PREFIX>` | Match jobs whose source or target path starts with this prefix. |","locale":"en","table":"table-13"},"3079":{"id":"/docs/User-Manuals/Operations/cli-163","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option              | Description                                        |\n| ------------------- | -------------------------------------------------- |\n| `--mount <CV_PATH>` | Match `fs_mode` jobs under one Curvine mount path. |","locale":"en","table":"table-13"},"3080":{"id":"/docs/User-Manuals/Operations/cli-164","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option            | Description                                                               |\n| ----------------- | ------------------------------------------------------------------------- |\n| `--state <STATE>` | Filter by state: `pending`, `loading`, `completed`, `failed`, `canceled`. |","locale":"en","table":"table-13"},"3081":{"id":"/docs/User-Manuals/Operations/cli-165","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option           | Description                     |\n| ---------------- | ------------------------------- |\n| `--running-only` | Only show pending/loading jobs. |","locale":"en","table":"table-13"},"3082":{"id":"/docs/User-Manuals/Operations/cli-166","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option          | Description                                                     |\n| --------------- | --------------------------------------------------------------- |\n| `--failed-only` | Only failed jobs; with `-v`, only failed task rows are printed. |","locale":"en","table":"table-13"},"3083":{"id":"/docs/User-Manuals/Operations/cli-167","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option        | Description                           |\n| ------------- | ------------------------------------- |\n| `--limit <N>` | Maximum jobs returned (default `50`). |","locale":"en","table":"table-13"},"3084":{"id":"/docs/User-Manuals/Operations/cli-168","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option         | Description                                                   |\n| -------------- | ------------------------------------------------------------- |\n| `--offset <N>` | Skip N jobs, most recent first, for pagination (default `0`). |","locale":"en","table":"table-13"},"3085":{"id":"/docs/User-Manuals/Operations/cli-169","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option          | Description                             |\n| --------------- | --------------------------------------- |\n| `-v, --verbose` | Include task-level detail for each job. |","locale":"en","table":"table-13"},"3086":{"id":"/docs/User-Manuals/Operations/cli-170","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#10-load-list-list-recent-load-and-export-jobs","content":"| Option                      | Description                                              |\n| --------------------------- | -------------------------------------------------------- |\n| `--include-finished <BOOL>` | Include completed/failed/canceled jobs (default `true`). |","locale":"en","table":"table-13"},"3087":{"id":"/docs/User-Manuals/Operations/cli-171","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"`cv transfer` is available only when `[transfer] enabled = true`. It is the\noperations command for listing, inspecting, retrying, and paging Transfer jobs;\nnormal submission remains `cv load` or `cv export`.","locale":"en"},"3088":{"id":"/docs/User-Manuals/Operations/cli-172","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"It requires a reachable Transfer endpoint in the client configuration. See\nTransfer Service for deployment.","locale":"en"},"3089":{"id":"/docs/User-Manuals/Operations/cli-173","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command            | Description                                                                            |\n| ------------------ | -------------------------------------------------------------------------------------- |\n| `cv transfer list` | List jobs. Filter with `--kind load\\|export`, `--state`, `--tenant`, or `--submitter`. |","locale":"en","table":"table-14"},"3090":{"id":"/docs/User-Manuals/Operations/cli-174","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command                       | Description                                                                       |\n| ----------------------------- | --------------------------------------------------------------------------------- |\n| `cv transfer status <JOB_ID>` | Show one job. Add `--verbose` for task detail or `--watch --interval 1s` to poll. |","locale":"en","table":"table-14"},"3091":{"id":"/docs/User-Manuals/Operations/cli-175","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command                      | Description                   |\n| ---------------------------- | ----------------------------- |\n| `cv transfer tasks <JOB_ID>` | Show a task page for one job. |","locale":"en","table":"table-14"},"3092":{"id":"/docs/User-Manuals/Operations/cli-176","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command                       | Description            |\n| ----------------------------- | ---------------------- |\n| `cv transfer cancel <JOB_ID>` | Cancel a Transfer job. |","locale":"en","table":"table-14"},"3093":{"id":"/docs/User-Manuals/Operations/cli-177","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command                      | Description                                                         |\n| ---------------------------- | ------------------------------------------------------------------- |\n| `cv transfer retry <JOB_ID>` | Retry a failed, canceled, or partially successful job as a new job. |","locale":"en","table":"table-14"},"3094":{"id":"/docs/User-Manuals/Operations/cli-178","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"| Command               | Description               |\n| --------------------- | ------------------------- |\n| `cv transfer tenants` | Summarize jobs by tenant. |","locale":"en","table":"table-14"},"3095":{"id":"/docs/User-Manuals/Operations/cli-179","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"Examples:","locale":"en"},"3096":{"id":"/docs/User-Manuals/Operations/cli-180","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#11-transfer-operate-transfer-jobs","content":"`load-status` and `cancel-load` remain compatible shortcuts. With Transfer\nenabled, they call Transfer; with Transfer disabled, they call the legacy\nMaster implementation.","locale":"en"},"3097":{"id":"/docs/User-Manuals/Operations/cli-181","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#12-version-show-version","content":"**Usage:** `cv version`","locale":"en"},"3098":{"id":"/docs/User-Manuals/Operations/cli-182","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#12-version-show-version","content":"Example:","locale":"en"},"3099":{"id":"/docs/User-Manuals/Operations/cli-183","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#12-version-show-version","content":"The current implementation prints `curvine-cli <version>` together with commit / branch information.","locale":"en"},"3100":{"id":"/docs/User-Manuals/Operations/cli-184","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#12-version-show-version","content":"Every binary also accepts the global `--version-json` flag to print its full\nstructured version (component, release version, git provenance, protocol\nversion, capabilities) as JSON — see\nVersion Management and Compatibility:","locale":"en"},"3101":{"id":"/docs/User-Manuals/Operations/cli-185","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#13-bench-built-in-benchmark","content":"**Usage:** `cv bench [OPTIONS]` and `cv bench prefill [OPTIONS]`","locale":"en"},"3102":{"id":"/docs/User-Manuals/Operations/cli-186","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#13-bench-built-in-benchmark","content":"`bench` runs metadata and throughput suites against a `cv://` path (client mode)\nor `file://` path (FUSE mode). `cv bench prefill` creates a reusable working set\nfor mixed workloads. Common options include `--path`, `--profile basic|deep`,\n`--mode auto|client|fuse`, `-p/--threads`, `--workload`, `--block-size`,\n`--big-file-size`, and `--big-file-count`. Run `cv bench --help` for the full\noption list.","locale":"en"},"3103":{"id":"/docs/User-Manuals/Operations/cli-187","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#14-fsck-block-replica-health","content":"**Usage:** `cv fsck <PATH> [OPTIONS]`","locale":"en"},"3104":{"id":"/docs/User-Manuals/Operations/cli-188","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#14-fsck-block-replica-health","content":"| Option   | Description                   |\n| -------- | ----------------------------- |\n| `<PATH>` | File or directory to inspect. |","locale":"en","table":"table-15"},"3105":{"id":"/docs/User-Manuals/Operations/cli-189","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#14-fsck-block-replica-health","content":"| Option     | Description                                          |\n| ---------- | ---------------------------------------------------- |\n| `--detail` | Show per-file and per-block details for directories. |","locale":"en","table":"table-15"},"3106":{"id":"/docs/User-Manuals/Operations/cli-190","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#14-fsck-block-replica-health","content":"| Option                 | Description                                                        |\n| ---------------------- | ------------------------------------------------------------------ |\n| `--list-page-size <N>` | Directory entries per listing RPC (default `256`, range `1-4096`). |","locale":"en","table":"table-15"},"3107":{"id":"/docs/User-Manuals/Operations/cli-191","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#14-fsck-block-replica-health","content":"`fsck` compares the replicas recorded for each block with the replicas currently\navailable and reports under-replicated blocks and read errors. A warning line is\nprinted when the scan finds problems.","locale":"en"},"3108":{"id":"/docs/User-Manuals/Operations/cli-192","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"**Usage:** `cv admin config <set|get|reset> ...`","locale":"en"},"3109":{"id":"/docs/User-Manuals/Operations/cli-193","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"Runtime overrides apply to the running Master without editing the config file,\nand they are **not persistent**: a Master restart restores the file-backed\nvalues.","locale":"en"},"3110":{"id":"/docs/User-Manuals/Operations/cli-194","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"| Command               | Description                                                                                  |\n| --------------------- | -------------------------------------------------------------------------------------------- |\n| `cv admin config get` | List every registered runtime-config key with its file value, override, and effective value. |","locale":"en","table":"table-16"},"3111":{"id":"/docs/User-Manuals/Operations/cli-195","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"| Command                     | Description   |\n| --------------------------- | ------------- |\n| `cv admin config get <KEY>` | Show one key. |","locale":"en","table":"table-16"},"3112":{"id":"/docs/User-Manuals/Operations/cli-196","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"| Command                             | Description                                                           |\n| ----------------------------------- | --------------------------------------------------------------------- |\n| `cv admin config set <KEY> <VALUE>` | Set an in-memory override and print the previous and effective value. |","locale":"en","table":"table-16"},"3113":{"id":"/docs/User-Manuals/Operations/cli-197","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"| Command                       | Description                                               |\n| ----------------------------- | --------------------------------------------------------- |\n| `cv admin config reset <KEY>` | Drop the override and fall back to the config-file value. |","locale":"en","table":"table-16"},"3114":{"id":"/docs/User-Manuals/Operations/cli-198","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#15-admin-config-inspect-and-override-master-runtime-config","content":"In the current release the Master registers **no** runtime-adjustable keys\n(`build_master_runtime_registry` returns an empty registry). `cv admin config\nget` therefore prints `(no runtime config entries)`, and `set` / `reset` return\n`unsupported runtime configuration ...; writable: []`. The command surface is in\nplace for keys that will be registered later; use the config file plus a\nrestart for any change you need today.","locale":"en"},"3115":{"id":"/docs/User-Manuals/Operations/cli-199","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#16-snapshot-create-a-master-metadata-snapshot","content":"**Usage:** `cv snapshot create [--force]`","locale":"en"},"3116":{"id":"/docs/User-Manuals/Operations/cli-200","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#16-snapshot-create-a-master-metadata-snapshot","content":"Asks the active Master to create a metadata snapshot now, and prints the snapshot directory and how long the checkpoint took. Journal truncation and checkpoint retention are applied asynchronously.","locale":"en"},"3117":{"id":"/docs/User-Manuals/Operations/cli-201","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#16-snapshot-create-a-master-metadata-snapshot","content":"A request within `journal.snapshot_min_interval` of the previous snapshot is rejected. `--force` runs the checkpoint anyway, stalling metadata writes while it runs.","locale":"en"},"3118":{"id":"/docs/User-Manuals/Operations/cli-202","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#16-snapshot-create-a-master-metadata-snapshot","content":"The checkpoint runs on the Master and cannot be cancelled. On a large namespace it can take longer than `client.rpc_timeout_ms` (120s by default) even though it succeeds, and the retry then reports `a leader snapshot is already in progress`. Raise `client.rpc_timeout_ms` in the file passed with `--conf` first.","locale":"en"},"3119":{"id":"/docs/User-Manuals/Operations/cli-203","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#17-completion-shell-completion-script","content":"**Usage:** `cv completion <SHELL>`","locale":"en"},"3120":{"id":"/docs/User-Manuals/Operations/cli-204","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#17-completion-shell-completion-script","content":"Prints a completion script for `bash`, `zsh`, `fish`, `powershell` or `elvish`. For example, to enable completion in the current bash session:","locale":"en"},"3121":{"id":"/docs/User-Manuals/Operations/cli-205","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"`bin/dfs` in the distribution is a compatibility wrapper:","locale":"en"},"3122":{"id":"/docs/User-Manuals/Operations/cli-206","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"When the first subcommand is `fs` or `report`, it calls Java `io.curvine.CurvineShell`.","locale":"en"},"3123":{"id":"/docs/User-Manuals/Operations/cli-207","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"`dfs fs` keeps Hadoop `FsShell` syntax, so subcommands look like `-ls`, `-mkdir`, `-rm -r` with single-dash command names.","locale":"en"},"3124":{"id":"/docs/User-Manuals/Operations/cli-208","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"Other subcommands are eventually forwarded to the Rust `curvine-cli`, but for normal operations `cv` is still the recommended entry point.","locale":"en"},"3125":{"id":"/docs/User-Manuals/Operations/cli-209","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"Examples:","locale":"en"},"3126":{"id":"/docs/User-Manuals/Operations/cli-210","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"`dfs report info` is the Java-compat text-summary variant; conceptually it is close to `cv report all`, but the command name is different.","locale":"en"},"3127":{"id":"/docs/User-Manuals/Operations/cli-211","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#compatibility-cli-dfs","content":"Use `dfs` when you need Hadoop shell compatibility or rely on Hadoop configuration files such as `core-site.xml` / `hdfs-site.xml`. Use `cv` when you want the full Curvine-native command set from current source.","locale":"en"},"3128":{"id":"/docs/User-Manuals/Operations/cli-212","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"Curvine also exposes a FUSE file system interface. After mounting it, for example via `bin/curvine-fuse.sh start`, you can operate on the mount point with normal Linux tools:","locale":"en"},"3129":{"id":"/docs/User-Manuals/Operations/cli-213","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"Typical categories:","locale":"en"},"3130":{"id":"/docs/User-Manuals/Operations/cli-214","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"Basic file operations: `ls`, `cp`, `mv`, `rm`, `mkdir`","locale":"en"},"3131":{"id":"/docs/User-Manuals/Operations/cli-215","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"Content inspection: `cat`, `grep`, `sed`","locale":"en"},"3132":{"id":"/docs/User-Manuals/Operations/cli-216","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"File system information: `df -h`, `du -sh`, `stat`","locale":"en"},"3133":{"id":"/docs/User-Manuals/Operations/cli-217","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"Permissions: `chmod`, `chown`","locale":"en"},"3134":{"id":"/docs/User-Manuals/Operations/cli-218","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#posix--fuse","content":"If your goal is POSIX compatibility with existing tools, prefer FUSE. If you need Curvine-native mount, load, or node-management features, use `cv`.","locale":"en"},"3135":{"id":"/docs/User-Manuals/Operations/cli-219","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#appendix-ufs-mount-parameters","content":"The following are common parameters passed through `--config key=value` when using `cv mount`. `Required` means it normally must be provided; `Optional` means it can be omitted if a default exists or if the CLI can infer it from the mount URI.","locale":"en"},"3136":{"id":"/docs/User-Manuals/Operations/cli-220","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"Used with `--provider opendal` or auto-selection.","locale":"en"},"3137":{"id":"/docs/User-Manuals/Operations/cli-221","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"| Parameter         | Required/Optional | Description                                                       |\n| ----------------- | ----------------- | ----------------------------------------------------------------- |\n| `s3.endpoint_url` | Required          | S3 service endpoint URL; must start with `http://` or `https://`. |","locale":"en","table":"table-17"},"3138":{"id":"/docs/User-Manuals/Operations/cli-222","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"| Parameter               | Required/Optional | Description    |\n| ----------------------- | ----------------- | -------------- |\n| `s3.credentials.access` | Required          | Access Key ID. |","locale":"en","table":"table-17"},"3139":{"id":"/docs/User-Manuals/Operations/cli-223","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"| Parameter               | Required/Optional | Description        |\n| ----------------------- | ----------------- | ------------------ |\n| `s3.credentials.secret` | Required          | Secret Access Key. |","locale":"en","table":"table-17"},"3140":{"id":"/docs/User-Manuals/Operations/cli-224","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"| Parameter        | Required/Optional | Description  |\n| ---------------- | ----------------- | ------------ |\n| `s3.region_name` | Optional          | Region name. |","locale":"en","table":"table-17"},"3141":{"id":"/docs/User-Manuals/Operations/cli-225","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"| Parameter       | Required/Optional | Description                                                                       |\n| --------------- | ----------------- | --------------------------------------------------------------------------------- |\n| `s3.path_style` | Optional          | Whether to use path-style access, commonly needed for MinIO-compatible endpoints. |","locale":"en","table":"table-17"},"3142":{"id":"/docs/User-Manuals/Operations/cli-226","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"For Alibaba Cloud OSS / OSS-HDFS style access.","locale":"en"},"3143":{"id":"/docs/User-Manuals/Operations/cli-227","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"| Parameter      | Required/Optional | Description           |\n| -------------- | ----------------- | --------------------- |\n| `oss.endpoint` | Required          | OSS endpoint address. |","locale":"en","table":"table-18"},"3144":{"id":"/docs/User-Manuals/Operations/cli-228","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"| Parameter         | Required/Optional | Description                 |\n| ----------------- | ----------------- | --------------------------- |\n| `oss.accessKeyId` | Required          | Alibaba Cloud AccessKey ID. |","locale":"en","table":"table-18"},"3145":{"id":"/docs/User-Manuals/Operations/cli-229","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"| Parameter             | Required/Optional | Description                     |\n| --------------------- | ----------------- | ------------------------------- |\n| `oss.accessKeySecret` | Required          | Alibaba Cloud AccessKey Secret. |","locale":"en","table":"table-18"},"3146":{"id":"/docs/User-Manuals/Operations/cli-230","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"| Parameter    | Required/Optional | Description |\n| ------------ | 