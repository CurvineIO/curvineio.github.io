 UFS modules simultaneously, specify `--ufs` multiple times, e.g. `make build ARGS='--ufs oss-hdfs --ufs opendal-oss'`.","locale":"en"},"1440":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/compile-53","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/compile","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/compile#ufs-module-support","content":"Note that both OSS accelerated buckets and standard object storage buckets use the `oss://test-bucket` format. When mounting OSS storage, you need to specify the appropriate module. For detailed mount usage, see the CLI mount section.","locale":"en"},"1441":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","type":"page","content":"Deployment Preparation","breadcrumbs":["Documents","Deploy","Deploy Curvine Cluster","Preparation"],"tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","locale":"en"},"1442":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup-0","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup#supported-runtime-baseline","content":"Supported Runtime Baseline","locale":"en"},"1443":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup-1","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup#resource-requirements","content":"Resource Requirements","locale":"en"},"1444":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup-2","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Preparation/deployment-setup#create-installation-package","content":"Creat