 that is visible in the reference repository.","locale":"en"},"818":{"id":"/docs/Contribute/roadmap-5","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap","content":"The old in-tree 2025 milestone table is not aligned with the current reference state. In the current repository, the top-level `README.md` points readers to a GitHub discussion labeled `Roadmap 2026` instead of maintaining a dated release plan inside the repo.","locale":"en"},"819":{"id":"/docs/Contribute/roadmap-6","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#where-to-follow-planning","content":"`README.md` for the current roadmap link","locale":"en"},"820":{"id":"/docs/Contribute/roadmap-7","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#where-to-follow-planning","content":"GitHub Issues for scoped implementation tasks","locale":"en"},"821":{"id":"/docs/Contribute/roadmap-8","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#where-to-follow-planning","content":"GitHub Discussions for roadmap and design discussion","locale":"en"},"822":{"id":"/docs/Contribute/roadmap-9","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                 | Current repo surface                                                  |\n| -------------------- | --------------------------------------------------------------------- |\n| Core runtime and RPC | `crates/core/`, `crates/common/`, `curvine-server/`, `crates/client/` |","locale":"en","table":"table-0"},"823":{"id":"/docs/Contribute/roadmap-10","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area         | Current repo surface            |\n| ------------ | ------------------------------- |\n| FUSE and CLI | `curvine-fuse/`, `curvine-cli/` |","locale":"en","table":"table-0"},"824":{"id":"/docs/Contribute/roadmap-11","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                             | Current repo surface                                  |\n| -------------------------------- | ----------------------------------------------------- |\n| Storage backends and data access | `curvine-ufs/`, `crates/adapters/`, `curvine-libsdk/` |","locale":"en","table":"table-0"},"825":{"id":"/docs/Contribute/roadmap-12","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                       | Current repo surface                                                       |\n| -------------------------- | -------------------------------------------------------------------------- |\n| Metadata, HA, and Transfer | `crates/metadata/`, `curvine-mds/`, `crates/server/curvine-data-transfer/` |","locale":"en","table":"table-0"},"826":{"id":"/docs/Contribute/roadmap-13","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                        | Current repo surface |\n| --------------------------- | -------------------- |\n| Web and management surfaces | `curvine-web/`       |","locale":"en","table":"table-0"},"827":{"id":"/docs/Contribute/roadmap-14","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                                      | Current repo surface                                         |\n| ----------------------------------------- | ------------------------------------------------------------ |\n| Tests, benchmarks, and regression tooling | `curvine-tests/`, `build/tests/`, `curvine-tests/benchmark/` |","locale":"en","table":"table-0"},"828":{"id":"/docs/Contribute/roadmap-15","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#contribution-areas-visible-in-the-repository-today","content":"| Area                            | Current repo surface              |\n| ------------------------------- | --------------------------------- |\n| Kubernetes and packaging assets | `curvine-csi/`, `curvine-docker/` |","locale":"en","table":"table-0"},"829":{"id":"/docs/Contribute/roadmap-16","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#planning-guidance-for-contributors","content":"Prefer the current repository tree, build scripts, and tests over old milestone tables.","locale":"en"},"830":{"id":"/docs/Contribute/roadmap-17","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#planning-guidance-for-contributors","content":"Treat top-level directories as evidence of active work areas, not as guarantees of release timing.","locale":"en"},"831":{"id":"/docs/Contribute/roadmap-18","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#planning-guidance-for-contributors","content":"Avoid repeating unpublished storage or protocol promises that are not backed by the reference repository state.","locale":"en"},"832":{"id":"/docs/Contribute/roadmap-19","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#getting-involved","content":"Comment on relevant GitHub Issues if a task already exists.","locale":"en"},"833":{"id":"/docs/Contribute/roadmap-20","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#getting-involved","content":"Use GitHub Discussions for broader proposals or roadmap suggestions.","locale":"en"},"834":{"id":"/docs/Contribute/roadmap-21","page_id":"/docs/Contribute/roadmap","tags":[],"type":"text","url":"/docs/Contribute/roadmap#getting-involved","content":"When sending doc updates, keep commands and feature descriptions tied to what the reference repo actually builds, ships, and tests.","locale":"en"},"835":{"id":"/docs/Contribute/skills-guide","page_id":"/docs/Contribute/skills-guide","type":"page","content":"Skills Guide","breadcrumbs":["Documents","Contributor Guide"],"tags":[],"url":"/docs/Contribute/skills-guide","locale":"en"},"836":{"id":"/docs/Contribute/skills-guide-0","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#what-a-skill-is-and-is-not","content":"What a skill is (and is not)","locale":"en"},"837":{"id":"/docs/Contribute/skills-guide-1","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#before-you-start","content":"Before you start","locale":"en"},"838":{"id":"/docs/Contribute/skills-guide-2","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#the-four-everyday-workflows","content":"The four everyday workflows","locale":"en"},"839":{"id":"/docs/Contribute/skills-guide-3","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#1-create-an-issue-with-cv-create-issue","content":"1. Create an issue with `cv-create-issue`","locale":"en"},"840":{"id":"/docs/Contribute/skills-guide-4","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"2. Fix an issue with `cv-handle-issue`","locale":"en"},"841":{"id":"/docs/Contribute/skills-guide-5","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"3. Submit a pull request with `cv-create-pr`","locale":"en"},"842":{"id":"/docs/Contribute/skills-guide-6","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#4-review-code","content":"4. Review code","locale":"en"},"843":{"id":"/docs/Contribute/skills-guide-7","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#supporting-skills","content":"Supporting skills","locale":"en"},"844":{"id":"/docs/Contribute/skills-guide-8","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#putting-it-together","content":"Putting it together","locale":"en"},"845":{"id":"/docs/Contribute/skills-guide-9","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#ground-rules","content":"Ground rules","locale":"en"},"846":{"id":"/docs/Contribute/skills-guide-10","page_id":"/docs/Contribute/skills-guide","type":"heading","tags":[],"url":"/docs/Contribute/skills-guide#further-reading","content":"Further reading","locale":"en"},"847":{"id":"/docs/Contribute/skills-guide-11","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide","content":"Every project has its own way of doing things: which template an issue should follow, how a PR title is worded, what a reviewer should look at first. Curvine writes those habits down as **skills** — small, readable playbooks that an AI coding agent can pick up and follow.","locale":"en"},"848":{"id":"/docs/Contribute/skills-guide-12","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide","content":"You will find them in the Curvine repository, under `.agents/skills/`. Each skill is just a folder with a `SKILL.md` file. There is no service to install and no account to create. The skills are versioned with the code, so they evolve together with the project.","locale":"en"},"849":{"id":"/docs/Contribute/skills-guide-13","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide","content":"You can read a skill like a checklist and do the work yourself, or let your agent follow it for you. This guide focuses on the second option and walks through the four things contributors do most often: creating an issue, fixing an issue, submitting a pull request, and reviewing code.","locale":"en"},"850":{"id":"/docs/Contribute/skills-guide-14","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#what-a-skill-is-and-is-not","content":"A skill is guidance, not automation. It tells an agent *how* Curvine likes a job done and which commands to run. It does not merge code, bypass CI, or make decisions on your behalf.","locale":"en"},"851":{"id":"/docs/Contribute/skills-guide-15","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#what-a-skill-is-and-is-not","content":"That last point matters. By design, the skills pause before anything leaves your machine. They draft an issue, a commit message, a PR body, or a review comment first, and wait for your approval. You stay in charge of what gets published.","locale":"en"},"852":{"id":"/docs/Contribute/skills-guide-16","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"You need:","locale":"en"},"853":{"id":"/docs/Contribute/skills-guide-17","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"A local clone of the `curvine` repository.","locale":"en"},"854":{"id":"/docs/Contribute/skills-guide-18","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"An AI coding agent that can load project skills. Claude Code, Cursor, Codex, and GitHub Copilot all work today.","locale":"en"},"855":{"id":"/docs/Contribute/skills-guide-19","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"The GitHub CLI signed in, because some skills file issues, push branches, or post review comments. Check with `gh auth status`.","locale":"en"},"856":{"id":"/docs/Contribute/skills-guide-20","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"A working build environment if you plan to change Rust code. The Development Guide covers the details.","locale":"en"},"857":{"id":"/docs/Contribute/skills-guide-21","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"The skills are discovered automatically through the directories your agent already reads: `.claude/skills`, `.cursor/skills`, and `.github/skills` are symlinks to `.agents/skills`, while Codex reads `.agents/skills` directly.","locale":"en"},"858":{"id":"/docs/Contribute/skills-guide-22","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"If your agent supports slash commands, call a skill by name:","locale":"en"},"859":{"id":"/docs/Contribute/skills-guide-23","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#before-you-start","content":"Cursor discovers the same skills without a slash command. If you are ever unsure what a skill does, open its `SKILL.md` — that file is the contract.","locale":"en"},"860":{"id":"/docs/Contribute/skills-guide-24","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#1-create-an-issue-with-cv-create-issue","content":"Use this when you find a bug or want to propose a feature. A short prompt is enough:","locale":"en"},"861":{"id":"/docs/Contribute/skills-guide-25","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#1-create-an-issue-with-cv-create-issue","content":"The skill searches open issues for duplicates, picks the right template from `.github/ISSUE_TEMPLATE/`, and drafts the body. Bug reports get reproduction steps and environment details. Feature requests also get three sections that keep scope honest: **Goal**, **Not Goal**, and **Test Plan**.","locale":"en"},"862":{"id":"/docs/Contribute/skills-guide-26","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#1-create-an-issue-with-cv-create-issue","content":"Read the draft, adjust the wording, and approve. The issue is then filed with the right label. For a sub-task of a larger issue, the skill uses the `[SUB]` title prefix and links `Parent: #<number>`.","locale":"en"},"863":{"id":"/docs/Contribute/skills-guide-27","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#1-create-an-issue-with-cv-create-issue","content":"A small tip: paste real logs, versions, and reproduction steps. A clear issue is a gift to whoever fixes it later — often future you.","locale":"en"},"864":{"id":"/docs/Contribute/skills-guide-28","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"Give the skill an issue number or URL:","locale":"en"},"865":{"id":"/docs/Contribute/skills-guide-29","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"The first half of this workflow is thinking, not typing. The skill reads the issue, summarizes the problem, the modules involved, the risks, and the test strategy, then proposes a plan. **No code is written until you approve that plan.** Plans are cheap to change; code is not.","locale":"en"},"866":{"id":"/docs/Contribute/skills-guide-30","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"Once you approve, the skill creates a branch named after the issue (`fix/123-short-slug` or `feat/123-short-slug`), implements the agreed scope, adds tests, runs `make format`, and hands the result to `cv-create-pr`.","locale":"en"},"867":{"id":"/docs/Contribute/skills-guide-31","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"If the change looks larger than roughly 500 lines, the skill routes to `cv-tasks-breakdown`. That skill slices the work into dependency-ordered tasks, each small enough to land as one commit, and can file `[SUB]` issues to track them. Small steps, always green.","locale":"en"},"868":{"id":"/docs/Contribute/skills-guide-32","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#2-fix-an-issue-with-cv-handle-issue","content":"When you read the plan, put on your reviewer hat. If the scope feels wrong, say so now — it costs nothing at this stage.","locale":"en"},"869":{"id":"/docs/Contribute/skills-guide-33","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"When your commits are ready:","locale":"en"},"870":{"id":"/docs/Contribute/skills-guide-34","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"The skill runs `make format`, reviews the diff, and drafts the PR:","locale":"en"},"871":{"id":"/docs/Contribute/skills-guide-35","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"**Title:** `<type>(<module>): <description> (#<issueNumber>)`","locale":"en"},"872":{"id":"/docs/Contribute/skills-guide-36","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"**Body:** Summary, Issue Describe / Design, Changes, Test verified, and Dependencies","locale":"en"},"873":{"id":"/docs/Contribute/skills-guide-37","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"Give the **Test verified** table a minute of your attention. Write down the tests you actually ran. A green CI run is good news, but it is not the same as \"I ran these cases and here is what I saw.\" Reviewers can tell the difference.","locale":"en"},"874":{"id":"/docs/Contribute/skills-guide-38","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#3-submit-a-pull-request-with-cv-create-pr","content":"PRs are created as drafts by default. When the description looks right and the tests pass, mark it ready for review. A focused PR with a clear description gets reviewed faster and is easier to revert if something goes wrong.","locale":"en"},"875":{"id":"/docs/Contribute/skills-guide-39","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"There are two skills, one for each side of the conversation.","locale":"en"},"876":{"id":"/docs/Contribute/skills-guide-40","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"**If you are reviewing**, run:","locale":"en"},"877":{"id":"/docs/Contribute/skills-guide-41","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"The skill checks the live base and head of the PR, reads the changed tests before the implementation, and maps which crates the change touches. It then looks at correctness, concurrency and lifecycle, wire compatibility, and performance on the data, RPC, and metadata paths. It drafts comments with a clear severity prefix — `Critical:`, `Required:`, or `Optional:` — and a local verdict. Nothing is posted until you confirm.","locale":"en"},"878":{"id":"/docs/Contribute/skills-guide-42","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"**If you are the author responding to feedback**, run:","locale":"en"},"879":{"id":"/docs/Contribute/skills-guide-43","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"The skill collects every review comment and gives you a table of what it suggests accepting, partially accepting, or declining, with reasons. You approve the table, the skill applies the fixes, pushes them, replies to each comment in English, and resolves the threads that are fixed.","locale":"en"},"880":{"id":"/docs/Contribute/skills-guide-44","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#4-review-code","content":"Review is a conversation, not a scorecard. If you disagree with a comment, explain why. The reasoning is recorded for the next person who reads the thread.","locale":"en"},"881":{"id":"/docs/Contribute/skills-guide-45","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"The four workflows above are the main road. These skills are the side streets that help when the road gets bumpy.","locale":"en"},"882":{"id":"/docs/Contribute/skills-guide-46","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill          | What it helps with                                                                                                                                                              |\n| -------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `cv-codegraph` | Builds a local map of symbols and call paths so the agent can answer \"where does this happen?\" without scanning the whole repository. One-time setup is described in the skill. |","locale":"en","table":"table-0"},"883":{"id":"/docs/Contribute/skills-guide-47","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill                | What it helps with                                                                                                                   |\n| -------------------- | ------------------------------------------------------------------------------------------------------------------------------------ |\n| `cv-tasks-breakdown` | Turns a large feature into dependency-ordered tasks, each landing as one commit with its own tests, and optionally files sub-issues. |","locale":"en","table":"table-0"},"884":{"id":"/docs/Contribute/skills-guide-48","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill         | What it helps with                                                                                                             |\n| ------------- | ------------------------------------------------------------------------------------------------------------------------------ |\n| `cv-csi-test` | Walks through deploying and testing the CSI driver on Kubernetes, including restart, recovery, and volume expansion scenarios. |","locale":"en","table":"table-0"},"885":{"id":"/docs/Contribute/skills-guide-49","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill             | What it helps with                                                                                                 |\n| ----------------- | ------------------------------------------------------------------------------------------------------------------ |\n| `cv-run-workflow` | Dispatches a GitHub Actions workflow with the right branch and inputs, then watches the run and surfaces failures. |","locale":"en","table":"table-0"},"886":{"id":"/docs/Contribute/skills-guide-50","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill            | What it helps with                                                                                     |\n| ---------------- | ------------------------------------------------------------------------------------------------------ |\n| `cv-test-report` | Turns a full-chain test run into the standard report format and publishes it to the test reports site. |","locale":"en","table":"table-0"},"887":{"id":"/docs/Contribute/skills-guide-51","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#supporting-skills","content":"| Skill           | What it helps with                                                                           |\n| --------------- | -------------------------------------------------------------------------------------------- |\n| `cv-add-skills` | Explains how to write or update a `cv-*` skill and keep the registry in `AGENTS.md` in sync. |","locale":"en","table":"table-0"},"888":{"id":"/docs/Contribute/skills-guide-52","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"Here is what a typical contribution looks like when the skills are in the loop:","locale":"en"},"889":{"id":"/docs/Contribute/skills-guide-53","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"You spot a bug and run `/cv-create-issue`. After a quick review, issue `#123` is filed.","locale":"en"},"890":{"id":"/docs/Contribute/skills-guide-54","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"You run `/cv-handle-issue 123`. The agent proposes a plan; you adjust it and approve. It creates the branch, writes the fix and tests, and runs `make format`.","locale":"en"},"891":{"id":"/docs/Contribute/skills-guide-55","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"You run `/cv-create-pr`. A draft PR appears with a complete description and the tests you verified.","locale":"en"},"892":{"id":"/docs/Contribute/skills-guide-56","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"A maintainer runs `/cv-submit-pr-review 124`. The review is posted only after they approve the draft comments.","locale":"en"},"893":{"id":"/docs/Contribute/skills-guide-57","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"You run `/cv-address-pr-review 124`, agree with two comments and decline one with a reason. The fixes are pushed and the threads are resolved.","locale":"en"},"894":{"id":"/docs/Contribute/skills-guide-58","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"CI passes. The PR is merged.","locale":"en"},"895":{"id":"/docs/Contribute/skills-guide-59","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#putting-it-together","content":"At every step, a human made the decision. The agent handled the repetitive parts: finding the template, formatting the title, remembering which sections the PR body needs, and keeping track of review comments.","locale":"en"},"896":{"id":"/docs/Contribute/skills-guide-60","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#ground-rules","content":"**You own the change.** Skills are assistants. Read every diff, run the tests, and be ready to explain the change. Your name is on the commit.","locale":"en"},"897":{"id":"/docs/Contribute/skills-guide-61","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#ground-rules","content":"**Approve deliberately.** Drafts exist for a reason. Check the issue, PR body, or review comment before saying yes.","locale":"en"},"898":{"id":"/docs/Contribute/skills-guide-62","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#ground-rules","content":"**Keep GitHub English.** Issues, PRs, review comments, and skills themselves are written in English so everyone in the community can follow along.","locale":"en"},"899":{"id":"/docs/Contribute/skills-guide-63","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#ground-rules","content":"**CI is the referee.** Formatting, compilation, tests, and the PR title check still decide whether a change can land. Skills do not bypass them.","locale":"en"},"900":{"id":"/docs/Contribute/skills-guide-64","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#ground-rules","content":"**Skills live with the code.** If you want to improve one, follow `cv-add-skills` and keep the registry in `AGENTS.md` up to date.","locale":"en"},"901":{"id":"/docs/Contribute/skills-guide-65","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#further-reading","content":"Contributing to Curvine","locale":"en"},"902":{"id":"/docs/Contribute/skills-guide-66","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#further-reading","content":"The `.agents` README","locale":"en"},"903":{"id":"/docs/Contribute/skills-guide-67","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#further-reading","content":"Shared workflow rules","locale":"en"},"904":{"id":"/docs/Contribute/skills-guide-68","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#further-reading","content":"All `cv-*` skills","locale":"en"},"905":{"id":"/docs/Contribute/skills-guide-69","page_id":"/docs/Contribute/skills-guide","tags":[],"type":"text","url":"/docs/Contribute/skills-guide#further-reading","content":"If you only remember one thing, remember this: the skills are there to remove the busywork, not to remove your judgment. Use them, question them, and improve them.","locale":"en"},"906":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","type":"page","content":"Bare Metal Deployment","breadcrumbs":["Documents","Deploy","Deploy Curvine Cluster","Distributed Mode"],"tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","locale":"en"},"907":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-0","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"Logical Deployment Architecture","locale":"en"},"908":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-1","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#startup-commands","content":"Startup Commands","locale":"en"},"909":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-2","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","content":"Before deployment, you need to create installation packages and modify configuration files.","locale":"en"},"910":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-3","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"The following diagram shows the logical architecture of a Curvine bare metal deployment. The **cluster core** consists only of Master and Worker processes; they must be started for the cluster to operate. FUSE is an **optional** access method and is **not** part of the cluster startup—you only need it when applications require a POSIX mount point.","locale":"en"},"911":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-4","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"**Cluster core (required):** Start `curvine-master` and `curvine-worker` on the intended hosts. The cluster is operational once Master and Workers are running; you can use the CLI (`cv`) or SDK without FUSE.","locale":"en"},"912":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-5","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"**FUSE (optional):** Start `curvine-fuse` only when you need a POSIX filesystem mount (e.g. for legacy tools or scripts). FUSE is not a core service—the cluster does not depend on it to start or run.","locale":"en"},"913":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-6","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"When Load and Export jobs need independent scheduling, deploy Transfer as a\nseparate optional service after the cluster is healthy. It does not join the\nMaster Raft group and does not require a Master or Worker configuration change.\nSee Deploy Transfer on Bare Metal.","locale":"en"},"914":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-7","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"**FUSE is not part of cluster startup.** The Curvine cluster is formed by Master and Worker nodes. FUSE is one of several access methods (along with CLI and SDK) and is only needed when applications require a local mount point.","locale":"en"},"915":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-8","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#logical-deployment-architecture","content":"Each worker needs to have its own determined IP. In multi-network interface environments, it is recommended to explicitly specify the IP through environment variables to avoid automatically reading unexpected network interface addresses.","locale":"en"},"916":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment-9","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/Bare-Metal-Deployment#startup-commands","content":"Bare metal deployment requires manually starting the **cluster core** (master and worker). Optionally start FUSE on nodes where you need a POSIX mount:","locale":"en"},"917":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"page","content":"Configuration Reference","breadcrumbs":["Documents","Deploy","Deploy Curvine Cluster","Distributed Mode"],"tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","locale":"en"},"918":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-0","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#config-sources","content":"Config Sources","locale":"en"},"919":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-1","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#how-the-config-is-loaded","content":"How the config is loaded","locale":"en"},"920":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-2","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#net_interface","content":"`net_interface`","locale":"en"},"921":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-3","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#top-level-layout","content":"Top-Level Layout","locale":"en"},"922":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-4","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#cluster-level-flags","content":"Cluster-Level Flags","locale":"en"},"923":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-5","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#master","content":"`[master]`","locale":"en"},"924":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-6","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#mds","content":"`[mds]`","locale":"en"},"925":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-7","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#journal","content":"`[journal]`","locale":"en"},"926":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-8","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#worker","content":"`[worker]`","locale":"en"},"927":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-9","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#client","content":"`[client]`","locale":"en"},"928":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-10","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fuse","content":"`[fuse]`","locale":"en"},"929":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-11","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#log-cli-job","content":"`[log]`, `[cli]`, `[job]`","locale":"en"},"930":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-12","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"Global `[log]`","locale":"en"},"931":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-13","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#cli","content":"`[cli]`","locale":"en"},"932":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-14","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#job","content":"`[job]`","locale":"en"},"933":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-15","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"`[transfer]`","locale":"en"},"934":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-16","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"`[discovery]`","locale":"en"},"935":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-17","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf"