cs/Deploy/quick-start-23","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#web-ui","content":"Master: `http://<host>:9001`","locale":"en"},"1768":{"id":"/docs/Deploy/quick-start-24","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#web-ui","content":"Worker: `http://<host>:9002`","locale":"en"},"1769":{"id":"/docs/Deploy/quick-start-25","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#web-ui","content":"FUSE: `http://<host>:9003`","locale":"en"},"1770":{"id":"/docs/Deploy/quick-start-26","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#about-benchmark-scripts","content":"The benchmark and stress-test scripts live in the source tree under `build/tests/`; they are not the primary entry point of a release-package quick start. For throughput and FIO testing, refer to the Benchmark and Contribute sections instead of using this page as a benchmark guide.","locale":"en"},"1771":{"id":"/docs/Deploy/system-requirements","page_id":"/docs/Deploy/system-requirements","type":"page","content":"System Requirements","breadcrumbs":["Documents","Deploy"],"tags":[],"url":"/docs/Deploy/system-requirements","locale":"en"},"1772":{"id":"/docs/Deploy/system-requirements-0","page_id":"/docs/Deploy/system-requirements","type":"heading","tags":[],"url":"/docs/Deploy/system-requirements#officially-supported-linux-distributions","content":"Officially Supported Linux Distributions","locale":"en"},"1773":{"id":"/docs/Deploy/system-requirements-1","page_id":"/docs/Deploy/system-requirements","tags":[],"type":"text","url":"/docs/Deploy/system-requirements","content":"This page summarizes the base requirements to build and run Curvine. For a full, step-by-step environment setup (including per-OS installation commands), see Environment Initialization.","locale":"en"},"1774":{"id":"/docs/Deploy/system-requirements-2","page_id":"