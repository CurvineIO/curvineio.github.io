ributed-Mode/k8s-Deployment#openkruise","content":"`openKruise.enabled` defaults to `false`. Master and worker use standard `apps/v1` StatefulSets.","locale":"en"},"1357":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment-62","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment#openkruise","content":"Set `openKruise.enabled=true` to install the kruise subchart and switch master/worker to Advanced StatefulSet (`apps.kruise.io/v1beta1`).","locale":"en"},"1358":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment-63","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment#openkruise","content":"| Parameter            | Default | Description                 |\n| -------------------- | ------- | --------------------------- |\n| `openKruise.enabled` | `false` | Enable Advanced StatefulSet |","locale":"en","table":"table-5"},"1359":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment-64","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment#openkruise","content":"| Parameter                    | Default       | Description                                        |\n| ---------------------------- | ------------- | -------------------------------------------------- |\n| `openKruise.podUpdatePolicy` | `InPlaceOnly` | `InPlaceOnly` \\| `InPlaceIfPossible` \\| `ReCreate` |","locale":"en","table":"table-5"},"1360":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment-65","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/k8s-Deployment","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distribute