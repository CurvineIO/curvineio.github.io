ributed-Mode/conf-356","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field    | Default    | Meaning                  |\n| -------- | ---------- | ------------------------ |\n| `prefix` | `/curvine` | Absolute etcd key prefix |","locale":"en","table":"table-12"},"1275":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-357","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field                | Default | Meaning              |\n| -------------------- | ------- | -------------------- |\n| `connect_timeout_ms` | `3000`  | etcd connect timeout |","locale":"en","table":"table-12"},"1276":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-358","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field                | Default | Meaning              |\n| -------------------- | ------- | -------------------- |\n| `request_timeout_ms` | `3000`  | etcd request timeout |","locale":"en","table":"table-12"},"1277":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-359","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field                    | Default | Meaning                             |\n| ------------------------ | ------- | ----------------------------------- |\n| `watch_reconnect_min_ms` | `1000`  | Watch reconnect backoff lower bound |","locale":"en","table":"table-12"},"1278":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-360","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field                    | Default | Meaning                             |\n| ------------------------ | ------- | ----------------------------------- |\n| `watch_reconnect_max_ms` | `30000` | Watch reconnect backoff upper bound |","locale":"en","table":"table-12"},"1279":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-361","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field                          | Default | Meaning                                    |\n| ------------------------------ | ------- | ------------------------------------------ |\n| `watch_reconnect_jitter_ratio` | `0.2`   | Watch reconnect jitter ratio (`0.0`–`1.0`) |","locale":"en","table":"table-12"},"1280":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-362","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"| Field               | Default | Meaning                                            |\n| ------------------- | ------- | -------------------------------------------------- |\n| `allow_stale_cache` | `true`  | Return stale cache while the watch is disconnected |","locale":"en","table":"table-12"},"1281":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-363","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"When discovery is enabled, `cluster_id` must contain only lowercase letters, digits, `_`, and `-`. Effective keys are `{prefix}/{cluster_id}/services/{kind}/{service_id}`.","locale":"en"},"1282":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-364","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fault_injection","content":"Test-only fault control plane. It is disabled by default and must not be enabled in normal deployments.","locale":"en"},"1283":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-365","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fault_injection","content":"| Field     | Default | Meaning                  |\n| --------- | ------- | ------------------------ |\n| `enabled` | `false` | Expose fault HTTP routes |","locale":"en","table":"table-13"},"1284":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-366","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fault_injection","content":"| Field            | Default               | Meaning                                       |\n| ---------------- | --------------------- | --------------------------------------------- |\n| `auth_token_env` | `CURVINE_FAULT_TOKEN` | Environment variable holding the bearer token |","locale":"en","table":"table-13"},"1285":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-367","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fault_injection","content":"The HTTP routes require binaries built with the `fault-injection` Cargo feature (for example `curvine-server/fault-injection`). Enabling `[fault_injection]` without that feature fails server startup instead of silently omitting the route.","locale":"en"},"1286":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-368","page_id":"/docs/Deploy/Deplo