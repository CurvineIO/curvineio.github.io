ions/webui#configuration---system-configuration","content":"Configuration - System Configuration","locale":"en"},"3294":{"id":"/docs/User-Manuals/Operations/webui-18","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-parameter-display","content":"Configuration Parameter Display","locale":"en"},"3295":{"id":"/docs/User-Manuals/Operations/webui-19","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#formatting-configuration","content":"Formatting Configuration","locale":"en"},"3296":{"id":"/docs/User-Manuals/Operations/webui-20","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#testing-and-debugging-configuration","content":"Testing and Debugging Configuration","locale":"en"},"3297":{"id":"/docs/User-Manuals/Operations/webui-21","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#cluster-identification","content":"Cluster Identification","locale":"en"},"3298":{"id":"/docs/User-Manuals/Operations/webui-22","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#network-configuration","content":"Network Configuration","locale":"en"},"3299":{"id":"/docs/User-Manuals/Operations/webui-23","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#performance-tuning-parameters","content":"Performance Tuning Parameters","locale":"en"},"3300":{"id":"/docs/User-Manuals/Operations/webui-24","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#metadata-management","content":"Metadata Management","locale":"en"},"3301":{"id":"/docs/User-Manuals/Operations/webui-25","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-validation-and-diagnostics","content":"Configuration Validation and Diagnostics","locale":"en"},"3302":{"id":"/docs/User-Manuals/Operations/webui-26","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-management-best-practices","content":"Configuration Management Best Practices","locale":"en"},"3303":{"id":"/docs/User-Manuals/Operations/webui-27","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#mounts---ufs-mappings","content":"Mounts - UFS Mappings","locale":"en"},"3304":{"id":"/docs/User-Manuals/Operations/webui-28","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#jobs---load-and-export-jobs","content":"Jobs - Load and Export Jobs","locale":"en"},"3305":{"id":"/docs/User-Manuals/Operations/webui-29","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#observability-and-operations","content":"Observability and Operations","locale":"en"},"3306":{"id":"/docs/User-Manuals/Operations/webui-30","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui","content":"Curvine provides an intuitive and user-friendly web management interface that allows users to monitor cluster status in real-time, browse the file system, inspect worker nodes, follow load and transfer jobs, and read the effective configuration — all from a browser. The web interface serves as a visual operations platform for cluster operations and daily management, so most inspection tasks no longer require the CLI.","locale":"en"},"3307":{"id":"/docs/User-Manuals/Operations/webui-31","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#starting-the-console","content":"The console is the standalone `curvine-web` process, not part of the Master server. The Master's own `web_port` (`9010`) serves `/metrics` only.","locale":"en"},"3308":{"id":"/docs/User-Manuals/Operations/webui-32","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#starting-the-console","content":"`curvine-web.sh` supports `start`, `stop`, and `restart` (there is no `status`\naction); check the process with `ps` or by requesting `http://<host>:9000`.","locale":"en"},"3309":{"id":"/docs/User-Manuals/Operations/webui-33","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#starting-the-console","content":"Relevant configuration:","locale":"en"},"3310":{"id":"/docs/User-Manuals/Operations/webui-34","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#starting-the-console","content":"See Configuration Reference for `[web.observability]`, which controls the built-in metrics collector and the Prometheus integration behind the monitoring pages.","locale":"en"},"3311":{"id":"/docs/User-Manuals/Operations/webui-35","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#navigation","content":"The sidebar groups the pages exactly as the console does; the breadcrumb reads\nfrom the same definition.","locale":"en"},"3312":{"id":"/docs/User-Manuals/Operations/webui-36","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#navigation","content":"| Group    | Page     | Path        | What it shows                         |\n| -------- | -------- | ----------- | ------------------------------------- |\n| Overview | Overview | `/overview` | Cluster health, capacity and activity |","locale":"en","table":"table-0"},"3313":{"id":"/docs/User-Manuals/Operat