User-Manuals/Operations/cli#appendix-ufs-mount-parameters","content":"Appendix: UFS Mount Parameters","locale":"en"},"2476":{"id":"/docs/User-Manuals/Operations/cli-16","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#s3-s3-s3a","content":"S3 (`s3://`, `s3a://`)","locale":"en"},"2477":{"id":"/docs/User-Manuals/Operations/cli-17","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#oss-oss","content":"OSS (`oss://`)","locale":"en"},"2478":{"id":"/docs/User-Manuals/Operations/cli-18","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#hdfs-hdfs","content":"HDFS (`hdfs://`)","locale":"en"},"2479":{"id":"/docs/User-Manuals/Operations/cli-19","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#webhdfs-webhdfs","content":"WebHDFS (`webhdfs://`)","locale":"en"},"2480":{"id":"/docs/User-Manuals/Operations/cli-20","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli","content":"This section is based on the current repository source in `curvine-cli`, `build/cv`, and `build/bin/dfs`. Curvine currently exposes three CLI entry styles:","locale":"en"},"2481":{"id":"/docs/User-Manuals/Operations/cli-21","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli","content":"**Native Rust CLI `cv`**: the recommended entry point, with the full command tree from `curvine-cli`.","locale":"en"},"2482":{"id":"/docs/User-Manuals/Operations/cli-22","page_id":"/docs/User-Manuals/Operations/cli","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/cli","content":"**Compatibility wrapper `dfs`**: bundled in the distribution; `fs` / `report` go through Java `CurvineShell` and keep Hadoop `FsShell` style.","locale":"en"},"2483":{"id"