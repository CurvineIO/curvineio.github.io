Cluster/Distributed-Mode/conf-11","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#log-cli-job","content":"`[log]`, `[cli]`, `[job]`","locale":"en"},"930":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-12","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"Global `[log]`","locale":"en"},"931":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-13","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#cli","content":"`[cli]`","locale":"en"},"932":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-14","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#job","content":"`[job]`","locale":"en"},"933":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-15","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"`[transfer]`","locale":"en"},"934":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-16","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#discovery","content":"`[discovery]`","locale":"en"},"935":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-17","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","type":"heading","tags":[],"url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#fault_injection","content":"`[fault_injection]`","locale":"en"},"936":{"id":"/do