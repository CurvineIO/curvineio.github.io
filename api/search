ces#91-high-availability","content":"9.1 High Availability","locale":"en"},"3209":{"id":"/docs/User-Manuals/best-practices-37","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"9.2 Capacity and Retention","locale":"en"},"3210":{"id":"/docs/User-Manuals/best-practices-38","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"10. Common Pitfalls and Troubleshooting","locale":"en"},"3211":{"id":"/docs/User-Manuals/best-practices-39","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"11. Security Recommendations","locale":"en"},"3212":{"id":"/docs/User-Manuals/best-practices-40","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"12. Upgrade and Maintenance","locale":"en"},"3213":{"id":"/docs/User-Manuals/best-practices-41","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices","content":"This guide consolidates production-proven recommendations for deploying, configuring, and operating Curvine across common workload scenarios. Each section is self-contained — apply the practices relevant to your environment.","locale":"en"},"3214":{"id":"/docs/User-Manuals/best-practices-42","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role   | Minimum (Dev/Test) | Recommended (Production) | Notes                                             |\n| ------ | ------------------ | ------------------------ | ------------------------------------------------- |\n| Master | 1 node             | 3 nodes (Raft group)     | Odd number for quorum; 3-node tolerates 1 failure |","locale":"en","table":"table-0"},"3215":{"id":"/docs/User-Manuals/best-practices-43","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role   | Minimum (Dev/Test) | Recommended (Production) | Notes                                            |\n| ------ | ------------------ | ------------------------ | ------------------------------------------------ |\n| Worker | 1 node             | 3+ nodes                 | Scale horizontally based on cache capacity needs |","locale":"en","table":"table-0"},"3216":{"id":"/docs/User-Manuals/best-practices-44","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role | Minimum (Dev/Test)  | Recommended (Production) | Notes                                     |\n| ---- | ------------------- | ------------------------ | ----------------------------------------- |\n| FUSE | Co-located with app | 1 per compute node       | Deploy close to the workload for locality |","locale":"en","table":"table-0"},"3217":{"id":"/docs/User-Manuals/best-practices-45","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Always deploy **3 Master nodes** in production to form a Raft group. A single Master is a single point of failure.","locale":"en"},"3218":{"id":"/docs/User-Manuals/best-practices-46","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Set `journal_addrs` to list all Raft peers explicitly:","locale":"en"},"3219":{"id":"/docs/User-Manuals/best-practices-47","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Place Master nodes on separate physical hosts or availability zones to survive rack/zone failures.","locale":"en"},"3220":{"id":"/docs/User-Manuals/best-practices-48","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Use `snapshot_interval = \"6h\"` (default) to keep Raft log size bounded.","locale":"en"},"3221":{"id":"/docs/User-Manuals/best-practices-49","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#13-production-configuration-checklist","content":"Set `CURVINE_MASTER_HOSTNAME`, `CURVINE_WORKER_HOSTNAME`, and `CURVINE_CLIENT_HOSTNAME` to routable addresses in multi-node environments.","locale":"en"},"3222":{"id":"/docs/User-Manuals/best-practices-50","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#13-production-configuration-checklist","content":"Never use `localhost` for any hostname in distributed deployments.","locale":"en"},"3223":{"id":"/docs/User-Manuals/best-practices-51","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"Use the official Helm chart for K8s environments:","locale":"en"},"3224":{"id":"/docs/User-Manuals/best-practices-52","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"Use `ReadWriteMany` PVCs with the CSI driver for shared data access across pods.","locale":"en"},"3225":{"id":"/docs/User-Manuals/best-practices-53","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"For latency-sensitive workloads, prefer `embedded` mount mode; for FUSE isolation, use `standalone` mode.","locale":"en"},"3226":{"id":"/docs/User-Manuals/best-practices-54","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#15-kernel-and-os-tuning","content":"Use **Linux kernel 5.0+** (e.g., Ubuntu 22.04, Rocky Linux 9) for optimal FUSE performance.","locale":"en"},"3227":{"id":"/docs/User-Manuals/best-practices-55","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#15-kernel-and-os-tuning","content":"Avoid kernels below 4.15 in production — FUSE concurrency is severely limited.","locale":"en"},"3228":{"id":"/docs/User-Manuals/best-practices-56","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#2-mount-mode-selection","content":"Choosing the right mount mode is the single most impactful decision for your workload.","locale":"en"},"3229":{"id":"/docs/User-Manuals/best-practices-57","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                          | Recommended Mode | Rationale                                              |\n| --------------------------------- | ---------------- | ------------------------------------------------------ |\n| Read-heavy analytics over S3/HDFS | `cache_mode`     | UFS remains source of truth; Curvine accelerates reads |","locale":"en","table":"table-1"},"3230":{"id":"/docs/User-Manuals/best-practices-58","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                                 | Recommended Mode | Rationale                                    |\n| ---------------------------------------- | ---------------- | -------------------------------------------- |\n| AI/ML training data (immutable datasets) | `cache_mode`     | Data rarely changes; cache hit ratio is high |","locale":"en","table":"table-1"},"3231":{"id":"/docs/User-Manuals/best-practices-59","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                         | Recommended Mode | Rationale                                    |\n| -------------------------------- | ---------------- | -------------------------------------------- |\n| General-purpose POSIX filesystem | `fs_mode`        | Full random write, rename, file lock support |","locale":"en","table":"table-1"},"3232":{"id":"/docs/User-Manuals/best-practices-60","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                       | Recommended Mode | Rationale                                |\n| ------------------------------ | ---------------- | ---------------------------------------- |\n| Database storage / log writing | `fs_mode`        | Requires in-place modification semantics |","locale":"en","table":"table-1"},"3233":{"id":"/docs/User-Manuals/best-practices-61","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                            | Recommended Mode | Rationale                                  |\n| ----------------------------------- | ---------------- | ------------------------------------------ |\n| Shuffle data / intermediate results | `fs_mode`        | High write throughput with async UFS flush |","locale":"en","table":"table-1"},"3234":{"id":"/docs/User-Manuals/best-practices-62","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                      | Recommended Mode | Rationale                                     |\n| ----------------------------- | ---------------- | --------------------------------------------- |\n| Multi-cloud unified namespace | `cache_mode`     | Transparent proxy over heterogeneous backends |","locale":"en","table":"table-1"},"3235":{"id":"/docs/User-Manuals/best-practices-63","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"Enable `--read-verify-ufs true` **only** when UFS data changes frequently and staleness is unacceptable. It adds one extra UFS HEAD request per read.","locale":"en"},"3236":{"id":"/docs/User-Manuals/best-practices-64","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"Use `bin/cv fs free -r /path` to release cache space safely without deleting UFS data.","locale":"en"},"3237":{"id":"/docs/User-Manuals/best-practices-65","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"**Warning**: `delete` in cache_mode deletes UFS data. Use `free` for cache-only cleanup.","locale":"en"},"3238":{"id":"/docs/User-Manuals/best-practices-66","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"Run `bin/cv mount resync /workspace` after external UFS changes to synchronize metadata.","locale":"en"},"3239":{"id":"/docs/User-Manuals/best-practices-67","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"**Never rename large directories** on S3/OSS backends — it triggers full data copy.","locale":"en"},"3240":{"id":"/docs/User-Manuals/best-practices-68","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"Set `--replicas 2` or higher for critical data to survive Worker failures.","locale":"en"},"3241":{"id":"/docs/User-Manuals/best-practices-69","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature      | Storage Tier | TTL | Replicas | Example                       |\n| --------------------- | ------------ | --- | -------- | ----------------------------- |\n| Hot (frequent access) | MEM          | 1d  | 2-3      | Model weights, feature tables |","locale":"en","table":"table-2"},"3242":{"id":"/docs/User-Manuals/best-practices-70","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature      | Storage Tier | TTL | Replicas | Example                          |\n| --------------------- | ------------ | --- | -------- | -------------------------------- |\n| Warm (regular access) | SSD          | 7d  | 2        | Training datasets, Parquet files |","locale":"en","table":"table-2"},"3243":{"id":"/docs/User-Manuals/best-practices-71","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature         | Storage Tier | TTL | Replicas | Example                   |\n| ------------------------ | ------------ | --- | -------- | ------------------------- |\n| Cold (infrequent access) | HDD          | 30d | 1        | Archives, historical logs |","locale":"en","table":"table-2"},"3244":{"id":"/docs/User-Manuals/best-practices-72","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**Sequential read (large files > 100GB):**","locale":"en"},"3245":{"id":"/docs/User-Manuals/best-practices-73","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**High-concurrency small files (> 1000 concurrent):**","locale":"en"},"3246":{"id":"/docs/User-Manuals/best-practices-74","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**Random read:**","locale":"en"},"3247":{"id":"/docs/User-Manuals/best-practices-75","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"**Always use FUSE3** in production — FUSE2 delivers only ~50% of FUSE3 throughput.","locale":"en"},"3248":{"id":"/docs/User-Manuals/best-practices-76","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"If stuck on FUSE2, use multiple mount points:","locale":"en"},"3249":{"id":"/docs/User-Manuals/best-practices-77","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"For memory-constrained FUSE nodes:","locale":"en"},"3250":{"id":"/docs/User-Manuals/best-practices-78","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"Curvine FUSE is fully asynchronous — `attr_timeout` and `entry_timeout` are optional. Increase them for read-heavy workloads with stable metadata:","locale":"en"},"3251":{"id":"/docs/User-Manuals/best-practices-79","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"Set `entry_timeout = 0` and `attr_timeout = 0` if you need real-time visibility of changes from other clients.","locale":"en"},"3252":{"id":"/docs/User-Manuals/best-practices-80","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload                   | TTL | TTL Action | Rationale            |\n| -------------------------- | --- | ---------- | -------------------- |\n| Streaming / real-time data | 1h  | delete     | Data expires quickly |","locale":"en","table":"table-3"},"3253":{"id":"/docs/User-Manuals/best-practices-81","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload              | TTL     | TTL Action | Rationale                |\n| --------------------- | ------- | ---------- | ------------------------ |\n| Daily batch analytics | 1d - 7d | delete     | Aligns with job schedule |","locale":"en","table":"table-3"},"3254":{"id":"/docs/User-Manuals/best-practices-82","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload                | TTL      | TTL Action | Rationale                     |\n| ----------------------- | -------- | ---------- | ----------------------------- |\n| Model training datasets | 7d - 30d | free       | Keep metadata, release blocks |","locale":"en","table":"table-3"},"3255":{"id":"/docs/User-Manuals/best-practices-83","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload             | TTL          | TTL Action | Rationale                           |\n| -------------------- | ------------ | ---------- | ----------------------------------- |\n| Persistent workspace | 0 (disabled) | none       | Data lives until explicitly deleted |","locale":"en","table":"table-3"},"3256":{"id":"/docs/User-Manuals/best-practices-84","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"When using `rclone` or similar tools that preserve `mtime`, imported files may immediately expire. Verify TTL settings before large-scale imports, or temporarily disable TTL.","locale":"en"},"3257":{"id":"/docs/User-Manuals/best-practices-85","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#52-quota-based-eviction","content":"Enable LRU eviction to prevent storage exhaustion:","locale":"en"},"3258":{"id":"/docs/User-Manuals/best-practices-86","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#52-quota-based-eviction","content":"Files with `ttl_action = \"none\"` are **exempt** from LRU eviction — use this for critical data.","locale":"en"},"3259":{"id":"/docs/User-Manuals/best-practices-87","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Warm up the cache before peak workloads:","locale":"en"},"3260":{"id":"/docs/User-Manuals/best-practices-88","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Automatic caching is enabled per-mount when TTL > 0. First reads trigger background load jobs.","locale":"en"},"3261":{"id":"/docs/User-Manuals/best-practices-89","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Combine proactive + automatic caching for best hit ratio.","locale":"en"},"3262":{"id":"/docs/User-Manuals/best-practices-90","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Use FUSE mount point directly in PyTorch/TensorFlow data loaders — no code changes needed.","locale":"en"},"3263":{"id":"/docs/User-Manuals/best-practices-91","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Set `num_workers=8` in DataLoader for parallel FUSE reads.","locale":"en"},"3264":{"id":"/docs/User-Manuals/best-practices-92","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Pre-load datasets before training starts: `bin/cv load s3://datasets/imagenet -w`","locale":"en"},"3265":{"id":"/docs/User-Manuals/best-practices-93","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#62-model-serving","content":"Use `--ttl-ms 0` (no expiration) for model files that must always be available.","locale":"en"},"3266":{"id":"/docs/User-Manuals/best-practices-94","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#62-model-serving","content":"Enable `--read-verify-ufs` to detect model version updates pushed to UFS.","locale":"en"},"3267":{"id":"/docs/User-Manuals/best-practices-95","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#71-spark-integration","content":"For zero-code acceleration, use the S3A transparent proxy:","locale":"en"},"3268":{"id":"/docs/User-Manuals/best-practices-96","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#71-spark-integration","content":"Mounted paths automatically use Curvine cache; unmounted paths fall through to native S3.","locale":"en"},"3269":{"id":"/docs/User-Manuals/best-practices-97","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Use `fs_mode` mounts for shuffle data to benefit from full write acceleration.","locale":"en"},"3270":{"id":"/docs/User-Manuals/best-practices-98","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Set `--storage-type ssd` for shuffle — memory is too expensive for ephemeral data.","locale":"en"},"3271":{"id":"/docs/User-Manuals/best-practices-99","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Use short TTL (`1h`-`4h`) since shuffle data is transient.","locale":"en"},"3272":{"id":"/docs/User-Manuals/best-practices-100","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern        | Recommended Block Size | Rationale                                     |\n| ------------------- | ---------------------- | --------------------------------------------- |\n| Small files (< 4MB) | 4MB                    | One block per file, minimal metadata overhead |","locale":"en","table":"table-4"},"3273":{"id":"/docs/User-Manuals/best-practices-101","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern            | Recommended Block Size | Rationale                         |\n| ----------------------- | ---------------------- | --------------------------------- |\n| Parquet / ORC analytics | 128MB (default)        | Balanced parallelism and locality |","locale":"en","table":"table-4"},"3274":{"id":"/docs/User-Manuals/best-practices-102","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern           | Recommended Block Size | Rationale                                 |\n| ---------------------- | ---------------------- | ----------------------------------------- |\n| Large sequential files | 1GB                    | Reduces connection count for random reads |","locale":"en","table":"table-4"},"3275":{"id":"/docs/User-Manuals/best-practices-103","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern           | Recommended Block Size | Rationale                         |\n| ---------------------- | ---------------------- | --------------------------------- |\n| Video / model binaries | 256MB - 1GB            | High throughput sequential access |","locale":"en","table":"table-4"},"3276":{"id":"/docs/User-Manuals/best-practices-104","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| Master    | `http://<host>:9001/metrics` | 9001 |","locale":"en","table":"table-5"},"3277":{"id":"/docs/User-Manuals/best-practices-105","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| Worker    | `http://<host>:9002/metrics` | 9002 |","locale":"en","table":"table-5"},"3278":{"id":"/docs/User-Manuals/best-practices-106","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| FUSE      | `http://<host>:9003/metrics` | 9003 |","locale":"en","table":"table-5"},"3279":{"id":"/docs/User-Manuals/best-practices-107","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component           | Endpoint                     | Port |\n| ------------------- | ---------------------------- | ---- |\n| Transfer (optional) | `http://<host>:9011/metrics` | 9011 |","locale":"en","table":"table-5"},"3280":{"id":"/docs/User-Manuals/best-practices-108","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                 | Alert Condition | Action                      |\n| ---------------------- | --------------- | --------------------------- |\n| `available / capacity` | < 20%           | Scale Workers or reduce TTL |","locale":"en","table":"table-6"},"3281":{"id":"/docs/User-Manuals/best-practices-109","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                 | Alert Condition | Action                  |\n| ---------------------- | --------------- | ----------------------- |\n| `worker_num` (offline) | > 0 for 5min    | Investigate node health |","locale":"en","table":"table-6"},"3282":{"id":"/docs/User-Manuals/best-practices-110","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                      | Alert Condition | Action                      |\n| --------------------------- | --------------- | --------------------------- |\n| `replication_failure_count` | Increasing      | Check network / disk health |","locale":"en","table":"table-6"},"3283":{"id":"/docs/User-Manuals/best-practices-111","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                      | Alert Condition    | Action                           |\n| --------------------------- | ------------------ | -------------------------------- |\n| `client_mount_cache_misses` | High ratio vs hits | Review TTL / preloading strategy |","locale":"en","table":"table-6"},"3284":{"id":"/docs/User-Manuals/best-practices-112","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric         | Alert Condition | Action                   |\n| -------------- | --------------- | ------------------------ |\n| `failed_disks` | > 0             | Replace disk immediately |","locale":"en","table":"table-6"},"3285":{"id":"/docs/User-Manuals/best-practices-113","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#84-web-ui","content":"Master UI: `http://<master-host>:9001` — cluster overview, file browser, worker status, configuration.","locale":"en"},"3286":{"id":"/docs/User-Manuals/best-practices-114","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#84-web-ui","content":"Worker UI: `http://<worker-host>:9002` — node-level storage and block statistics.","locale":"en"},"3287":{"id":"/docs/User-Manuals/best-practices-115","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#9-transfer-service-best-practices","content":"The S3 gateway is not part of the current Curvine server. Use the optional\nTransfer service for independent Load and Export scheduling instead.","locale":"en"},"3288":{"id":"/docs/User-Manuals/best-practices-116","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"Use a shared MySQL `store_url` before running more than one Transfer replica.","locale":"en"},"3289":{"id":"/docs/User-Manuals/best-practices-117","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"The default SQLite store is suitable for a single Transfer instance only.","locale":"en"},"3290":{"id":"/docs/User-Manuals/best-practices-118","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"Keep `transfer.replicas = 1` when SQLite is in use.","locale":"en"},"3291":{"id":"/docs/User-Manuals/best-practices-119","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Tune `max_running_transfers` to match available UFS bandwidth.","locale":"en"},"3292":{"id":"/docs/User-Manuals/best-practices-120","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Set `terminal_retention` according to how long completed jobs must remain queryable.","locale":"en"},"3293":{"id":"/docs/User-Manuals/best-practices-121","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Monitor the Transfer `/metrics` endpoint and the `cv transfer list` backlog.","locale":"en"},"3294":{"id":"/docs/User-Manuals/best-practices-122","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                               | Symptom                     | Solution                                    |\n| ------------------------------------- | --------------------------- | ------------------------------------------- |\n| Using `localhost` in distributed mode | Workers cannot reach Master | Set proper hostnames via env vars or config |","locale":"en","table":"table-7"},"3295":{"id":"/docs/User-Manuals/best-practices-123","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                                  | Symptom                    | Solution                                              |\n| ---------------------------------------- | -------------------------- | ----------------------------------------------------- |\n| Renaming large S3 directories in fs_mode | Operation blocks for hours | Avoid rename on object storage; copy + delete instead |","locale":"en","table":"table-7"},"3296":{"id":"/docs/User-Manuals/best-practices-124","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                         | Symptom                        | Solution                                             |\n| ------------------------------- | ------------------------------ | ---------------------------------------------------- |\n| TTL too short for training data | Cache thrashing, low hit ratio | Increase `--ttl-ms` to match training epoch duration |","locale":"en","table":"table-7"},"3297":{"id":"/docs/User-Manuals/best-practices-125","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall             | Symptom             | Solution                                 |\n| ------------------- | ------------------- | ---------------------------------------- |\n| FUSE2 in production | 50% throughput loss | Upgrade to FUSE3 or use `mnt_number = 4` |","locale":"en","table":"table-7"},"3298":{"id":"/docs/User-Manuals/best-practices-126","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                       | Symptom                               | Solution                                             |\n| ----------------------------- | ------------------------------------- | ---------------------------------------------------- |\n| `rclone` preserving old mtime | Files immediately expire after import | Adjust mtime after import or disable TTL temporarily |","locale":"en","table":"table-7"},"3299":{"id":"/docs/User-Manuals/best-practices-127","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                     | Symptom                        | Solution                 |\n| --------------------------- | ------------------------------ | ------------------------ |\n| Single Master in production | Cluster down on Master failure | Deploy 3-node Raft group |","locale":"en","table":"table-7"},"3300":{"id":"/docs/User-Manuals/best-practices-128","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                              | Symptom                   | Solution                           |\n| ------------------------------------ | ------------------------- | ---------------------------------- |\n| `format_master = true` in production | Metadata wiped on restart | Set to `false` after initial setup |","locale":"en","table":"table-7"},"3301":{"id":"/docs/User-Manuals/best-practices-129","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                        | Symptom                   | Solution                              |\n| ------------------------------ | ------------------------- | ------------------------------------- |\n| Ignoring `failed_disks` metric | Data loss on disk failure | Monitor and replace disks proactively |","locale":"en","table":"table-7"},"3302":{"id":"/docs/User-Manuals/best-practices-130","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                         | Symptom                                   | Solution                            |\n| ------------------------------- | ----------------------------------------- | ----------------------------------- |\n| Not running `resync` in fs_mode | Stale metadata after external UFS changes | Schedule periodic `cv mount resync` |","locale":"en","table":"table-7"},"3303":{"id":"/docs/User-Manuals/best-practices-131","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                              | Symptom                                  | Solution                                |\n| ------------------------------------ | ---------------------------------------- | --------------------------------------- |\n| Block size too small for large files | Excessive connections, slow random reads | Use `--block-size 1GB` for files > 10GB |","locale":"en","table":"table-7"},"3304":{"id":"/docs/User-Manuals/best-practices-132","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Rotate UFS credentials regularly; use IAM roles where possible.","locale":"en"},"3305":{"id":"/docs/User-Manuals/best-practices-133","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Use network policies (K8s) or firewall rules to restrict access to Master RPC (8995) and Worker RPC (8997) ports.","locale":"en"},"3306":{"id":"/docs/User-Manuals/best-practices-134","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Enable audit logging (`audit_logging_enabled = true`) for compliance-sensitive environments.","locale":"en"},"3307":{"id":"/docs/User-Manuals/best-practices-135","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"In multi-tenant environments, isolate namespaces by using separate Curvine paths per team with quota controls.","locale":"en"},"3308":{"id":"/docs/User-Manuals/best-practices-136","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Always take a metadata snapshot before upgrading Master nodes.","locale":"en"},"3309":{"id":"/docs/User-Manuals/best-practices-137","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Perform rolling upgrades: upgrade Followers first, then trigger leader transfer and upgrade the last node.","locale":"en"},"3310":{"id":"/docs/User-Manuals/best-practices-138","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"After upgrading Workers, verify heartbeat registration via the Web UI or `bin/cv report`.","locale":"en"},"3311":{"id":"/docs/User-Manuals/best-practices-139","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Test FUSE remount after upgrades: `bin/curvine-fuse.sh restart`.","locale":"en"},"3312":{"id":"/docs/User-Manuals/best-practices-140","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Keep `retain_checkpoint_num = 3` (default) to allow rollback to previous metadata states.","locale":"en"},"3313":{"id":"/docs/User-Manuals","page_id":"/docs/User-Manuals","type":"page","content":"User Manuals","breadcrumbs":["Documents","User Manuals"],"tags":[],"url":"/docs/User-Manuals","locale":"en"},"3314":{"id":"/docs/User-Manuals/opt","page_id":"/docs/User-Manuals/op