en"},"2392":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-75","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--direct-io`","locale":"en"},"2393":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-76","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--cache-readdir`","locale":"en"},"2394":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-77","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--entry-timeout`","locale":"en"},"2395":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-78","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--attr-timeout`","locale":"en"},"2396":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-79","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--negative-timeout`","locale":"en"},"2397":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-80","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--max-background`","locale":"en"},"2398":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-81","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--congestion-threshold`","locale":"en"},"2399":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-82","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--node-cache-size`","locale":"en"},"2400":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-83","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--node-cache-timeout`","locale":"en"},"2401":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-84","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"`--mnt-number`","locale":"en"},"2402":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-85","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#fuse-command-construction","content":"The validator also still accepts several older keys such as `auto-cache`, `kernel-cache`, `master-hostname`, `master-rpc-port`, and `master-web-port`. Those keys are not separately documented on the current `curvine-fuse` CLI page, so treat them as compatibility behavior rather than a stable public contract.","locale":"en"},"2403":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-86","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"The controller validates StorageClass parameters and creates `curvine-path`.","locale":"en"},"2404":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-87","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"The controller returns `VolumeContext` containing `master-addrs`, `fs-path`, and `curvine-path`.","locale":"en"},"2405":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-88","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"The node plugin computes `cluster-id`, `mount-key`, and `mnt-path`.","locale":"en"},"2406":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-89","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"If a compatible FUSE process already exists for that `master-addrs + fs-path` pair, the node reuses it.","locale":"en"},"2407":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-90","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"Otherwise, the node starts a new `curvine-fuse` process.","locale":"en"},"2408":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-91","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"The node bind-mounts the correct subdirectory into the pod.","locale":"en"},"2409":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-92","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#lifecycle-summary","content":"When reference count reaches zero, `NodeUnstageVolume` stops the unused FUSE mount.","locale":"en"},"2410":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-93","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#static-versus-dynamic-pvs","content":"| Mode                         | Required attributes                                      | Controller behavior                         | Node behavior                                                 |\n| ---------------------------- | -------------------------------------------------------- | ------------------------------------------- | ------------------------------------------------------------- |\n| Dynamic PVC via StorageClass | `master-addrs`, optional `fs-path`, optional `path-type` | Generates `volumeHandle` and `curvine-path` | Mounts `fs-path`, then bind-mounts the generated subdirectory |","locale":"en","table":"table-1"},"2411":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-94","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#static-versus-dynamic-pvs","content":"| Mode      | Required attributes            | Controller behavior                                 | Node behavior                                                                   |\n| --------- | ------------------------------ | --------------------------------------------------- | ------------------------------------------------------------------------------- |\n| Static PV | `master-addrs`, `curvine-path` | No directory naming convention is generated for you | Mounts root by default if `fs-path` is omitted, then bind-mounts `curvine-path` |","locale":"en","table":"table-1"},"2412":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-95","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#operational-guidance","content":"Use `standalone` when CSI node pod restarts or upgrades must not interrupt the business FUSE process; `embedded` is the Helm default for simpler deployments.","locale":"en"},"2413":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-96","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#operational-guidance","content":"Set `fs-path` explicitly in StorageClasses even though the code defaults it to `/`. That makes reuse behavior and directory layout predictable.","locale":"en"},"2414":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Framework-97","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Framework","tags":[],"type":"text","url":"/docs/User-Manuals/K8S-CSI-Driver/Framework#operational-guidance","content":"Do not depend on manual `mnt-path` assignment in new deployments; the main branch implementation already auto-generates it.","locale":"en"},"2415":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"page","content":"K8S CSI Driver","breadcrumbs":["Documents","User Manuals","K8S CSI Driver"],"tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup","locale":"en"},"2416":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-0","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#architecture","content":"Architecture","locale":"en"},"2417":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-1","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#deployment","content":"Deployment","locale":"en"},"2418":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-2","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#example-1-dynamic-pv","content":"Example 1: Dynamic PV","locale":"en"},"2419":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-3","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#1-storageclass","content":"1. StorageClass","locale":"en"},"2420":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-4","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#2-pvc","content":"2. PVC","locale":"en"},"2421":{"id":"/docs/User-Manuals/K8S-CSI-Driver/Setup-5","page_id":"/docs/User-Manuals/K8S-CSI-Driver/Setup","type":"heading","tags":[],"url":"/docs/User-Manuals/K8S-CSI-Driver/Setup#3-pod","content":"3. Pod","locale":"en"},"2422":{"id":"/docs/Us