ocale":"en","table":"table-4"},"2714":{"id":"/docs/User-Manuals/Operations/monitoring-52","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name | Description             |\n| ----------- | ----------------------- |\n| available   | Available storage space |","locale":"en","table":"table-4"},"2715":{"id":"/docs/User-Manuals/Operations/monitoring-53","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name | Description            |\n| ----------- | ---------------------- |\n| fs_used     | File system used space |","locale":"en","table":"table-4"},"2716":{"id":"/docs/User-Manuals/Operations/monitoring-54","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name  | Description                      |\n| ------------ | -------------------------------- |\n| failed_disks | Number of failed storage devices |","locale":"en","table":"table-4"},"2717":{"id":"/docs/User-Manuals/Operations/monitoring-55","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name | Description                   |\n| ----------- | ----------------------------- |\n| total_disks | Total number of storage disks |","locale":"en","table":"table-4"},"2718":{"id":"/docs/User-Manuals/Operations/monitoring-56","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name | Description            |\n| ----------- | ---------------------- |\n| num_blocks  | Total number of blocks |","locale":"en","table":"table-4"},"2719":{"id":"/docs/User-Manuals/Operations/monitoring-57","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name          | Description                       |\n| -------------------- | --------------------------------- |\n| num_blocks_to_delete | Number of blocks pending deletion |","locale":"en","table":"table-4"},"2720":{"id":"/docs/User-Manuals/Operations/monitoring-58","page_id":"/docs/User-Manuals/Operations/monitoring","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/monitoring#worker-metrics","content":"| Metric Name       | Description          |\n| ----------------- | -------------------- |\n| used_memory_bytes | Used memory in bytes |","locale":"en","table":"table-4"},"2721":{"id":"/docs/User-Manuals/Operations/release-notes","page_id":"/docs/User-Manuals/Operations/release-notes","type":"page","content":"Release Notes and Known Incompatible Versions","breadcrumbs":["Documents","User Manuals","Operations"],"tags":[],"url":"/docs/User-Manuals/Operations/release-notes","locale":"en"},"2722":{"id":"/docs/User-Manuals/Operations/release-notes-0","page_id":"/docs/User-Manuals/Operations/release-notes","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/release-notes#release-notes-template","content":"Release Notes Template","locale":"en"},"2723":{"id":"/docs/User-Manuals/Operations/release-notes-1","page_id":"/docs/User-Manuals/Operations/release-notes","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/release-notes#known-incompatible-versions","content":"Known Incompatible Versions","locale":"en"},"2724":{"id":"/docs/User-Manuals/Operations/release-notes-2","page_id":"/docs/User-Manuals/Operations/release-notes","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/release-notes#version-specific-incompatibilities","content":"Version-Specific Incompatibilities","locale":"en"},"2725":{"id":"/docs/User-Manuals/Operations/release-notes-3","page_id":"/docs/User-Manuals/Operations/release-notes","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/release-notes#reporting-a-new-incompatibility","content":"Reporting a New Incompatibility","locale":"en"},"2726":{"id":"/docs/User-Manuals/Operations/release-notes-4","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes","content":"This page compiles the release notes template used for each Curvine release and\nthe list of release versions known to be incompatible with other Curvine\ncomponents. Keep this page in sync whenever a version is added to\n`master.compatibility.blocked_versions` or a new protocol version is\nintroduced.","locale":"en"},"2727":{"id":"/docs/User-Manuals/Operations/release-notes-5","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#release-notes-template","content":"Copy the template below, fill in the version and date, and ship it with the\nrelease announcement. The **Compatibility** table must match the\nCompatibility Matrix for that version.","locale":"en"},"2728":{"id":"/docs/User-Manuals/Operations/release-notes-6","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#known-incompatible-versions","content":"Release versions are added to this list when they have critical bugs or\nprotocol-level incompatibilities that make them unsafe in a mixed-version\ncluster. The corresponding `blocked_versions` entry in the master\n`compatibility` section is the operational enforcement of these entries:\nblocked versions are **always rejected regardless of mode** (emergency\nbackstop).","locale":"en"},"2729":{"id":"/docs/User-Manuals/Operations/release-notes-7","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#known-incompatible-versions","content":"| Version | Component | Reason                                           | Introduced In | Resolution                  |\n| ------- | --------- | ------------------------------------------------ | ------------- | --------------------------- |\n| 0.2.5   | worker    | Critical data corruption bug in batch-write path | 0.2.5         | Upgrade to 0.2.6+ or 0.3.0+ |","locale":"en","table":"table-0"},"2730":{"id":"/docs/User-Manuals/Operations/release-notes-8","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#version-specific-incompatibilities","content":"**0.3.x legacy workers / clients with 0.4.x master.** Workers and clients\nrunning 0.3.x (or earlier) do not send structured `component_info`. The master\ndetects them as legacy peers: allowed with a warning in `diagnose` mode\n(default), rejected only in `enforce` mode. No data loss or protocol error\noccurs; the master simply cannot verify their protocol version, release\nversion, or capabilities.","locale":"en"},"2731":{"id":"/docs/User-Manuals/Operations/release-notes-9","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#version-specific-incompatibilities","content":"**Pre-release vs release bounds.** Pre-release versions sort before the\ncorresponding release version (`0.4.0-alpha < 0.4.0`). If\n`min_worker_version = \"0.4.0\"` is configured, a pre-release worker is rejected\nbecause it sorts below the bound. To allow pre-releases, lower the minimum\nbound accordingly.","locale":"en"},"2732":{"id":"/docs/User-Manuals/Operations/release-notes-10","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#reporting-a-new-incompatibility","content":"Open a GitHub issue with the **compatibility** label.","locale":"en"},"2733":{"id":"/docs/User-Manuals/Operations/release-notes-11","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#reporting-a-new-incompatibility","content":"Include: master version, worker/client version, protocol version of each\ncomponent, the full compatibility error or warning, and reproduction steps.","locale":"en"},"2734":{"id":"/docs/User-Manuals/Operations/release-notes-12","page_id":"/docs/User-Manuals/Operations/release-notes","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/release-notes#reporting-a-new-incompatibility","content":"The Curvine team evaluates and either adds the version to `blocked_versions`\nor documents the incompatibility on this page.","locale":"en"},"2735":{"id":"/docs/User-Manuals/Operations/version-management","page_id":"/docs/User-Manuals/Operations/version-management","type":"page","content":"Version Management and Compatibility","breadcrumbs":["Documents","User Manuals","Operations"],"tags":[],"url":"/docs/User-Manuals/Operations/version-management","locale":"en"},"2736":{"id":"/docs/User-Manuals/Operations/version-management-0","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#version-schema","content":"Version Schema","locale":"en"},"2737":{"id":"/docs/User-Manuals/Operations/version-management-1","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#protocol-version","content":"Protocol Version","locale":"en"},"2738":{"id":"/docs/User-Manuals/Operations/version-management-2","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"Viewing Component Versions","locale":"en"},"2739":{"id":"/docs/User-Manuals/Operations/version-management-3","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#worker-version-statistics","content":"Worker Version Statistics","locale":"en"},"2740":{"id":"/docs/User-Manuals/Operations/version-management-4","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#compatibility-between-components","content":"Compatibility Between Components","locale":"en"},"2741":{"id":"/docs/User-Manuals/Operations/version-management-5","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#master--worker","content":"Master ↔ Worker","locale":"en"},"2742":{"id":"/docs/User-Manuals/Operations/version-management-6","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#master--client-including-fuse--cli--csi","content":"Master ↔ Client (including FUSE / CLI / CSI)","locale":"en"},"2743":{"id":"/docs/User-Manuals/Operations/version-management-7","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#worker--client-data-plane","content":"Worker ↔ Client (data plane)","locale":"en"},"2744":{"id":"/docs/User-Manuals/Operations/version-management-8","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#enforcement-policy","content":"Enforcement Policy","locale":"en"},"2745":{"id":"/docs/User-Manuals/Operations/version-management-9","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#capabilities","content":"Capabilities","locale":"en"},"2746":{"id":"/docs/User-Manuals/Operations/version-management-10","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#observability","content":"Observability","locale":"en"},"2747":{"id":"/docs/User-Manuals/Operations/version-management-11","page_id":"/docs/User-Manuals/Operations/version-management","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/version-management#release-notes-and-known-incompatibilities","content":"Release Notes and Known Incompatibilities","locale":"en"},"2748":{"id":"/docs/User-Manuals/Operations/version-management-12","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management","content":"This chapter describes how Curvine components version themselves and how to\noperate a cluster whose components may run different versions. Since 0.4.x\nevery binary emits structured version metadata, servers advertise a\ncompatibility contract, and the master evaluates peers with a lenient\n`diagnose`-by-default policy.","locale":"en"},"2749":{"id":"/docs/User-Manuals/Operations/version-management-13","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#version-schema","content":"All Curvine components use the same version schema:","locale":"en"},"2750":{"id":"/docs/User-Manuals/Operations/version-management-14","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#version-schema","content":"Examples: `0.4.0`, `0.4.0-alpha`, `0.5.0-rc.1+build.1234`","locale":"en"},"2751":{"id":"/docs/User-Manuals/Operations/version-management-15","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#version-schema","content":"Pre-release versions sort before the corresponding release version, following\nSemVer precedence: `0.4.0-alpha < 0.4.0-beta < 0.4.0`.","locale":"en"},"2752":{"id":"/docs/User-Manuals/Operations/version-management-16","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#protocol-version","content":"The **protocol version** is a monotonic integer that governs wire-level\ncompatibility between components. It is **not** the same as the release\nversion.","locale":"en"},"2753":{"id":"/docs/User-Manuals/Operations/version-management-17","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#protocol-version","content":"| Protocol Version | Curvine Release | Notes                               |\n| ---------------- | --------------- | ----------------------------------- |\n| 1                | 0.4.x           | Initial structured protocol version |","locale":"en","table":"table-0"},"2754":{"id":"/docs/User-Manuals/Operations/version-management-18","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#protocol-version","content":"A component accepts a peer whose protocol version falls within\n`[min_protocol_version, protocol_version]` of the server.","locale":"en"},"2755":{"id":"/docs/User-Manuals/Operations/version-management-19","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"Every binary prints its structured version as JSON with `--version-json`:","locale":"en"},"2756":{"id":"/docs/User-Manuals/Operations/version-management-20","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"Example output:","locale":"en"},"2757":{"id":"/docs/User-Manuals/Operations/version-management-21","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"The fields are:","locale":"en"},"2758":{"id":"/docs/User-Manuals/Operations/version-management-22","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"`component` — component name (`master`, `worker`, `client`, `fuse`, `cli`, `csi`).","locale":"en"},"2759":{"id":"/docs/User-Manuals/Operations/version-management-23","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"`release_version` — Cargo/package version of the build.","locale":"en"},"2760":{"id":"/docs/User-Manuals/Operations/version-management-24","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"`git_commit` / `git_tag` / `git_branch` — exact source provenance.","locale":"en"},"2761":{"id":"/docs/User-Manuals/Operations/version-management-25","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"`protocol_version` / `min_protocol_version` — wire protocol bounds.","locale":"en"},"2762":{"id":"/docs/User-Manuals/Operations/version-management-26","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#viewing-component-versions","content":"`capabilities` — feature-level negotiation tokens.","locale":"en"},"2763":{"id":"/docs/User-Manuals/Operations/version-management-27","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#worker-version-statistics","content":"The CLI can summarize the release-version distribution across all live\nworkers. This is the fastest way to see whether a cluster is running a\nhomogeneous set of versions or a mix of old and new workers:","locale":"en"},"2764":{"id":"/docs/User-Manuals/Operations/version-management-28","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#worker-version-statistics","content":"Example output:","locale":"en"},"2765":{"id":"/docs/User-Manuals/Operations/version-management-29","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#worker-version-statistics","content":"Workers that report structured `component_info` count under their\n`release_version`; older workers that only report the legacy\n`software_version` string are counted as `legacy (<version>)`. Workers with no\nusable version data at all are grouped under `legacy (no version)`.","locale":"en"},"2766":{"id":"/docs/User-Manuals/Operations/version-management-30","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#compatibility-between-components","content":"The master evaluates every worker heartbeat and client handshake against its\nown compatibility contract. The default behavior is **lenient**: without\nexplicit configuration the master records a warning and allows the request, so\nold components are never rejected just because they predate the structured\nversion protocol.","locale":"en"},"2767":{"id":"/docs/User-Manuals/Operations/version-management-31","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#master--worker","content":"| Master | Worker | Protocol | Default Behavior |\n| ------ | ------ | -------- | ---------------- |\n| 0.4.x  | 0.4.x  | 1        | ✅ Compatible     |","locale":"en","table":"table-1"},"2768":{"id":"/docs/User-Manuals/Operations/version-management-32","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#master--worker","content":"| Master | Worker                              | Protocol | Default Behavior                                     |\n| ------ | ----------------------------------- | -------- | ---------------------------------------------------- |\n| 0.4.x  | 0.3.x (legacy, no `component_info`) | n/a      | ⚠️ Warning in `diagnose`; rejected only in `enforce` |","locale":"en","table":"table-1"},"2769":{"id":"/docs/User-Manuals/Operations/version-management-33","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#master--worker","content":"| Master | Worker                 | Protocol | Default Behavior                                     |\n| ------ | ---------------------- | -------- | ---------------------------------------------------- |\n| 0.4.x  | < `min_worker_version` | n/a      | ⚠️ Warning in `diagnose`; rejected only in `enforce` |","locale":"en","table":"table-1"},"2770":{"id":"/docs/User-Manuals/Operations/version-management-34","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#master--client-including-fuse--cli--csi","content":"| Master | Client | Protocol | Default Behavior |\n| ------ | ------ | -------- | ---------------- |\n| 0.4.x  | 0.4.x  | 1        | ✅ Compatible     |","locale":"en","table":"table-2"},"2771":{"id":"/docs/User-Manuals/Operations/version-management-35","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#master--client-including-fuse--cli--csi","content":"| Master | Client         | Protocol | Default Behavior                                     |\n| ------ | -------------- | -------- | ---------------------------------------------------- |\n| 0.4.x  | 0.3.x (legacy) | n/a      | ⚠️ Warning in `diagnose`; rejected only in `enforce` |","locale":"en","table":"table-2"},"2772":{"id":"/docs/User-Manuals/Operations/version-management-36","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#worker--client-data-plane","content":"| Worker | Client | Protocol | Default Behavior |\n| ------ | ------ | -------- | ---------------- |\n| 0.4.x  | 0.4.x  | 1        | ✅ Compatible     |","locale":"en","table":"table-3"},"2773":{"id":"/docs/User-Manuals/Operations/version-management-37","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#worker--client-data-plane","content":"| Worker | Client         | Protocol | Default Behavior                                     |\n| ------ | -------------- | -------- | ---------------------------------------------------- |\n| 0.4.x  | 0.3.x (legacy) | n/a      | ⚠️ Warning in `diagnose`; rejected only in `enforce` |","locale":"en","table":"table-3"},"2774":{"id":"/docs/User-Manuals/Operations/version-management-38","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#enforcement-policy","content":"The compatibility policy is configured in the master configuration file:","locale":"en"},"2775":{"id":"/docs/User-Manuals/Operations/version-management-39","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#enforcement-policy","content":"**`mode = \"diagnose\"` (default):** incompatible peers are allowed, and the\nmaster logs a warning describing the peer, its version, and the expected\nbound. This is the safe default and never breaks an existing mixed-version\ncluster.","locale":"en"},"2776":{"id":"/docs/User-Manuals/Operations/version-management-40","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#enforcement-policy","content":"**`mode = \"enforce\"`:** incompatible peers are rejected with an explicit\nerror that includes the actual peer version and the upgrade suggestion.","locale":"en"},"2777":{"id":"/docs/User-Manuals/Operations/version-management-41","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#enforcement-policy","content":"**`blocked_versions`:** release versions listed here are **always rejected**\nregardless of the mode. This is an emergency backstop for known-bad builds\n(see the known-incompatible list on the release notes page).","locale":"en"},"2778":{"id":"/docs/User-Manuals/Operations/version-management-42","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#capabilities","content":"Beyond versions, features are negotiated through capability tokens that each\ncomponent advertises in its `ComponentVersion`. A feature is enabled only when\n**both** peers declare it, so a capability introduced in a newer release is\nsilently disabled until the whole data path upgrades.","locale":"en"},"2779":{"id":"/docs/User-Manuals/Operations/version-management-43","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#capabilities","content":"| Capability | Description                   | Introduced In |\n| ---------- | ----------------------------- | ------------- |\n| `transfer` | Data transfer between workers | 0.4.0         |","locale":"en","table":"table-4"},"2780":{"id":"/docs/User-Manuals/Operations/version-management-44","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#capabilities","content":"| Capability    | Description              | Introduced In |\n| ------------- | ------------------------ | ------------- |\n| `batch-write` | Batch write optimization | 0.4.0         |","locale":"en","table":"table-4"},"2781":{"id":"/docs/User-Manuals/Operations/version-management-45","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#capabilities","content":"| Capability      | Description                                 | Introduced In |\n| --------------- | ------------------------------------------- | ------------- |\n| `short-circuit` | Short-circuit read (client → worker direct) | 0.4.0         |","locale":"en","table":"table-4"},"2782":{"id":"/docs/User-Manuals/Operations/version-management-46","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#observability","content":"The master exposes compatibility metrics on the Prometheus endpoint\n(`http://<master>:9000/metrics`). See the Monitoring Metrics\npage for the full metric table.","locale":"en"},"2783":{"id":"/docs/User-Manuals/Operations/version-management-47","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#observability","content":"| Metric                  | Type  | Labels                 | Description                                            |\n| ----------------------- | ----- | ---------------------- | ------------------------------------------------------ |\n| `compat_worker_verdict` | Gauge | `worker_id`, `verdict` | 1 for the current compatibility verdict of each worker |","locale":"en","table":"table-5"},"2784":{"id":"/docs/User-Manuals/Operations/version-management-48","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#observability","content":"| Metric                  | Type  | Labels                   | Description                                            |\n| ----------------------- | ----- | ------------------------ | ------------------------------------------------------ |\n| `compat_client_verdict` | Gauge | `client_addr`, `verdict` | 1 for the current compatibility verdict of each client |","locale":"en","table":"table-5"},"2785":{"id":"/docs/User-Manuals/Operations/version-management-49","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#observability","content":"| Metric                          | Type    | Labels                 | Description                                           |\n| ------------------------------- | ------- | ---------------------- | ----------------------------------------------------- |\n| `compat_enforce_rejected_total` | Counter | `component`, `verdict` | Total number of enforce-mode compatibility rejections |","locale":"en","table":"table-5"},"2786":{"id":"/docs/User-Manuals/Operations/version-management-50","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#observability","content":"`verdict` takes one of: `compatible`, `missing_info`, `blocked`,\n`protocol_mismatch`, `version_too_old`, `version_unknown`.","locale":"en"},"2787":{"id":"/docs/User-Manuals/Operations/version-management-51","page_id":"/docs/User-Manuals/Operations/version-management","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/version-management#release-notes-and-known-incompatibilities","content":"Each release ships release notes that repeat the compatibility table for that\nspecific version. The known-incompatible list and the release notes template\nare maintained in the release notes page; keep the compatibility table there\nin sync whenever a version is added to `blocked_versions` or a new protocol\nversion is introduced.","locale":"en"},"2788":{"id":"/docs/User-Manuals/Operations/webui","page_id":"/docs/User-Manuals/Operations/webui","type":"page","content":"Web Management Interface","breadcrumbs":["Documents","User Manuals","Operations"],"tags":[],"url":"/docs/User-Manuals/Operations/webui","locale":"en"},"2789":{"id":"/docs/User-Manuals/Operations/webui-0","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#overview---cluster-overview","content":"Overview - Cluster Overview","locale":"en"},"2790":{"id":"/docs/User-Manuals/Operations/webui-1","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#cluster-status-information","content":"Cluster Status Information","locale":"en"},"2791":{"id":"/docs/User-Manuals/Operations/webui-2","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#worker-node-status","content":"Worker Node Status","locale":"en"},"2792":{"id":"/docs/User-Manuals/Operations/webui-3","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#storage-capacity-statistics","content":"Storage Capacity Statistics","locale":"en"},"2793":{"id":"/docs/User-Manuals/Operations/webui-4","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#file-system-statistics","content":"File System Statistics","locale":"en"},"2794":{"id":"/docs/User-Manuals/Operations/webui-5","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#browse---file-system-browser","content":"Browse - File System Browser","locale":"en"},"2795":{"id":"/docs/User-Manuals/Operations/webui-6","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#file-system-navigation","content":"File System Navigation","locale":"en"},"2796":{"id":"/docs/User-Manuals/Operations/webui-7","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#file-and-directory-management","content":"File and Directory Management","locale":"en"},"2797":{"id":"/docs/User-Manuals/Operations/webui-8","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#storage-statistics","content":"Storage Statistics","locale":"en"},"2798":{"id":"/docs/User-Manuals/Operations/webui-9","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#empty-directory-notification","content":"Empty Directory Notification","locale":"en"},"2799":{"id":"/docs/User-Manuals/Operations/webui-10","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#workers---worker-node-management","content":"Workers - Worker Node Management","locale":"en"},"2800":{"id":"/docs/User-Manuals/Operations/webui-11","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#real-time-node-status","content":"Real-time Node Status","locale":"en"},"2801":{"id":"/docs/User-Manuals/Operations/webui-12","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#active-worker-node-list","content":"Active Worker Node List","locale":"en"},"2802":{"id":"/docs/User-Manuals/Operations/webui-13","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/do