y/kubernetes-quick-start","content":"| Chart                 | Release       | Namespace        | Purpose                                           |\n| --------------------- | ------------- | ---------------- | ------------------------------------------------- |\n| `curvine/curvine-csi` | `curvine-csi` | `curvine-system` | CSI driver that mounts Curvine into pods via FUSE |","locale":"en","table":"table-0"},"1872":{"id":"/docs/Deploy/kubernetes-quick-start-12","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start","content":"For production clusters and the full list of chart values, see Kubernetes Deployment and K8S CSI Driver.","locale":"en"},"1873":{"id":"/docs/Deploy/kubernetes-quick-start-13","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#prerequisites","content":"Docker, with at least 2 CPUs and 2 GB of memory available to it","locale":"en"},"1874":{"id":"/docs/Deploy/kubernetes-quick-start-14","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#prerequisites","content":"kind 0.20 or later","locale":"en"},"1875":{"id":"/docs/Deploy/kubernetes-quick-start-15","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#prerequisites","content":"`kubectl`","locale":"en"},"1876":{"id":"/docs/Deploy/kubernetes-quick-start-16","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#prerequisites","content":"Helm 3","locale":"en"},"1877":{"id":"/docs/Deploy/kubernetes-quick-start-17","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#prerequisites","content":"This guide was tested with kind v0.27.0 (Kubernetes v1.32.2) and minikube v1.25.1 (Kubernetes v1.23.1), chart version `0.5.2-alpha`.","locale":"en"},"1878":{"id":"/docs/Deploy/kubernetes-quick-start-18","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"Save the cluster config:","locale":"en"},"1879":{"id":"/docs/Deploy/kubernetes-quick-start-19","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"Create the cluster:","locale":"en"},"1880":{"id":"/docs/Deploy/kubernetes-quick-start-20","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"The CSI node plugin mounts volumes with FUSE, so the kind node needs `/dev/fuse`. kind nodes run as privileged containers and see the host's devices, so no extra mount is required. Check that the device is there:","locale":"en"},"1881":{"id":"/docs/Deploy/kubernetes-quick-start-21","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"If `/dev/fuse` is missing on a Linux host, load the kernel module with `sudo modprobe fuse` and recreate the cluster. Docker Desktop on macOS already provides the device.","locale":"en"},"1882":{"id":"/docs/Deploy/kubernetes-quick-start-22","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"kind installs a default StorageClass named `standard` (local-path provisioner). The runtime chart below uses it for master metadata, the Raft journal, and worker data:","locale":"en"},"1883":{"id":"/docs/Deploy/kubernetes-quick-start-23","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Save a values file sized for a laptop. It runs one master and one worker, uses the `standard` StorageClass, and lowers the default resource requests:","locale":"en"},"1884":{"id":"/docs/Deploy/kubernetes-quick-start-24","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"The worker `size` also sets the capacity Curvine reports for that data directory (`2Gi` becomes `[SSD:2GB]/data/data1`).","locale":"en"},"1885":{"id":"/docs/Deploy/kubernetes-quick-start-25","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Add the Helm repository and install the chart:","locale":"en"},"1886":{"id":"/docs/Deploy/kubernetes-quick-start-26","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"`0.5.2-alpha` is a pre-release, so Helm does not pick it unless you pass `--version` (or `--devel`). Run `helm search repo curvine --devel --versions` to list the published versions.","locale":"en"},"1887":{"id":"/docs/Deploy/kubernetes-quick-start-27","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Check that the master and worker are running and their PVCs are bound:","locale":"en"},"1888":{"id":"/docs/Deploy/kubernetes-quick-start-28","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"The worker should have registered with the master:","locale":"en"},"1889":{"id":"/docs/Deploy/kubernetes-quick-start-29","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#3-install-the-csi-driver","content":"Save the CSI values. They lower the node plugin's memory request and avoid pulling the image again on eve