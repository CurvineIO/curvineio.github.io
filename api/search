/Architecture/fluid-integration#fuse-mount-is-missing","content":"`/dev/fuse` exists in the pod.","locale":"en"},"145":{"id":"/docs/Architecture/fluid-integration-143","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#fuse-mount-is-missing","content":"the container is privileged when required by your cluster.","locale":"en"},"146":{"id":"/docs/Architecture/fluid-integration-144","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#fuse-mount-is-missing","content":"the Fluid target path and Dataset mount path are correct.","locale":"en"},"147":{"id":"/docs/Architecture/fluid-integration-145","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"Check the DataLoad pod logs:","locale":"en"},"148":{"id":"/docs/Architecture/fluid-integration-146","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"Common causes:","locale":"en"},"149":{"id":"/docs/Architecture/fluid-integration-147","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"`dataOperationSpecs` is missing from the `CacheRuntimeClass`.","locale":"en"},"150":{"id":"/docs/Architecture/fluid-integration-148","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"`FLUID_DATALOAD_DATA_PATH` is empty or points to a path that Curvine did not mount.","locale":"en"},"151":{"id":"/docs/Architecture/fluid-integration-149","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"the DataLoad command uses the wrong Curvine config or master address.","locale":"en"},"152":{"id":"/docs/Architecture/fluid-integration-150","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"an older or custom Fluid template sets `FLUID_RUNTIME_CONFIG_PATH`, but does not mount the runtime config file.","locale":"en"},"153":{"id":"/docs/Architecture/fluid-integration-151","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#dataload-job-starts-but-fails","content":"Fix the command in `dataOperationSpecs`, reapply the `CacheRuntimeClass`, and create a new `DataLoad` resource.","locale":"en"},"154":{"id":"/docs/Architecture","page_id":"/docs/Architecture","type":"page","content":"Architecture","breadcrumbs":["Documents","Architecture"],"tags":[],"url":"/docs/Architecture","locale":"en"},"155":{"id":"/docs/Architecture-0","page_id":"/docs/Architecture","tags":[],"type":"text","url":"/docs/Architecture","content":"Curvine design doc","locale":"en"},"156":{"id":"/docs/Architecture/introduction","page_id":"/docs/Architecture/introduction","type":"page","content":"Basic Architecture","breadcrumbs":["Documents","Architecture"],"tags":[],"url":"/docs/Architecture/introduction","locale":"en"},"157":{"id":"/docs/Architecture/introduction-0","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#overview","content":"Overview","locale":"en"},"158":{"id":"/docs/Architecture/introduction-1","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#master","content":"Master","locale":"en"},"159":{"id":"/docs/Architecture/introduction-2","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#leader-active-master","content":"Leader (Active Master)","locale":"en"},"160":{"id":"/docs/Architecture/introduction-3","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#standby-master-follower","content":"Standby Master (Follower)","locale":"en"},"161":{"id":"/docs/Architecture/introduction-4","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#raft","content":"Raft","locale":"en"},"162":{"id":"/docs/Architecture/introduction-5","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#workers","content":"Workers","locale":"en"},"163":{"id":"/docs/Architecture/introduction-6","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#registration-and-heartbeat","content":"Registration and heartbeat","locale":"en"},"164":{"id":"/docs/Architecture/introduction-7","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#block-storage","content":"Block storage","locale":"en"},"165":{"id":"/docs/Architecture/introduction-8","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#replication-optional","content":"Replication (optional)","locale":"en"},"166":{"id":"/docs/Architecture/introduction-9","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#client","content":"Client","locale":"en"},"167":{"id":"/docs/Architecture/introduction-10","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#read-path","content":"Read path","locale":"en"},"168":{"id":"/docs/Architecture/introduction-11","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#write-path","content":"Write path","locale":"en"},"169":{"id":"/docs/Architecture/introduction-12","page_id":"/docs/Architecture/introduction","type":"heading","tags":[],"url":"/docs/Architecture/introduction#summary","content":"Summary","locale":"en"},"170":{"id":"/docs/Architecture/introduction-13","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction","content":"This document describes the core components and data flow of Curvine as implemented in the codebase: **Master** (metadata and Raft), **Worker** (block storage), and **Client** (read/write paths).","locale":"en"},"171":{"id":"/docs/Architecture/introduction-14","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#overview","content":"Curvine is a distributed file cache layer. The **Master** manages metadata and block placement; **Workers** store block data and serve read/write; **Clients** (FUSE, SDK, CLI) talk to Master for metadata and to Workers for data. Metadata is replicated via **Raft** for high availability.","locale":"en"},"172":{"id":"/docs/Architecture/introduction-15","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#master","content":"The Master is the control plane: it holds the file system metadata (directory tree, file inodes, block locations), manages Worker registration, and allocates blocks for writes. For high availability, multiple Master nodes form a **Raft group**; only the **leader** serves metadata write RPC; **followers** replay the journal to keep state in sync.","locale":"en"},"173":{"id":"/docs/Architecture/introduction-16","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#leader-active-master","content":"**Role**: The Raft leader is the only node that accepts metadata-mutating RPC (create file, add block, rename, delete, mount/umount, etc.).","locale":"en"},"174":{"id":"/docs/Architecture/introduction-17","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#leader-active-master","content":"**Journal**: Every metadata change is persisted as a **journal entry** (e.g. `Mkdir`, `CreateFile`, `AddBlock`, `CompleteFile`, `Rename`, `Delete`, `Mount`, `UnMount`). The leader appends entries to the Raft log; once committed, they are applied to the in-memory metadata tree (`FsDir`).","locale":"en"},"175":{"id":"/docs/Architecture/introduction-18","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#leader-active-master","content":"**Components**: `MasterHandler` serves RPC; `MasterFilesystem` and `FsDir` hold the directory/file and block mapping; `JournalWriter` writes entries; `WorkerManager` tracks Workers and block placement; `MountManager` manages UFS mount points.","locale":"en"},"176":{"id":"/docs/Architecture/introduction-19","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#standby-master-follower","content":"**Role**: Raft followers do **not** serve metadata write RPC. They receive committed log entries from the leader and **replay** them to keep a copy of the metadata.","locale":"en"},"177":{"id":"/docs/Architecture/introduction-20","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#standby-master-follower","content":"**Replay**: `JournalLoader` applies each committed `JournalEntry` to the local `FsDir` (e.g. `mkdir`, `create_file`, `add_block`, `complete_file`, `rename`, `delete`, `mount`, `unmount`). This keeps standby state identical to the leader.","locale":"en"},"178":{"id":"/docs/Architecture/introduction-21","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#standby-master-follower","content":"**Snapshot**: The system supports Raft snapshots; when a snapshot exists, the metadata can be restored from it instead of replaying from the beginning.","locale":"en"},"179":{"id":"/docs/Architecture/introduction-22","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#raft","content":"**Storage**: Metadata log and Raft state use **RocksDB** (`RocksLogStorage`). The journal is the application payload carried in Raft log entries.","locale":"en"},"180":{"id":"/docs/Architecture/introduction-23","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#raft","content":"**Role detection**: `MasterMonitor` exposes whether the current node is active: `is_active()` is true only when the Raft role is **Leader**. The client or upper layer should route metadata write requests to the current leader (e.g. by resolving the leader from the cluster config or a router).","locale":"en"},"181":{"id":"/docs/Architecture/introduction-24","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#raft","content":"**Failover**: When the leader dies, Raft elects a new leader; the new leader continues applying the journal and serving metadata. Standby nodes that catch up via log replay or snapshot become eligible for leadership.","locale":"en"},"182":{"id":"/docs/Architecture/introduction-25","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#workers","content":"Workers store **block data** and serve block read/write RPC. They do not hold file system metadata; they only manage blocks identified by block ID.","locale":"en"},"183":{"id":"/docs/Architecture/introduction-26","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#registration-and-heartbeat","content":"Workers **register** with the Master and send periodic **heartbeats** with storage information (`HeartbeatStatus`: Start, Running, End). The Master’s `WorkerManager` maintains a `WorkerMap` and `BlockMap` (which blocks are on which worker).","locale":"en"},"184":{"id":"/docs/Architecture/introduction-27","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#registration-and-heartbeat","content":"The Master uses this information to **allocate blocks** for new writes (e.g. via worker selection policies: random, round-robin, load-based, local) and to return block locations for reads.","locale":"en"},"185":{"id":"/docs/Architecture/introduction-28","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#block-storage","content":"Each Worker runs a **BlockStore** backed by a **BlockDataset**: blocks are stored on local storage (memory, SSD, HDD) according to cluster and storage policy.","locale":"en"},"186":{"id":"/docs/Architecture/introduction-29","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#block-storage","content":"**Read path**: The Worker’s `ReadHandler` receives block-read RPCs, opens the block file, and returns data (with optional read-ahead and sendfile-style optimizations).","locale":"en"},"187":{"id":"/docs/Architecture/introduction-30","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#block-storage","content":"**Write path**: The Worker’s write handlers accept block write RPCs, write data to the block store, and finalize or abort blocks as requested by the client/Master.","locale":"en"},"188":{"id":"/docs/Architecture/introduction-31","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#replication-optional","content":"The Master can run a **block replication** flow (`MasterReplicationManager`): when multiple replicas are required, the Master coordinates copying block data from one Worker to others. Replication is configurable (e.g. concurrency limit, on/off).","locale":"en"},"189":{"id":"/docs/Architecture/introduction-32","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#client","content":"The client is any component that uses the Curvine file system: **FUSE**, **Rust/Java/Python SDK**, or **CLI** (`cv`). It always talks to the **Master** for metadata and to **Workers** for block data.","locale":"en"},"190":{"id":"/docs/Architecture/introduction-33","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#read-path","content":"**Metadata**: The client asks the Master for file metadata and **block locations** (which Worker(s) hold which block IDs, offsets, lengths). The Master returns `FileBlocks` (file status + list of block locations).","locale":"en"},"191":{"id":"/docs/Architecture/introduction-34","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#read-path","content":"**Data**: The client reads block data from the corresponding Worker(s) via block-read RPC. It may use **parallel reads** and **read-ahead** (configurable chunk size, slice size, read-ahead length).","locale":"en"},"192":{"id":"/docs/Architecture/introduction-35","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#read-path","content":"**Cache hit**: If the path is under a Curvine-native file (not a UFS mount), data is read from Workers as above. For paths under a **UFS mount**, the unified file system and cache behavior apply: the client may serve from Curvine cache when valid, or from UFS on cache miss (with optional automatic caching when TTL is set).","locale":"en"},"193":{"id":"/docs/Architecture/introduction-36","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"Write behavior depends on the **mount write type** (for UFS mounts) or the native Curvine path:","locale":"en"},"194":{"id":"/docs/Architecture/introduction-37","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**Allocate blocks**: The client requests new blocks from the Master. The Master chooses Worker(s) (and replicas if needed), records block allocations in the journal (e.g. `AddBlock`, `CompleteFile`), and returns block locations to the client.","locale":"en"},"195":{"id":"/docs/Architecture/introduction-38","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**Write data**: The client sends block data to the assigned Worker(s) via block-write RPC. The Worker persists data to its BlockStore.","locale":"en"},"196":{"id":"/docs/Architecture/introduction-39","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**Write types** (for UFS-mounted paths, see Data Orchestration — Mount Modes):","locale":"en"},"197":{"id":"/docs/Architecture/introduction-40","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**Cache**: Data is written only to Curvine (Workers); not written to UFS.","locale":"en"},"198":{"id":"/docs/Architecture/introduction-41","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**Through**: Data is written only to UFS; cache is bypassed.","locale":"en"},"199":{"id":"/docs/Architecture/introduction-42","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**AsyncThrough** (default): Data is written to Curvine first (return immediately), then asynchronously synced to UFS.","locale":"en"},"200":{"id":"/docs/Architecture/introduction-43","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"**CacheThrough**: Data is written synchronously to both Curvine and UFS before returning.","locale":"en"},"201":{"id":"/docs/Architecture/introduction-44","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#write-path","content":"For native Curvine paths (non-UFS), writes go to Workers and are recorded in the Master journal; replication is handled by the Master/Worker replication logic when configured.","locale":"en"},"202":{"id":"/docs/Architecture/introduction-45","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"| Component           | Responsibility                                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------------------------- |\n| **Master (leader)** | Metadata (FsDir), journal write, block allocation, Worker map, mount table; serves all metadata RPC. |","locale":"en","table":"table-0"},"203":{"id":"/docs/Architecture/introduction-46","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"| Component             | Responsibility                                                                    |\n| --------------------- | --------------------------------------------------------------------------------- |\n| **Master (follower)** | Replay Raft journal (JournalLoader) to keep FsDir in sync; no metadata write RPC. |","locale":"en","table":"table-0"},"204":{"id":"/docs/Architecture/introduction-47","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"| Component | Responsibility                                                                |\n| --------- | ----------------------------------------------------------------------------- |\n| **Raft**  | Replicate journal entries; leader election and failover; RocksDB log storage. |","locale":"en","table":"table-0"},"205":{"id":"/docs/Architecture/introduction-48","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"| Component  | Responsibility                                                                      |\n| ---------- | ----------------------------------------------------------------------------------- |\n| **Worker** | Block storage (BlockStore/BlockDataset), block read/write RPC, heartbeat to Master. |","locale":"en","table":"table-0"},"206":{"id":"/docs/Architecture/introduction-49","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"| Component  | Responsibility                                                                                                                                        |\n| ---------- | ----------------------------------------------------------------------------------------------------------------------------------------------------- |\n| **Client** | Get metadata and block locations from Master; read/write block data from/to Workers; for UFS mounts, apply write type and cache/consistency behavior. |","locale":"en","table":"table-0"},"207":{"id":"/docs/Architecture/introduction-50","page_id":"/docs/Architecture/introduction","tags":[],"type":"text","url":"/docs/Architecture/introduction#summary","content":"For deployment topology and startup order, see Deployment Architecture. For UFS and cache semantics, see Data Orchestration and Cache.","locale":"en"},"208":{"id":"/docs/Architecture/metadata-architecture","page_id":"/docs/Architecture/metadata-architecture","type":"page","content":"Curvine Metadata Architecture","breadcrumbs":["Documents","Architecture"],"tags":[],"url":"/docs/Architecture/metadata-architecture","locale":"en"},"209":{"id":"/docs/Architecture/metadata-architecture-0","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"1. Design Goals and Selection","locale":"en"},"210":{"id":"/docs/Architecture/metadata-architecture-1","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#3-raft-protocol-the-core-mechanism-for-ensuring-multi-node-data-consistency","content":"3. Raft Protocol: The Core Mechanism for Ensuring Multi-Node Data Consistency","locale":"en"},"211":{"id":"/docs/Architecture/metadata-architecture-2","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#4-leader-first-write-a-balance-between-speed-and-consistency","content":"4. Leader-First Write: A Balance Between Speed and Consistency","locale":"en"},"212":{"id":"/docs/Architecture/metadata-architecture-3","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#5-log-batch-processing-optimization-further-improving-high-concurrency-throughput","content":"5. Log Batch Processing Optimization: Further Improving High-Concurrency Throughput","locale":"en"},"213":{"id":"/docs/Architecture/metadata-architecture-4","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"6. Selection Trade-Offs: Why Not Use External Databases Such as TiDB or Redis","locale":"en"},"214":{"id":"/docs/Architecture/metadata-architecture-5","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"7. fs-mode Mode: Cooperating with UFS to Ensure Data Fallback Safety","locale":"en"},"215":{"id":"/docs/Architecture/metadata-architecture-6","page_id":"/docs/Architecture/metadata-architecture","type":"heading","tags":[],"url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"8. Architecture Summary","locale":"en"},"216":{"id":"/docs/Architecture/metadata-architecture-7","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture","content":"Metadata is the core component of a distributed file system. It is equivalent to the system's \"navigation hub\" and is mainly responsible for managing key information such as the namespace of files and directories, storage locations, size and permissions, and modification time. Its read/write speed, storage capacity, and data consistency directly determine the operating performance, stability, and availability of the entire distributed file system. Based on best practices in distributed storage and after comparing and validating multiple solutions, Curvine finally adopts the core combination of the Raft protocol and the RocksDB database to manage metadata. This combination meets low-latency requirements in high-concurrency scenarios, supports massive metadata storage, and ensures multi-node data consistency. The following is a simplified and complete core explanation.","locale":"en"},"217":{"id":"/docs/Architecture/metadata-architecture-8","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"The core design goals of the Curvine metadata architecture are clear and focused, mainly around four core requirements. First, it supports metadata storage for tens of millions to tens of billions of files and directories, adapting to mixed storage scenarios with massive small files and large files. Second, it ensures low latency in high-concurrency read/write scenarios, handling frequent high-frequency operations such as file creation, deletion, and modification. Third, it implements data consistency across multiple nodes in a distributed cluster, avoiding the problem that \"local changes are invisible to other nodes\". Fourth, it balances operational convenience and controllable costs, reducing the complexity of deployment, monitoring, and fault recovery.","locale":"en"},"218":{"id":"/docs/Architecture/metadata-architecture-9","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"During technology selection, the technical team compared multiple mainstream solutions such as HDFS NameNode, TiDB, Redis, and an independent Raft cluster, and finally determined the combined architecture of Raft and RocksDB. There are three core considerations. First, both have been validated in large-scale production scenarios, with high engineering maturity and guaranteed stability, and are widely used in various distributed storage systems. Second, RocksDB is based on the LSM-Tree architecture and has the advantages of high-concurrency writes, high compression ratio, and massive storage, making it very suitable for storing metadata, which consists of high-frequency read/write and massive small-entry data. Third, the Raft protocol can efficiently solve the consistency problem of distributed clusters, using a simple and clear mechanism to implement multi-node data synchronization, avoid single points of failure, and balance consistency and performance.","locale":"en"},"219":{"id":"/docs/Architecture/metadata-architecture-10","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"To balance speed, storage, and consistency, the architecture adopts a three-layer division of responsibilities. Each layer performs its own role and collaborates with the others. The specific responsibilities are as follows:","locale":"en"},"220":{"id":"/docs/Architecture/metadata-architecture-11","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"| Layer                    | Core Responsibility                                                                                                                                                                                                           | Design Motivation                                                                                                                                                                                                                                                                                                                         |\n| ------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| In-memory directory tree | Specifically handles high-frequency operations such as path resolution, directory listing, and folder association. It only stores core directory structure information, such as folder names and parent-folder relationships. | Memory read/write speed is far faster than disk. Placing the core information for high-frequency operations in memory can keep directory query and path matching latency at the microsecond level. At the same time, only maintaining a lightweight directory structure greatly reduces memory usage and avoids wasting memory resources. |","locale":"en","table":"table-0"},"221":{"id":"/docs/Architecture/metadata-architecture-12","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"| Layer                           | Core Responsibility                                                                                                                                                                                              | Design Motivation                                                                                                                                                                                                                                                                                                                                   |\n| ------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Metadata RocksDB (Inode engine) | Persistently stores the complete detailed information of all files and directories, including file size, permissions, modification time, data block locations, and complete directory association relationships. | It undertakes the persistent storage requirements of massive metadata. Through column families, different types of metadata are classified and stored, such as separating file attributes and directory relationships, improving read/write efficiency and management convenience while adapting to high-frequency metadata modification scenarios. |","locale":"en","table":"table-0"},"222":{"id":"/docs/Architecture/metadata-architecture-13","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"| Layer            | Core Responsibility                                                                                                                                                                            | Design Motivation                                                                                                                                                                                                                             |\n| ---------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Raft log RocksDB | Specifically stores logs for all metadata modification operations, such as creation, deletion, and modification. Logs are recorded in operation order and used for multi-node synchronization. | It is completely isolated from business metadata storage, avoiding mutual impact between log storage and business reads/writes. It also facilitates log synchronization, compression, cleanup, and fault recovery, reducing performance loss. |","locale":"en","table":"table-0"},"223":{"id":"/docs/Architecture/metadata-architecture-14","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"The in-memory directory tree and RocksDB do not operate independently. Instead, they form a collaborative model in which memory handles speed and disk handles storage. This ensures the speed of high-frequency operations while enabling massive data storage. The core collaboration logic is as follows:","locale":"en"},"224":{"id":"/docs/Architecture/metadata-architecture-15","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"**In-memory directory tree**: focuses on the ultimate speed of high-frequency operations. It only stores the most core directory structure information, such as folder names, parent folder IDs, and child node lists, and does not store detailed file attributes such as size and modification time. This design keeps memory usage extremely low and allows high-frequency operations such as directory listing and path lookup to be completed directly in memory with very fast response.","locale":"en"},"225":{"id":"/docs/Architecture/metadata-architecture-16","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"**RocksDB**: focuses on reliable storage of massive data and carries the complete detailed information of all files and directories, including file size, permissions, modification time, and the location of data blocks on disk. By classifying and managing different types of metadata through column families, data organization becomes clearer. At the same time, RocksDB's high-concurrency read/write characteristics ensure the read/write efficiency of massive metadata.","locale":"en"},"226":{"id":"/docs/Architecture/metadata-architecture-17","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#1-design-goals-and-selection","content":"**Collaboration logic**: adopts an on-demand loading and divided-response approach. For example, when a user lists the contents of a directory, the in-memory directory tree first quickly returns the names of all files and folders in the directory to ensure response speed. When the user needs to view detailed information about a file, such as size and modification time, the system then performs a batch query in RocksDB for the corresponding detailed information and returns it all at once. This ensures speed without wasting memory resources.","locale":"en"},"227":{"id":"/docs/Architecture/metadata-architecture-18","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#3-raft-protocol-the-core-mechanism-for-ensuring-multi-node-data-consistency","content":"The core pain point of a distributed cluster is data inconsistency. For example, a file created on one machine may not be visible on another machine, affecting normal business operations. As the consistency hub of the Curvine distributed cluster, the Raft protocol is designed specifically to solve this problem. Its core mechanism is simple and efficient:","locale":"en"},"228":{"id":"/docs/Architecture/metadata-architecture-19","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#3-raft-protocol-the-core-mechanism-for-ensuring-multi-node-data-consistency","content":"**Log synchronization first**: any metadata modification operation, such as creation, deletion, rename, or attribute modification, is first packaged as an operation log and stored in a dedicated log database, then synchronized to more than half of the machines in the cluster. Only after most machines successfully receive and store this log is the modification operation officially effective, ensuring that data will not be lost due to a single machine failure.","locale":"en"},"229":{"id":"/docs/Architecture/metadata-architecture-20","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#3-raft-protocol-the-core-mechanism-for-ensuring-multi-node-data-consistency","content":"**Log replay ensures consistency**: the Leader node in the cluster is responsible for initiating modification operations and recording logs. Follower nodes synchronize the Leader's logs in real time and execute the same modification operations one by one in log order, ensuring that the metadata state of all nodes is completely consistent and avoiding data divergence.","locale":"en"},"230":{"id":"/docs/Architecture/metadata-architecture-21","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#3-raft-protocol-the-core-mechanism-for-ensuring-multi-node-data-consistency","content":"**Snapshots accelerate recovery**: if a machine falls too far behind the Leader due to failure or network disconnection, it does not need to replay all historical logs one by one. The Leader directly sends a complete snapshot of the current data. After loading the snapshot, the machine can quickly catch up with the cluster progress, greatly shortening fault recovery time and improving system availability.","locale":"en"},"231":{"id":"/docs/Architecture/metadata-architecture-22","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#4-leader-first-write-a-balance-between-speed-and-consistency","content":"To adapt to high-concurrency and low-latency business scenarios, Curvine reasonably optimizes the execution process of the traditional Raft protocol and adopts a Leader-first write strategy, which differs from the traditional mode of synchronizing logs first and then modifying local data:","locale":"en"},"232":{"id":"/docs/Architecture/metadata-architecture-23","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#4-leader-first-write-a-balance-between-speed-and-consistency","content":"**Core process**: the Leader node first updates its own in-memory directory tree, then writes to the local RocksDB to complete the local data modification, and then synchronizes the log of this modification to other Follower nodes in the cluster to complete consistency synchronization.","locale":"en"},"233":{"id":"/docs/Architecture/metadata-architecture-24","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#4-leader-first-write-a-balance-between-speed-and-consistency","content":"**Core advantage**: write speed is greatly improved. There is no need to wait for the log to be synchronized to most machines before completing the local modification. Local write latency can be reduced to a few milliseconds. In high-concurrency scenarios, such as creating a large number of small files, throughput can increase several times, perfectly adapting to high-frequency small-operation scenarios.","locale":"en"},"234":{"id":"/docs/Architecture/metadata-architecture-25","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#4-leader-first-write-a-balance-between-speed-and-consistency","content":"**Small cost**: an extremely short consistency window. If the Leader node fails just after completing the local modification but before synchronizing the log, these unsynchronized modifications may not be synchronized to other nodes. However, this window is extremely short, usually only a few milliseconds, and the probability of occurrence in actual production is extremely low. It is an acceptable trade-off between performance and consistency.","locale":"en"},"235":{"id":"/docs/Architecture/metadata-architecture-26","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#5-log-batch-processing-optimization-further-improving-high-concurrency-throughput","content":"For high-frequency small-operation scenarios such as creating and modifying a large number of small files, Curvine introduces a log batch processing mechanism to further improve write throughput and avoid performance loss caused by frequent log synchronization:","locale":"en"},"236":{"id":"/docs/Architecture/metadata-architecture-27","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#5-log-batch-processing-optimization-further-improving-high-concurrency-throughput","content":"The core logic is to accumulate a batch and then synchronize. The system merges metadata modification operations within a short time window, usually 1 to 10 milliseconds, or a certain number of operations, such as 100, into one batch log and then synchronizes it to other nodes in the cluster. The core benefit is reducing the number of log synchronizations and lowering the overhead of network transmission and disk writes. In high-concurrency scenarios, throughput can increase several times.","locale":"en"},"237":{"id":"/docs/Architecture/metadata-architecture-28","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#5-log-batch-processing-optimization-further-improving-high-concurrency-throughput","content":"At the same time, batch processing parameters can be flexibly adjusted. The batch processing time window, such as 1 millisecond or 5 milliseconds, and the batch size, such as 50 or 100 entries, can be set according to business requirements to find the optimal balance between write latency and throughput. The shorter the window, the lower the latency. The larger the batch, the higher the throughput. In addition, because the Raft log already guarantees data consistency, RocksDB's own WAL log is disabled, further improving write speed.","locale":"en"},"238":{"id":"/docs/Architecture/metadata-architecture-29","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"When selecting a metadata storage solution, the technical team also focused on mature external databases such as TiDB and Redis. However, it finally chose the self-developed architecture of in-memory directory tree, RocksDB, and built-in Raft. The core reason is that external databases cannot adapt to Curvine's high-concurrency and low-latency core requirements. The specific trade-offs are as follows:","locale":"en"},"239":{"id":"/docs/Architecture/metadata-architecture-30","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"**Excessive latency**: external databases require network communication to complete reads and writes. Each metadata operation has to go through an additional network round trip, and tail latency increases significantly. This is far slower than local operations using memory and local RocksDB and cannot meet the low-latency requirements of high-frequency small operations.","locale":"en"},"240":{"id":"/docs/Architecture/metadata-architecture-31","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"**Prone to performance bottlenecks**: metadata operations are mostly high-frequency small requests. When massive clients connect to an external database at the same time, it is easy to exhaust database connections, causing QPS to hit a ceiling and making it unable to support high-concurrency scenarios.","locale":"en"},"241":{"id":"/docs/Architecture/metadata-architecture-32","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"**High and cumbersome O&M cost**: introducing an external database adds dependent components to the cluster. This database needs to be deployed, monitored, and maintained separately, and fault recovery becomes more complex. At the same time, as the amount of metadata grows, the cost of an externally hosted database increases significantly, which does not meet the goal of controllable cost.","locale":"en"},"242":{"id":"/docs/Architecture/metadata-architecture-33","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#6-selection-trade-offs-why-not-use-external-databases-such-as-tidb-or-redis","content":"**Limited optimization space**: external databases are general-purpose designs and cannot be customized for characteristics such as high-frequency directory operations and batch reads/writes of metadata. A self-developed architecture can deeply optimize core processes such as path resolution and on-demand loading, making it better suited to business requirements.","locale":"en"},"243":{"id":"/docs/Architecture/metadata-architecture-34","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"Curvine supports fs-mode. Its core function is to synchronize metadata and file data to the underlying unified file system, UFS, forming a dual guarantee of local storage plus disk fallback. This avoids data loss without affecting system performance:","locale":"en"},"244":{"id":"/docs/Architecture/metadata-architecture-35","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"**Metadata mirror synchronization**: all metadata modifications in Curvine, such as creation, deletion, and attribute modification, are asynchronously synchronized to UFS in the background after being completed locally. This ensures that the directory structure and file attributes of Curvine and UFS are completely consistent, implementing a unified namespace.","locale":"en"},"245":{"id":"/docs/Architecture/metadata-architecture-36","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"**Asynchronous data copy**: the actual data blocks of files are asynchronously copied from Curvine to UFS in the background. The copy process does not affect local metadata read/write operations and avoids slowing down write speed. If UFS is temporarily unavailable, the copy task automatically retries until synchronization succeeds.","locale":"en"},"246":{"id":"/docs/Architecture/metadata-architecture-37","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"**Idempotent retry guarantee**: synchronization operations adopt an idempotent design. Repeated execution of the same modification operation will not change the result, avoiding exceptions such as duplicate file creation or duplicate deletion and ensuring the reliability of the synchronization process.","locale":"en"},"247":{"id":"/docs/Architecture/metadata-architecture-38","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#7-fs-mode-mode-cooperating-with-ufs-to-ensure-data-fallback-safety","content":"**Progress tracking and fast recovery**: the system separately records the latest Curvine local modification progress and UFS synchronization progress. If UFS falls too far behind due to failure or network disconnection, after recovery it does not need to resynchronize all data. It only needs to continue synchronization from the last interrupted progress, greatly improving recovery efficiency.","locale":"en"},"248":{"id":"/docs/Architecture/metadata-architecture-39","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"The core logic of Curvine's metadata architecture can be summarized as three layers of division of responsibilities, one trade-off, and one fallback. It ensures speed and massive storage while also considering data consistency and operational convenience:","locale":"en"},"249":{"id":"/docs/Architecture/metadata-architecture-40","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"**Three-layer division of responsibilities**: the in-memory directory tree handles speed, with high-frequency operations responding instantly; RocksDB handles storage, reliably carrying massive metadata; the Raft protocol handles consistency, keeping multi-node data free of divergence. The three work together to achieve fast, stable, efficient, and complete behavior.","locale":"en"},"250":{"id":"/docs/Architecture/metadata-architecture-41","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"**One trade-off**: the Leader-first write strategy uses an extremely short consistency window in exchange for low latency and high throughput in high-concurrency scenarios, adapting to the core scenario of massive small-file reads and writes.","locale":"en"},"251":{"id":"/docs/Architecture/metadata-architecture-42","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"**One fallback**: through fs-mode cooperation with UFS, metadata and file data have dual backups, ensuring data safety while supporting fast fault recovery.","locale":"en"},"252":{"id":"/docs/Architecture/metadata-architecture-43","page_id":"/docs/Architecture/metadata-architecture","tags":[],"type":"text","url":"/docs/Architecture/metadata-architecture#8-architecture-summary","content":"**Selection advantage**: by giving up external databases and adopting a local architecture, Curvine reduces latency and O&M costs while retaining room for customized optimization, perfectly matching the core requirements of a distributed file system.","locale":"en"},"253":{"id":"/docs/Architecture/opendal-integration","page_id":"/docs/Architecture/opendal-integration","type":"page","content":"OpenDAL Ecosystem Integration","breadcrumbs":["Documents","Architecture"],"tags":[],"url":"/docs/Architecture/opendal-integration","locale":"en"},"254":{"id":"/docs/Architecture/opendal-integration-0","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#overview","content":"Overview","locale":"en"},"255":{"id":"/docs/Architecture/opendal-integration-1","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"What is OpenDAL?","locale":"en"},"256":{"id":"/docs/Architecture/opendal-integration-2","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#supported-storage-backends","content":"Supported Storage Backends","locale":"en"},"257":{"id":"/docs/Architecture/opendal-integration-3","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#object-storage","content":"Object Storage","locale":"en"},"258":{"id":"/docs/Architecture/opendal-integration-4","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#distributed-file-systems","content":"Distributed File Systems","locale":"en"},"259":{"id":"/docs/Architecture/opendal-integration-5","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#core-features","content":"Core Features","locale":"en"},"260":{"id":"/docs/Architecture/opendal-integration-6","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#mount-feature---mounting-external-storage","content":"Mount Feature - Mounting External Storage","locale":"en"},"261":{"id":"/docs/Architecture/opendal-integration-7","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#s3-storage-mount-examples","content":"S3 Storage Mount Examples","locale":"en"},"262":{"id":"/docs/Architecture/opendal-integration-8","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#other-storage-type-mounts","content":"Other Storage Type Mounts","locale":"en"},"263":{"id":"/docs/Architecture/opendal-integration-9","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#load-feature---loading-external-data","content":"Load Feature - Loading External Data","locale":"en"},"264":{"id":"/docs/Architecture/opendal-integration-10","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#configuration-parameters","content":"Configuration Parameters","locale":"en"},"265":{"id":"/docs/Architecture/opendal-integration-11","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#s3-compatible-storage-configuration","content":"S3-Compatible Storage Configuration","locale":"en"},"266":{"id":"/docs/Architecture/opendal-integration-12","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#oss-configuration","content":"OSS Configuration","locale":"en"},"267":{"id":"/docs/Architecture/opendal-integration-13","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#hdfs-configuration","content":"HDFS Configuration","locale":"en"},"268":{"id":"/docs/Architecture/opendal-integration-14","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#hdfs-environment-requirements","content":"HDFS Environment Requirements","locale":"en"},"269":{"id":"/docs/Architecture/opendal-integration-15","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#compilation-requirements","content":"Compilation Requirements","locale":"en"},"270":{"id":"/docs/Architecture/opendal-integration-16","page_id":"/docs/Architecture/opendal-integration","type":"heading","tags":[],"url":"/docs/Architecture/opendal-integration#runtime-environment-requirements","content":"Runtime Environment Requirements","locale":"en"},"271":{"id":"/docs/Architecture/opendal-integration-17","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#overview","content":"Curvine integrates with OpenDAL (Open Data Access Layer) at its core, providing powerful storage ecosystem support. This integration enables Curvine to work seamlessly with various storage backends while maintaining a unified interface.","locale":"en"},"272":{"id":"/docs/Architecture/opendal-integration-18","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"OpenDAL is a data access layer that provides unified APIs to access various storage services. It serves as an abstraction layer between applications and storage systems, offering:","locale":"en"},"273":{"id":"/docs/Architecture/opendal-integration-19","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"**Unified Interface**: Consistent APIs across different storage backends","locale":"en"},"274":{"id":"/docs/Architecture/opendal-integration-20","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"**Multi-Storage Support**: Support for object storage, filesystems, databases, and more","locale":"en"},"275":{"id":"/docs/Architecture/opendal-integration-21","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"**High Performance**: Optimized data access paths and caching mechanisms","locale":"en"},"276":{"id":"/docs/Architecture/opendal-integration-22","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"**Extensibility**: Easy addition of new storage backend support","locale":"en"},"277":{"id":"/docs/Architecture/opendal-integration-23","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#what-is-opendal","content":"**Reliability**: Built-in retry mechanisms and error handling","locale":"en"},"278":{"id":"/docs/Architecture/opendal-integration-24","page_id":"/docs/Architecture/opendal-integration","tags":[],"type":"text","url":"/docs/Architecture/opendal-integration#supported-storage-backends","content":"Through OpenDAL integration, Curvine currently supports the following storage services:","locale":"en"},"279":{"id":"/docs/Archite