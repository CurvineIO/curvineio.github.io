nuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#performance-tuning-parameters","content":"Performance Tuning Parameters","locale":"en"},"3092":{"id":"/docs/User-Manuals/Operations/webui-22","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#metadata-management","content":"Metadata Management","locale":"en"},"3093":{"id":"/docs/User-Manuals/Operations/webui-23","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-validation-and-diagnostics","content":"Configuration Validation and Diagnostics","locale":"en"},"3094":{"id":"/docs/User-Manuals/Operations/webui-24","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-management-best-practices","content":"Configuration Management Best Practices","locale":"en"},"3095":{"id":"/docs/User-Manuals/Operations/webui-25","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui","content":"Curvine provides an intuitive and user-friendly web management interface that allows users to monitor cluster status in real-time, manage file systems, view worker node information, and configure system parameters through a web browser. The web interface serves as a visual operations platform for cluster operations and daily management, enabling most administrative tasks to be completed without complex command-line operations.","locale":"en"},"3096":{"id":"/docs/User-Manuals/Operations/webui-26","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#overview---cluster-overview","content":"The Overview page provides a comprehensive view of the Curvine cluster's overall operational status and serves as the core dashboard for cluster monitoring.","locale":"en"},"3097"