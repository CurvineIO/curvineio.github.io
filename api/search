tions/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#performance-tuning-parameters","content":"Performance Tuning Parameters","locale":"en"},"2811":{"id":"/docs/User-Manuals/Operations/webui-22","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#metadata-management","content":"Metadata Management","locale":"en"},"2812":{"id":"/docs/User-Manuals/Operations/webui-23","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-validation-and-diagnostics","content":"Configuration Validation and Diagnostics","locale":"en"},"2813":{"id":"/docs/User-Manuals/Operations/webui-24","page_id":"/docs/User-Manuals/Operations/webui","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/webui#configuration-management-best-practices","content":"Configuration Management Best Practices","locale":"en"},"2814":{"id":"/docs/User-Manuals/Operations/webui-25","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui","content":"Curvine provides an intuitive and user-friendly web management interface that allows users to monitor cluster status in real-time, manage file systems, view worker node information, and configure system parameters through a web browser. The web interface serves as a visual operations platform for cluster operations and daily management, enabling most administrative tasks to be completed without complex command-line operations.","locale":"en"},"2815":{"id":"/docs/User-Manuals/Operations/webui-26","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#overview---cluster-overview","content":"The Overview page provides a comprehensive view of the Curvine cluster's overall operational status and serves as the core dashboard for cluster monitoring.","locale":"en"},"2816":{"id":"/docs/User-Manuals/Operations/webui-27","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#cluster-status-information","content":"**Cluster Status**: Displays whether the cluster is currently active, including uptime information","locale":"en"},"2817":{"id":"/docs/User-Manuals/Operations/webui-28","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#cluster-status-information","content":"**Master Node Address**: Shows the access address and port of the Master node","locale":"en"},"2818":{"id":"/docs/User-Manuals/Operations/webui-29","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#cluster-status-information","content":"**Version Information**: Displays the current running Curvine version number","locale":"en"},"2819":{"id":"/docs/User-Manuals/Operations/webui-30","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#cluster-status-information","content":"**Startup Time**: Shows the cluster startup timestamp","locale":"en"},"2820":{"id":"/docs/User-Manuals/Operations/webui-31","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#worker-node-status","content":"**Active Worker Count**: Real-time display of currently online Worker nodes","locale":"en"},"2821":{"id":"/docs/User-Manuals/Operations/webui-32","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#worker-node-status","content":"**Offline Worker Count**: Shows currently offline or failed Worker nodes","locale":"en"},"2822":{"id":"/docs/User-Manuals/Operations/webui-33","page_id":"/docs/User-Manuals/Operations/webui","tags":[],"type":"text","url":"/docs/User-Manuals/Operations/webui#worker-node-status","content":"**Node Status Indicators**: Visu