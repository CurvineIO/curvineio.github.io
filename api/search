8":{"id":"/docs/User-Manuals/best-practices-32","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"8.2 Key Metrics to Alert On","locale":"en"},"3479":{"id":"/docs/User-Manuals/best-practices-33","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#83-prometheus--grafana-setup","content":"8.3 Prometheus + Grafana Setup","locale":"en"},"3480":{"id":"/docs/User-Manuals/best-practices-34","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#84-web-ui","content":"8.4 Web UI","locale":"en"},"3481":{"id":"/docs/User-Manuals/best-practices-35","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#9-transfer-service-best-practices","content":"9. Transfer Service Best Practices","locale":"en"},"3482":{"id":"/docs/User-Manuals/best-practices-36","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#91-high-availability","content":"9.1 High Availability","locale":"en"},"3483":{"id":"/docs/User-Manuals/best-practices-37","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"9.2 Capacity and Retention","locale":"en"},"3484":{"id":"/docs/User-Manuals/best-practices-38","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"10. Common Pitfalls and Troubleshooting","locale":"en"},"3485":{"id":"/docs/User-Manuals/best-practices-39","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"11. Security Recommendations","locale":"en"},"3486":{"id":"/docs/User-Manuals/best-practices-40","page_id":"/docs/User-Manuals/best-practices","type":"heading","tags":[],"url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"12. Upgrade and Maintenance","locale":"en"},"3487":{"id":"/docs/User-Manuals/best-practices-41","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices","content":"This guide consolidates production-proven recommendations for deploying, configuring, and operating Curvine across common workload scenarios. Each section is self-contained — apply the practices relevant to your environment.","locale":"en"},"3488":{"id":"/docs/User-Manuals/best-practices-42","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role   | Minimum (Dev/Test) | Recommended (Production) | Notes                                             |\n| ------ | ------------------ | ------------------------ | ------------------------------------------------- |\n| Master | 1 node             | 3 nodes (Raft group)     | Odd number for quorum; 3-node tolerates 1 failure |","locale":"en","table":"table-0"},"3489":{"id":"/docs/User-Manuals/best-practices-43","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role   | Minimum (Dev/Test) | Recommended (Production) | Notes                                            |\n| ------ | ------------------ | ------------------------ | ------------------------------------------------ |\n| Worker | 1 node             | 3+ nodes                 | Scale horizontally based on cache capacity needs |","locale":"en","table":"table-0"},"3490":{"id":"/docs/User-Manuals/best-practices-44","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-cluster-sizing-guidelines","content":"| Role | Minimum (Dev/Test)  | Recommended (Production) | Notes                                     |\n| ---- | ------------------- | ------------------------ | ----------------------------------------- |\n| FUSE | Co-located with app | 1 per compute node       | Deploy close to the workload for locality |","locale":"en","table":"table-0"},"3491":{"id":"/docs/User-Manuals/best-practices-45","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Always deploy **3 Master nodes** in production to form a Raft group. A single Master is a single point of failure.","locale":"en"},"3492":{"id":"/docs/User-Manuals/best-practices-46","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Set `journal_addrs` to list all Raft peers explicitly:","locale":"en"},"3493":{"id":"/docs/User-Manuals/best-practices-47","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Place Master nodes on separate physical hosts or availability zones to survive rack/zone failures.","locale":"en"},"3494":{"id":"/docs/User-Manuals/best-practices-48","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-high-availability","content":"Use `snapshot_interval = \"6h\"` (default) to keep Raft log size bounded.","locale":"en"},"3495":{"id":"/docs/User-Manuals/best-practices-49","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#13-production-configuration-checklist","content":"Set `CURVINE_MASTER_HOSTNAME`, `CURVINE_WORKER_HOSTNAME`, and `CURVINE_CLIENT_HOSTNAME` to routable addresses in multi-node environments.","locale":"en"},"3496":{"id":"/docs/User-Manuals/best-practices-50","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#13-production-configuration-checklist","content":"Never use `localhost` for any hostname in distributed deployments.","locale":"en"},"3497":{"id":"/docs/User-Manuals/best-practices-51","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"Use the official Helm chart for K8s environments:","locale":"en"},"3498":{"id":"/docs/User-Manuals/best-practices-52","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"Use `ReadWriteMany` PVCs with the CSI driver for shared data access across pods.","locale":"en"},"3499":{"id":"/docs/User-Manuals/best-practices-53","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#14-kubernetes-deployment","content":"For latency-sensitive workloads, prefer `embedded` mount mode; for FUSE isolation, use `standalone` mode.","locale":"en"},"3500":{"id":"/docs/User-Manuals/best-practices-54","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#15-kernel-and-os-tuning","content":"Use **Linux kernel 5.0+** (e.g., Ubuntu 22.04, Rocky Linux 9) for optimal FUSE performance.","locale":"en"},"3501":{"id":"/docs/User-Manuals/best-practices-55","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#15-kernel-and-os-tuning","content":"Avoid kernels below 4.15 in production — FUSE concurrency is severely limited.","locale":"en"},"3502":{"id":"/docs/User-Manuals/best-practices-56","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#2-mount-mode-selection","content":"Choosing the right mount mode is the single most impactful decision for your workload.","locale":"en"},"3503":{"id":"/docs/User-Manuals/best-practices-57","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                          | Recommended Mode | Rationale                                              |\n| --------------------------------- | ---------------- | ------------------------------------------------------ |\n| Read-heavy analytics over S3/HDFS | `cache_mode`     | UFS remains source of truth; Curvine accelerates reads |","locale":"en","table":"table-1"},"3504":{"id":"/docs/User-Manuals/best-practices-58","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                                 | Recommended Mode | Rationale                                    |\n| ---------------------------------------- | ---------------- | -------------------------------------------- |\n| AI/ML training data (immutable datasets) | `cache_mode`     | Data rarely changes; cache hit ratio is high |","locale":"en","table":"table-1"},"3505":{"id":"/docs/User-Manuals/best-practices-59","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                         | Recommended Mode | Rationale                                    |\n| -------------------------------- | ---------------- | -------------------------------------------- |\n| General-purpose POSIX filesystem | `fs_mode`        | Full random write, rename, file lock support |","locale":"en","table":"table-1"},"3506":{"id":"/docs/User-Manuals/best-practices-60","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                       | Recommended Mode | Rationale                                |\n| ------------------------------ | ---------------- | ---------------------------------------- |\n| Database storage / log writing | `fs_mode`        | Requires in-place modification semantics |","locale":"en","table":"table-1"},"3507":{"id":"/docs/User-Manuals/best-practices-61","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                            | Recommended Mode | Rationale                                  |\n| ----------------------------------- | ---------------- | ------------------------------------------ |\n| Shuffle data / intermediate results | `fs_mode`        | High write throughput with async UFS flush |","locale":"en","table":"table-1"},"3508":{"id":"/docs/User-Manuals/best-practices-62","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#21-decision-matrix","content":"| Scenario                      | Recommended Mode | Rationale                                     |\n| ----------------------------- | ---------------- | --------------------------------------------- |\n| Multi-cloud unified namespace | `cache_mode`     | Transparent proxy over heterogeneous backends |","locale":"en","table":"table-1"},"3509":{"id":"/docs/User-Manuals/best-practices-63","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"Enable `--read-verify-ufs true` **only** when UFS data changes frequently and staleness is unacceptable. It adds one extra UFS HEAD request per read.","locale":"en"},"3510":{"id":"/docs/User-Manuals/best-practices-64","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"Use `bin/cv fs free -r /path` to release cache space safely without deleting UFS data.","locale":"en"},"3511":{"id":"/docs/User-Manuals/best-practices-65","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#22-cache_mode-best-practices","content":"**Warning**: `delete` in cache_mode deletes UFS data. Use `free` for cache-only cleanup.","locale":"en"},"3512":{"id":"/docs/User-Manuals/best-practices-66","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"Run `bin/cv mount resync /workspace` after external UFS changes to synchronize metadata.","locale":"en"},"3513":{"id":"/docs/User-Manuals/best-practices-67","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"**Never rename large directories** on S3/OSS backends — it triggers full data copy.","locale":"en"},"3514":{"id":"/docs/User-Manuals/best-practices-68","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#23-fs_mode-best-practices","content":"Set `--replicas 2` or higher for critical data to survive Worker failures.","locale":"en"},"3515":{"id":"/docs/User-Manuals/best-practices-69","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature      | Storage Tier | TTL | Replicas | Example                       |\n| --------------------- | ------------ | --- | -------- | ----------------------------- |\n| Hot (frequent access) | MEM          | 1d  | 2-3      | Model weights, feature tables |","locale":"en","table":"table-2"},"3516":{"id":"/docs/User-Manuals/best-practices-70","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature      | Storage Tier | TTL | Replicas | Example                          |\n| --------------------- | ------------ | --- | -------- | -------------------------------- |\n| Warm (regular access) | SSD          | 7d  | 2        | Training datasets, Parquet files |","locale":"en","table":"table-2"},"3517":{"id":"/docs/User-Manuals/best-practices-71","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#32-match-storage-tier-to-data-temperature","content":"| Data Temperature         | Storage Tier | TTL | Replicas | Example                   |\n| ------------------------ | ------------ | --- | -------- | ------------------------- |\n| Cold (infrequent access) | HDD          | 30d | 1        | Archives, historical logs |","locale":"en","table":"table-2"},"3518":{"id":"/docs/User-Manuals/best-practices-72","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**Sequential read (large files > 100GB):**","locale":"en"},"3519":{"id":"/docs/User-Manuals/best-practices-73","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**High-concurrency small files (> 1000 concurrent):**","locale":"en"},"3520":{"id":"/docs/User-Manuals/best-practices-74","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#42-client-side-tuning-by-workload","content":"**Random read:**","locale":"en"},"3521":{"id":"/docs/User-Manuals/best-practices-75","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"**Always use FUSE3** in production — FUSE2 delivers only ~50% of FUSE3 throughput.","locale":"en"},"3522":{"id":"/docs/User-Manuals/best-practices-76","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"If stuck on FUSE2, use multiple mount points:","locale":"en"},"3523":{"id":"/docs/User-Manuals/best-practices-77","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"For memory-constrained FUSE nodes:","locale":"en"},"3524":{"id":"/docs/User-Manuals/best-practices-78","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"Curvine FUSE is fully asynchronous — `attr_timeout` and `entry_timeout` are optional. Increase them for read-heavy workloads with stable metadata:","locale":"en"},"3525":{"id":"/docs/User-Manuals/best-practices-79","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#43-fuse-optimization","content":"Set `entry_timeout = 0` and `attr_timeout = 0` if you need real-time visibility of changes from other clients.","locale":"en"},"3526":{"id":"/docs/User-Manuals/best-practices-80","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload                   | TTL | TTL Action | Rationale            |\n| -------------------------- | --- | ---------- | -------------------- |\n| Streaming / real-time data | 1h  | delete     | Data expires quickly |","locale":"en","table":"table-3"},"3527":{"id":"/docs/User-Manuals/best-practices-81","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload              | TTL     | TTL Action | Rationale                |\n| --------------------- | ------- | ---------- | ------------------------ |\n| Daily batch analytics | 1d - 7d | delete     | Aligns with job schedule |","locale":"en","table":"table-3"},"3528":{"id":"/docs/User-Manuals/best-practices-82","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload                | TTL      | TTL Action | Rationale                     |\n| ----------------------- | -------- | ---------- | ----------------------------- |\n| Model training datasets | 7d - 30d | free       | Keep metadata, release blocks |","locale":"en","table":"table-3"},"3529":{"id":"/docs/User-Manuals/best-practices-83","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"| Workload             | TTL          | TTL Action | Rationale                           |\n| -------------------- | ------------ | ---------- | ----------------------------------- |\n| Persistent workspace | 0 (disabled) | none       | Data lives until explicitly deleted |","locale":"en","table":"table-3"},"3530":{"id":"/docs/User-Manuals/best-practices-84","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#51-ttl-strategy","content":"When using `rclone` or similar tools that preserve `mtime`, imported files may immediately expire. Verify TTL settings before large-scale imports, or temporarily disable TTL.","locale":"en"},"3531":{"id":"/docs/User-Manuals/best-practices-85","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#52-quota-based-eviction","content":"Enable LRU eviction to prevent storage exhaustion:","locale":"en"},"3532":{"id":"/docs/User-Manuals/best-practices-86","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#52-quota-based-eviction","content":"Files with `ttl_action = \"none\"` are **exempt** from LRU eviction — use this for critical data.","locale":"en"},"3533":{"id":"/docs/User-Manuals/best-practices-87","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Warm up the cache before peak workloads:","locale":"en"},"3534":{"id":"/docs/User-Manuals/best-practices-88","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Automatic caching is enabled per-mount when TTL > 0. First reads trigger background load jobs.","locale":"en"},"3535":{"id":"/docs/User-Manuals/best-practices-89","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#53-data-preloading","content":"Combine proactive + automatic caching for best hit ratio.","locale":"en"},"3536":{"id":"/docs/User-Manuals/best-practices-90","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Use FUSE mount point directly in PyTorch/TensorFlow data loaders — no code changes needed.","locale":"en"},"3537":{"id":"/docs/User-Manuals/best-practices-91","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Set `num_workers=8` in DataLoader for parallel FUSE reads.","locale":"en"},"3538":{"id":"/docs/User-Manuals/best-practices-92","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#61-training-data-access","content":"Pre-load datasets before training starts: `bin/cv load s3://datasets/imagenet -w`","locale":"en"},"3539":{"id":"/docs/User-Manuals/best-practices-93","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#62-model-serving","content":"Use `--ttl-ms 0` (no expiration) for model files that must always be available.","locale":"en"},"3540":{"id":"/docs/User-Manuals/best-practices-94","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#62-model-serving","content":"Enable `--read-verify-ufs` to detect model version updates pushed to UFS.","locale":"en"},"3541":{"id":"/docs/User-Manuals/best-practices-95","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#71-spark-integration","content":"For zero-code acceleration, use the S3A transparent proxy:","locale":"en"},"3542":{"id":"/docs/User-Manuals/best-practices-96","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#71-spark-integration","content":"Mounted paths automatically use Curvine cache; unmounted paths fall through to native S3.","locale":"en"},"3543":{"id":"/docs/User-Manuals/best-practices-97","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Use `fs_mode` mounts for shuffle data to benefit from full write acceleration.","locale":"en"},"3544":{"id":"/docs/User-Manuals/best-practices-98","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Set `--storage-type ssd` for shuffle — memory is too expensive for ephemeral data.","locale":"en"},"3545":{"id":"/docs/User-Manuals/best-practices-99","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#72-shuffle-acceleration","content":"Use short TTL (`1h`-`4h`) since shuffle data is transient.","locale":"en"},"3546":{"id":"/docs/User-Manuals/best-practices-100","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern        | Recommended Block Size | Rationale                                     |\n| ------------------- | ---------------------- | --------------------------------------------- |\n| Small files (< 4MB) | 4MB                    | One block per file, minimal metadata overhead |","locale":"en","table":"table-4"},"3547":{"id":"/docs/User-Manuals/best-practices-101","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern            | Recommended Block Size | Rationale                         |\n| ----------------------- | ---------------------- | --------------------------------- |\n| Parquet / ORC analytics | 128MB (default)        | Balanced parallelism and locality |","locale":"en","table":"table-4"},"3548":{"id":"/docs/User-Manuals/best-practices-102","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern           | Recommended Block Size | Rationale                                 |\n| ---------------------- | ---------------------- | ----------------------------------------- |\n| Large sequential files | 1GB                    | Reduces connection count for random reads |","locale":"en","table":"table-4"},"3549":{"id":"/docs/User-Manuals/best-practices-103","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#73-block-size-selection","content":"| Data Pattern           | Recommended Block Size | Rationale                         |\n| ---------------------- | ---------------------- | --------------------------------- |\n| Video / model binaries | 256MB - 1GB            | High throughput sequential access |","locale":"en","table":"table-4"},"3550":{"id":"/docs/User-Manuals/best-practices-104","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| Master    | `http://<host>:9010/metrics` | 9010 |","locale":"en","table":"table-5"},"3551":{"id":"/docs/User-Manuals/best-practices-105","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| Worker    | `http://<host>:9002/metrics` | 9002 |","locale":"en","table":"table-5"},"3552":{"id":"/docs/User-Manuals/best-practices-106","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component | Endpoint                     | Port |\n| --------- | ---------------------------- | ---- |\n| FUSE      | `http://<host>:9003/metrics` | 9003 |","locale":"en","table":"table-5"},"3553":{"id":"/docs/User-Manuals/best-practices-107","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component                   | Endpoint             | Port |\n| --------------------------- | -------------------- | ---- |\n| Web console (`curvine-web`) | `http://<host>:9000` | 9000 |","locale":"en","table":"table-5"},"3554":{"id":"/docs/User-Manuals/best-practices-108","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#81-metrics-endpoints","content":"| Component           | Endpoint                     | Port |\n| ------------------- | ---------------------------- | ---- |\n| Transfer (optional) | `http://<host>:9011/metrics` | 9011 |","locale":"en","table":"table-5"},"3555":{"id":"/docs/User-Manuals/best-practices-109","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                 | Alert Condition | Action                      |\n| ---------------------- | --------------- | --------------------------- |\n| `available / capacity` | < 20%           | Scale Workers or reduce TTL |","locale":"en","table":"table-6"},"3556":{"id":"/docs/User-Manuals/best-practices-110","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                 | Alert Condition | Action                  |\n| ---------------------- | --------------- | ----------------------- |\n| `worker_num` (offline) | > 0 for 5min    | Investigate node health |","locale":"en","table":"table-6"},"3557":{"id":"/docs/User-Manuals/best-practices-111","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                      | Alert Condition | Action                      |\n| --------------------------- | --------------- | --------------------------- |\n| `replication_failure_count` | Increasing      | Check network / disk health |","locale":"en","table":"table-6"},"3558":{"id":"/docs/User-Manuals/best-practices-112","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric                      | Alert Condition    | Action                           |\n| --------------------------- | ------------------ | -------------------------------- |\n| `client_mount_cache_misses` | High ratio vs hits | Review TTL / preloading strategy |","locale":"en","table":"table-6"},"3559":{"id":"/docs/User-Manuals/best-practices-113","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#82-key-metrics-to-alert-on","content":"| Metric         | Alert Condition | Action                   |\n| -------------- | --------------- | ------------------------ |\n| `failed_disks` | > 0             | Replace disk immediately |","locale":"en","table":"table-6"},"3560":{"id":"/docs/User-Manuals/best-practices-114","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#84-web-ui","content":"Admin console (`curvine-web`, started with `bin/curvine-web.sh start`): `http://<web-host>:9000` — cluster overview, file browser, worker status, configuration, monitoring dashboards.","locale":"en"},"3561":{"id":"/docs/User-Manuals/best-practices-115","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#84-web-ui","content":"Master `:9010` is metrics-only and has no UI.","locale":"en"},"3562":{"id":"/docs/User-Manuals/best-practices-116","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#84-web-ui","content":"Worker UI: `http://<worker-host>:9002` — node-level storage and block statistics.","locale":"en"},"3563":{"id":"/docs/User-Manuals/best-practices-117","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#9-transfer-service-best-practices","content":"The S3 gateway is not part of the current Curvine server. Use the optional\nTransfer service for independent Load and Export scheduling instead.","locale":"en"},"3564":{"id":"/docs/User-Manuals/best-practices-118","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"Use a shared MySQL `store_url` before running more than one Transfer replica.","locale":"en"},"3565":{"id":"/docs/User-Manuals/best-practices-119","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"The default SQLite store is suitable for a single Transfer instance only.","locale":"en"},"3566":{"id":"/docs/User-Manuals/best-practices-120","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#91-high-availability","content":"Keep `transfer.replicas = 1` when SQLite is in use.","locale":"en"},"3567":{"id":"/docs/User-Manuals/best-practices-121","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Tune `max_running_transfers` to match available UFS bandwidth.","locale":"en"},"3568":{"id":"/docs/User-Manuals/best-practices-122","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Set `terminal_retention` according to how long completed jobs must remain queryable.","locale":"en"},"3569":{"id":"/docs/User-Manuals/best-practices-123","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#92-capacity-and-retention","content":"Monitor the Transfer `/metrics` endpoint and the `cv transfer list` backlog.","locale":"en"},"3570":{"id":"/docs/User-Manuals/best-practices-124","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                               | Symptom                     | Solution                                    |\n| ------------------------------------- | --------------------------- | ------------------------------------------- |\n| Using `localhost` in distributed mode | Workers cannot reach Master | Set proper hostnames via env vars or config |","locale":"en","table":"table-7"},"3571":{"id":"/docs/User-Manuals/best-practices-125","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                                  | Symptom                    | Solution                                              |\n| ---------------------------------------- | -------------------------- | ----------------------------------------------------- |\n| Renaming large S3 directories in fs_mode | Operation blocks for hours | Avoid rename on object storage; copy + delete instead |","locale":"en","table":"table-7"},"3572":{"id":"/docs/User-Manuals/best-practices-126","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                         | Symptom                        | Solution                                             |\n| ------------------------------- | ------------------------------ | ---------------------------------------------------- |\n| TTL too short for training data | Cache thrashing, low hit ratio | Increase `--ttl-ms` to match training epoch duration |","locale":"en","table":"table-7"},"3573":{"id":"/docs/User-Manuals/best-practices-127","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall             | Symptom             | Solution                                 |\n| ------------------- | ------------------- | ---------------------------------------- |\n| FUSE2 in production | 50% throughput loss | Upgrade to FUSE3 or use `mnt_number = 4` |","locale":"en","table":"table-7"},"3574":{"id":"/docs/User-Manuals/best-practices-128","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                       | Symptom                               | Solution                                             |\n| ----------------------------- | ------------------------------------- | ---------------------------------------------------- |\n| `rclone` preserving old mtime | Files immediately expire after import | Adjust mtime after import or disable TTL temporarily |","locale":"en","table":"table-7"},"3575":{"id":"/docs/User-Manuals/best-practices-129","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                     | Symptom                        | Solution                 |\n| --------------------------- | ------------------------------ | ------------------------ |\n| Single Master in production | Cluster down on Master failure | Deploy 3-node Raft group |","locale":"en","table":"table-7"},"3576":{"id":"/docs/User-Manuals/best-practices-130","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                              | Symptom                   | Solution                           |\n| ------------------------------------ | ------------------------- | ---------------------------------- |\n| `format_master = true` in production | Metadata wiped on restart | Set to `false` after initial setup |","locale":"en","table":"table-7"},"3577":{"id":"/docs/User-Manuals/best-practices-131","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                        | Symptom                   | Solution                              |\n| ------------------------------ | ------------------------- | ------------------------------------- |\n| Ignoring `failed_disks` metric | Data loss on disk failure | Monitor and replace disks proactively |","locale":"en","table":"table-7"},"3578":{"id":"/docs/User-Manuals/best-practices-132","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                         | Symptom                                   | Solution                            |\n| ------------------------------- | ----------------------------------------- | ----------------------------------- |\n| Not running `resync` in fs_mode | Stale metadata after external UFS changes | Schedule periodic `cv mount resync` |","locale":"en","table":"table-7"},"3579":{"id":"/docs/User-Manuals/best-practices-133","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#10-common-pitfalls-and-troubleshooting","content":"| Pitfall                              | Symptom                                  | Solution                                |\n| ------------------------------------ | ---------------------------------------- | --------------------------------------- |\n| Block size too small for large files | Excessive connections, slow random reads | Use `--block-size 1GB` for files > 10GB |","locale":"en","table":"table-7"},"3580":{"id":"/docs/User-Manuals/best-practices-134","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Rotate UFS credentials regularly; use IAM roles where possible.","locale":"en"},"3581":{"id":"/docs/User-Manuals/best-practices-135","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Use network policies (K8s) or firewall rules to restrict access to Master RPC (8995) and Worker RPC (8997) ports.","locale":"en"},"3582":{"id":"/docs/User-Manuals/best-practices-136","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"Enable audit logging (`audit_logging_enabled = true`) for compliance-sensitive environments.","locale":"en"},"3583":{"id":"/docs/User-Manuals/best-practices-137","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#11-security-recommendations","content":"In multi-tenant environments, isolate namespaces by using separate Curvine paths per team with quota controls.","locale":"en"},"3584":{"id":"/docs/User-Manuals/best-practices-138","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Always take a metadata snapshot before upgrading Master nodes.","locale":"en"},"3585":{"id":"/docs/User-Manuals/best-practices-139","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Perform rolling upgrades: upgrade Followers first, then trigger leader transfer and upgrade the last node.","locale":"en"},"3586":{"id":"/docs/User-Manuals/best-practices-140","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"After upgrading Workers, verify heartbeat registration via the Web UI or `bin/cv report`.","locale":"en"},"3587":{"id":"/docs/User-Manuals/best-practices-141","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Test FUSE remount after upgrades: `bin/curvine-fuse.sh restart`.","locale":"en"},"3588":{"id":"/docs/User-Manuals/best-practices-142","page_id":"/docs/User-Manuals/best-practices","tags":[],"type":"text","url":"/docs/User-Manuals/best-practices#12-upgrade-and-maintenance","content":"Keep `retain_checkpoint_num = 3` (default) to allow rollback to previous metadata states.","locale":"en"},"3589":{"id":"/docs/User-Manuals","page_id":"/docs/User-Manuals","type":"page","content":"User Manuals","breadcrumbs":["Documents","User Manuals"],"tags":[],"url":"/docs/User-Manuals","locale":"en"},"3590":{"id":"/docs/User-Manuals/opt","page_id":"/docs/User-Manuals/opt","type":"page","content":"Performance Tuning","breadcrumbs":["Documents","User Manuals"],"tags":[],"url":"/docs/User-Manuals/opt","locale":"en"},"3591":{"id":"/docs/User-Manuals/opt-0","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"Server-Side Performance Tuning","locale":"en"},"3592":{"id":"/docs/User-Manuals/opt-1","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#client-side-performance-tuning","content":"Client-Side Performance Tuning","locale":"en"},"3593":{"id":"/docs/User-Manuals/opt-2","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#sequential-readwrite-scenarios","content":"Sequential Read/Write Scenarios","locale":"en"},"3594":{"id":"/docs/User-Manuals/opt-3","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"High Concurrency Read/Write Scenarios","locale":"en"},"3595":{"id":"/docs/User-Manuals/opt-4","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#large-file-sequential-read","content":"Large File Sequential Read","locale":"en"},"3596":{"id":"/docs/User-Manuals/opt-5","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#random-read","content":"Random Read","locale":"en"},"3597":{"id":"/docs/User-Manuals/opt-6","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#fuse-performance-optimization","content":"FUSE Performance Optimization","locale":"en"},"3598":{"id":"/docs/User-Manuals/opt-7","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#memory-control","content":"Memory Control","locale":"en"},"3599":{"id":"/docs/User-Manuals/opt-8","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#metadata-performance-optimization","content":"Metadata Performance Optimization","locale":"en"},"3600":{"id":"/docs/User-Manuals/opt-9","page_id":"/docs/User-Manuals/opt","type":"heading","tags":[],"url":"/docs/User-Manuals/opt#fuse2-optimization-solution","content":"FUSE2 Optimization Solution","locale":"en"},"3601":{"id":"/docs/User-Manuals/opt-10","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt","content":"This chapter introduces how to optimize Curvine's performance.","locale":"en"},"3602":{"id":"/docs/User-Manuals/opt-11","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"The default configuration is suitable for most scenarios. In high-load environments, you can adjust the following parameters:","locale":"en"},"3603":{"id":"/docs/User-Manuals/opt-12","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"**Thread count tuning**: Adjust the number of worker threads based on CPU cores and business load","locale":"en"},"3604":{"id":"/docs/User-Manuals/opt-13","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"**Kernel parameter optimization**: Adjust network buffers, resource limits, and other parameters","locale":"en"},"3605":{"id":"/docs/User-Manuals/opt-14","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"Curvine configuration adjustment example:","locale":"en"},"3606":{"id":"/docs/User-Manuals/opt-15","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#server-side-performance-tuning","content":"Kernel parameter adjustment example (configuration examples show which parameters affect performance, for reference only, adjust according to actual needs):","locale":"en"},"3607":{"id":"/docs/User-Manuals/opt-16","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#sequential-readwrite-scenarios","content":"Sequential read/write scenarios can achieve optimal performance using default configurations.","locale":"en"},"3608":{"id":"/docs/User-Manuals/opt-17","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"When clients need to handle a large number of file I/O operations simultaneously:","locale":"en"},"3609":{"id":"/docs/User-Manuals/opt-18","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"Set `read_chunk_num=1` and `write_chunk_num=1` to reduce memory usage","locale":"en"},"3610":{"id":"/docs/User-Manuals/opt-19","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"Suitable for scenarios with concurrent file count > 1000","locale":"en"},"3611":{"id":"/docs/User-Manuals/opt-20","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"Single file throughput will decrease, but overall throughput remains unchanged, memory usage will decrease by 90%","locale":"en"},"3612":{"id":"/docs/User-Manuals/opt-21","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#high-concurrency-readwrite-scenarios","content":"Configuration example:","locale":"en"},"3613":{"id":"/docs/User-Manuals/opt-22","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#large-file-sequential-read","content":"For sequential reading of single large files (>100GB):","locale":"en"},"3614":{"id":"/docs/User-Manuals/opt-23","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#large-file-sequential-read","content":"Recommended parallelism = 4-16","locale":"en"},"3615":{"id":"/docs/User-Manuals/opt-24","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#large-file-sequential-read","content":"Performance can improve 3-5 times, reaching 2-3GB/s","locale":"en"},"3616":{"id":"/docs/User-Manuals/opt-25","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#large-file-sequential-read","content":"Configuration example:","locale":"en"},"3617":{"id":"/docs/User-Manuals/opt-26","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"For completely random reads, it's recommended to:","locale":"en"},"3618":{"id":"/docs/User-Manuals/opt-27","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"Set buffer to 1 to avoid read amplification","locale":"en"},"3619":{"id":"/docs/User-Manuals/opt-28","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"Make chunk_size close to average I/O size (e.g., 4KB/256KB)","locale":"en"},"3620":{"id":"/docs/User-Manuals/opt-29","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"For large files, set block_size ≥ 1GB to reduce connection count","locale":"en"},"3621":{"id":"/docs/User-Manuals/opt-30","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"Configuration example:","locale":"en"},"3622":{"id":"/docs/User-Manuals/opt-31","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#random-read","content":"In completely random read scenarios, the client will cache connections with workers to reduce connection establishment overhead. However, if a file is very large, it will have many blocks, leading to too many connections. It's recommended to set block_size to 1GB or above when writing such large files to reduce connection count.","locale":"en"},"3623":{"id":"/docs/User-Manuals/opt-32","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#fuse-performance-optimization","content":"Curvine FUSE currently supports FUSE2 and FUSE3. FUSE2's performance is approximately only 50% of FUSE3, so it's recommended to use FUSE3 in production environments.","locale":"en"},"3624":{"id":"/docs/User-Manuals/opt-33","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#memory-control","content":"If FUSE is deployed on memory-constrained machines, you can set queue sizes to reduce memory usage:","locale":"en"},"3625":{"id":"/docs/User-Manuals/opt-34","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#memory-control","content":"Configuration example:","locale":"en"},"3626":{"id":"/docs/User-Manuals/opt-35","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#memory-control","content":"Curvine FUSE currently does not support page cache.","locale":"en"},"3627":{"id":"/docs/User-Manuals/opt-36","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#metadata-performance-optimization","content":"In traditional libfuse implementations, metadata may be blocked by data read/write requests, causing request delays. Users are usually advised to set `attr_timeout` and `entry_timeout` to let the kernel cache metadata and improve performance.","locale":"en"},"3628":{"id":"/docs/User-Manuals/opt-37","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#metadata-performance-optimization","content":"However, in Curvine's FUSE implementation, FUSE request processing is completely asynchronous, so there's no need to set `attr_timeout` and `entry_timeout`.","locale":"en"},"3629":{"id":"/docs/User-Manuals/opt-38","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#metadata-performance-optimization","content":"Of course, if needed, you can also increase cache time. Configuration example:","locale":"en"},"3630":{"id":"/docs/User-Manuals/opt-39","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#metadata-performance-optimization","content":"If you want modifications to be visible in real-time, you can set expiration time to 0, which won't affect FUSE performance:","locale":"en"},"3631":{"id":"/docs/User-Manuals/opt-40","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#fuse2-optimization-solution","content":"If your environment can only use FUSE2 and you want to improve performance, you can use multiple mount points as a solution. In actual testing, 4-8 mount points can achieve about 80% of FUSE3's performance.","locale":"en"},"3632":{"id":"/docs/User-Manuals/opt-41","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#fuse2-optimization-solution","content":"Configuration example:","locale":"en"},"3633":{"id":"/docs/User-Manuals/opt-42","page_id":"/docs/User-Manuals/opt","tags":[],"type":"text","url":"/docs/User-Manuals/opt#fuse2-optimization-solution","content":"Multiple mount points will mount multiple directories in the operating system. Programs need to use random or round-robin methods to select mount points to distribute the load.","locale":"en"},"3634":{"id":"/docs","page_id":"/docs","type":"page","content":"Curvine Documentation","tags":[],"url":"/docs","locale":"en"},"3635":{"id":"/zh-cn/docs/Architecture/fluid-integration","page_id":"/zh-cn/docs/Architecture/fluid-integration","type":"page","content":"Curvine 与 Fluid 集成","breadcrumbs":["Documents","Architecture"],"tags":[],"url":"/zh-cn/docs/Architecture/fluid-integration","locale":"zh-cn"},"3636":{"id":"/zh-cn/docs/Architecture/fluid-integration-0","page_id":"/zh-cn/docs/Architecture/fluid-integration","type":"heading","tags":[],"url":"/zh-cn/docs/Architecture/fluid-integration#选择接入方式","content":"选择接入方式","locale":"zh-cn"},