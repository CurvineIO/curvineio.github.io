re/spdk-architecture#spdkiochannel","content":"SpdkIoChannel","locale":"en"},"318":{"id":"/docs/Architecture/spdk-architecture-13","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"DmaBuf (DMA Buffer)","locale":"en"},"319":{"id":"/docs/Architecture/spdk-architecture-14","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#bdevoffsetallocator","content":"BdevOffsetAllocator","locale":"en"},"320":{"id":"/docs/Architecture/spdk-architecture-15","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#spdkmetastore","content":"SpdkMetaStore","locale":"en"},"321":{"id":"/docs/Architecture/spdk-architecture-16","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#read-path","content":"Read Path","locale":"en"},"322":{"id":"/docs/Architecture/spdk-architecture-17","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#write-path","content":"Write Path","locale":"en"},"323":{"id":"/docs/Architecture/spdk-architecture-18","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#block-lifecycle","content":"Block Lifecycle","locale":"en"},"324":{"id":"/docs/Architecture/spdk-architecture-19","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#dma-buffer-management","content":"DMA Buffer Management","locale":"en"},"325":{"id":"/docs/Architecture/spdk-architecture-20","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#alignment-constraints","content":"Alignment Constraints","locale":"en"},"326":{"id":"/docs/Architecture/spdk-architecture-21","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#configuration","content":"Configuration","locale":"en"},"327":{"id":"/docs/Architecture/spdk-architecture-22","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#quick-start","content":"Quick Start","locale":"en"},"328":{"id":"/docs/Architecture/spdk-architecture-23","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#optimization-experiment-next-steps","content":"Optimization Experiment: Next Steps","locale":"en"},"329":{"id":"/docs/Architecture/spdk-architecture-24","page_id":"/docs/Architecture/spdk-architecture","type":"heading","tags":[],"url":"/docs/Architecture/spdk-architecture#code-references","content":"Code References","locale":"en"},"330":{"id":"/docs/Architecture/spdk-architecture-25","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#overview","content":"SPDK (Storage Performance Development Kit) enables kernel-bypass, userspace NVMe I/O in Curvine. Instead of going through the kernel VFS (`pread`/`pwrite`), the Worker talks directly to an NVMe-oF target via TCP or RDMA, using a dedicated poller thread and DMA hugepage buffers for minimal latency.","locale":"en"},"331":{"id":"/docs/Architecture/spdk-architecture-26","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#overview","content":"Curvine uses SPDK as a **remote block device** — the NVMe-oF target can be a physical NVMe drive on the same host, a dedicated SPDK target container, or a remote storage node. The Worker opens `SpdkBdev` handles (analogous to `LocalFile`) and issues read/write I/O through the `BlockIO` trait.","locale":"en"},"332":{"id":"/docs/Architecture/spdk-architecture-27","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#when-to-use-spdk","content":"SPDK natively reaches over 10 million IOPS on a single core[1]. Curvine's SPDK path targets workloads where kernel VFS overhead dominates — use it when you need lower latency or higher throughput than LocalFile can provide.","locale":"en"},"333":{"id":"/docs/Architecture/spdk-architecture-28","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"`orpc/src/io/spdk_env.rs`","locale":"en"},"334":{"id":"/docs/Architecture/spdk-architecture-29","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Singleton that initializes the SPDK application framework (DPDK EAL, hugepages, reactor mask). On startup it:","locale":"en"},"335":{"id":"/docs/Architecture/spdk-architecture-30","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Allocates hugepages for DMA buffers","locale":"en"},"336":{"id":"/docs/Architecture/spdk-architecture-31","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Sets CPU affinity via `reactor_mask`","locale":"en"},"337":{"id":"/docs/Architecture/spdk-architecture-32","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Discovers NVMe-oF targets and their namespaces","locale":"en"},"338":{"id":"/docs/Architecture/spdk-architecture-33","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Creates the `SpdkPoller` thread","locale":"en"},"339":{"id":"/docs/Architecture/spdk-architecture-34","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Maintains a qpair pool per controller","locale":"en"},"340":{"id":"/docs/Architecture/spdk-architecture-35","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenv-global-environment","content":"Only one `SpdkEnv` exists per Worker process. It is initialized from `SpdkConf`.","locale":"en"},"341":{"id":"/docs/Architecture/spdk-architecture-36","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenvstate","content":"`orpc/src/io/spdk_env.rs`","locale":"en"},"342":{"id":"/docs/Architecture/spdk-architecture-37","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenvstate","content":"Three-state lifecycle machine controlling `SpdkEnv` initialization and shutdown:","locale":"en"},"343":{"id":"/docs/Architecture/spdk-architecture-38","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkenvstate","content":"Stored as `AtomicU8` for lock-free reads. The state gates handle acquisition\n(`acquire_handle` increments then verifies `Initialized`) and prevents\nconcurrent shutdown (CAS transitions `Initialized → ShutDown`).","locale":"en"},"344":{"id":"/docs/Architecture/spdk-architecture-39","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdk-ffi-layer","content":"`orpc/src/io/spdk_ffi.rs`","locale":"en"},"345":{"id":"/docs/Architecture/spdk-architecture-40","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdk-ffi-layer","content":"Curvine interacts with the SPDK C library through a thin FFI layer that insulates Rust code from SPDK's C ABI. Three techniques are used:","locale":"en"},"346":{"id":"/docs/Architecture/spdk-architecture-41","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdk-ffi-layer","content":"**Opaque ZST pointers**: SPDK types like `spdk_nvme_ctrlr` are declared as zero-sized enums in Rust — they exist only for compile-time type safety. At runtime they are raw pointers passed straight to C.","locale":"en"},"347":{"id":"/docs/Architecture/spdk-architecture-42","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdk-ffi-layer","content":"**Fixed-size byte buffers**: SPDK C structs (async context, namespace data) are represented as `[u8; N]` with `#[repr(C, align(8))]` instead of matching the C layout field-by-field. This avoids version-dependent layout mismatches.","locale":"en"},"348":{"id":"/docs/Architecture/spdk-architecture-43","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdk-ffi-layer","content":"**`curvine_*` C helper functions**: Small C wrappers that set struct fields at known offsets. For example, Rust calls `curvine_spdk_async_ctx_init(...)` rather than manipulating C struct fields directly. At init, a runtime `sizeof()` check compares the Rust buffer size against the real C struct size, catching ABI drift immediately.","locale":"en"},"349":{"id":"/docs/Architecture/spdk-architecture-44","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkpoller-dedicated-io-thread","content":"`orpc/src/io/spdk_poller.rs`","locale":"en"},"350":{"id":"/docs/Architecture/spdk-architecture-45","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkpoller-dedicated-io-thread","content":"SPDK requires all NVMe submission and completion processing to run on a single thread that holds the SPDK reactor context. `SpdkPoller` bridges the async handler threads (which issue I/O) to the synchronous SPDK polling loop.","locale":"en"},"351":{"id":"/docs/Architecture/spdk-architecture-46","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkpoller-dedicated-io-thread","content":"**Idle**: The poller blocks on `eventfd` to avoid burning CPU. Handler threads signal the `eventfd` when enqueuing a new request, waking the poller into Active.","locale":"en"},"352":{"id":"/docs/Architecture/spdk-architecture-47","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkpoller-dedicated-io-thread","content":"**Active**: Drains the incoming request channel, submits NVMe commands via `spdk_nvme_ns_cmd_read`/`write`, polls qpairs for completions, and invokes per-I/O callbacks. When the queue is empty, it spins for `spin_iter` iterations before transitioning to Idle. This **spin-before-park** avoids an `eventfd` wake round-trip when the next I/O arrives immediately, keeping the poller in a low-overhead polling loop instead of a syscall-heavy park/unpark cycle.","locale":"en"},"353":{"id":"/docs/Architecture/spdk-architecture-48","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkpoller-dedicated-io-thread","content":"**Orphaned (HashMap)**: When `curvine_spdk_qpair_poll` returns an error, the qpair is moved from Active into an `orphaned` HashMap. The poller force-completes all pending I/Os on the failed qpair via `force_complete_qpair`, waking blocked handler threads with an error status. The orphaned entry persists to catch late SPDK callbacks.","locale":"en"},"354":{"id":"/docs/Architecture/spdk-architecture-49","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#io-request-protocol","content":"`orpc/src/io/spdk_poller.rs`","locale":"en"},"355":{"id":"/docs/Architecture/spdk-architecture-50","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#io-request-protocol","content":"Handler threads communicate with the poller through three types:","locale":"en"},"356":{"id":"/docs/Architecture/spdk-architecture-51","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#io-request-protocol","content":"**IoOp**: The operation enum. `Read` and `Write` carry namespace, qpair, DMA buffer, offset, and length. `Flush` targets a namespace; `UnregisterQpair` notifies cleanup.","locale":"en"},"357":{"id":"/docs/Architecture/spdk-architecture-52","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#io-request-protocol","content":"**IoRequest**: The envelope wrapping an `IoOp`, `Arc<IoCompletion>`, and the per-bdev inflight counter. Sent through the crossbeam channel.","locale":"en"},"358":{"id":"/docs/Architecture/spdk-architecture-53","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#io-request-protocol","content":"**IoCompletion**: Bridges handler and poller threads. The handler blocks on `wait(timeout)`; the poller's C callback wakes it via `complete(status)`.","locale":"en"},"359":{"id":"/docs/Architecture/spdk-architecture-54","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"`orpc/src/io/spdk_bdev.rs`","locale":"en"},"360":{"id":"/docs/Architecture/spdk-architecture-55","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"Per-bdev handle analogous to `LocalFile`. It holds:","locale":"en"},"361":{"id":"/docs/Architecture/spdk-architecture-56","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"Raw NVMe namespace and qpair pointers","locale":"en"},"362":{"id":"/docs/Architecture/spdk-architecture-57","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"DMA read and write buffers (hugepage-backed, fixed-size per `dma_buf_size` (1 MB as the default), reused across I/Os)","locale":"en"},"363":{"id":"/docs/Architecture/spdk-architecture-58","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"I/O channel sender to the poller thread","locale":"en"},"364":{"id":"/docs/Architecture/spdk-architecture-59","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"Current position (`pos`), device size, block size","locale":"en"},"365":{"id":"/docs/Architecture/spdk-architecture-60","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"Large I/Os are **chunked**: split into `dma_buf_size` chunks and submitted serially.","locale":"en"},"366":{"id":"/docs/Architecture/spdk-architecture-61","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkbdev-block-device-handle","content":"`BlockDevice` (in `orpc/src/io/block_io.rs`) wraps `SpdkBdev` and `LocalFile` into a single enum that implements `BlockIO`. The handler code dispatches through the trait at runtime without knowing which backend it's talking to.","locale":"en"},"367":{"id":"/docs/Architecture/spdk-architecture-62","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#nvme-queue-pair-qpair","content":"`orpc/src/io/spdk_env.rs`","locale":"en"},"368":{"id":"/docs/Architecture/spdk-architecture-63","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#nvme-queue-pair-qpair","content":"An NVMe I/O queue pair (qpair) is the communication channel between the host and the NVMe-oF target. Commands (read/write/flush) are submitted on the submission queue (SQ); completions arrive on the completion queue (CQ). The poller polls the CQ to detect finished I/Os.","locale":"en"},"369":{"id":"/docs/Architecture/spdk-architecture-64","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#nvme-queue-pair-qpair","content":"Each `SpdkBdev` holds one qpair, opened against the target's namespace. Qpairs are **not thread-safe** — all submit and poll must happen on the same thread, which is why `SpdkPoller` exists as a dedicated thread.","locale":"en"},"370":{"id":"/docs/Architecture/spdk-architecture-65","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#qpair-pool","content":"`orpc/src/io/spdk_env.rs`","locale":"en"},"371":{"id":"/docs/Architecture/spdk-architecture-66","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#qpair-pool","content":"Allocating and freeing a qpair involves C FFI calls into SPDK, which in turn may send NVMe admin commands to the controller. To avoid this overhead on every bdev open/close, a `QpairPool` caches idle qpairs per controller:","locale":"en"},"372":{"id":"/docs/Architecture/spdk-architecture-67","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#qpair-pool","content":"**Acquire**: Pop a cached qpair (zero FFI). If pool is empty, call `curvine_spdk_alloc_io_qpair` to allocate a new one.","locale":"en"},"373":{"id":"/docs/Architecture/spdk-architecture-68","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#qpair-pool","content":"**Release**: Push the qpair back into the pool. If the pool exceeds the limit (16 per controller by default), free the excess via `curvine_spdk_free_io_qpair` to bound controller-side memory.","locale":"en"},"374":{"id":"/docs/Architecture/spdk-architecture-69","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#qpair-pool","content":"**Drain**: On shutdown, `drain_all()` frees all cached qpairs.","locale":"en"},"375":{"id":"/docs/Architecture/spdk-architecture-70","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"`orpc/src/io/spdk_bdev.rs:27`","locale":"en"},"376":{"id":"/docs/Architecture/spdk-architecture-71","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"The bridge between an `SpdkBdev` and the `SpdkPoller`. Each bdev holds one channel containing:","locale":"en"},"377":{"id":"/docs/Architecture/spdk-architecture-72","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"**qpair**: The NVMe queue pair for issuing commands","locale":"en"},"378":{"id":"/docs/Architecture/spdk-architecture-73","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"**poller_tx**: Crossbeam sender to submit `IoRequest`s to the poller thread","locale":"en"},"379":{"id":"/docs/Architecture/spdk-architecture-74","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"**eventfd**: File descriptor for waking the poller from Idle state","locale":"en"},"380":{"id":"/docs/Architecture/spdk-architecture-75","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"**poller_is_sleeping**: Shared `AtomicBool` set true by the poller when idle; bdevs check it to skip the eventfd write syscall","locale":"en"},"381":{"id":"/docs/Architecture/spdk-architecture-76","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkiochannel","content":"No direct reference to `SpdkPoller` is stored — all communication is through the channel and eventfd, which allows the bdev to be thread-safe.","locale":"en"},"382":{"id":"/docs/Architecture/spdk-architecture-77","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"`orpc/src/io/spdk_bdev.rs`","locale":"en"},"383":{"id":"/docs/Architecture/spdk-architecture-78","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"A pre-allocated, fixed-size buffer backed by hugepages for NVMe DMA.","locale":"en"},"384":{"id":"/docs/Architecture/spdk-architecture-79","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"**Hugepage backing**: Allocated via `curvine_spdk_dma_malloc` which returns physically contiguous, pinned memory. This satisfies the NVMe controller's DMA requirements and avoids TLB misses for large I/Os.","locale":"en"},"385":{"id":"/docs/Architecture/spdk-architecture-80","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"**Pre-allocated and reused**: Each `SpdkBdev` allocates two buffers (read + write) at open time via `curvine_spdk_dma_malloc` and reuses them for every I/O. This avoids a malloc/free cycle per I/O — the buffer is zero-cost after the first allocation.","locale":"en"},"386":{"id":"/docs/Architecture/spdk-architecture-81","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"**Cleanup on close**: Buffers are freed via `curvine_spdk_dma_free` in `SpdkBdev::drop`. If inflight I/Os do not drain before the drop deadline, the buffer pointers are nulled to prevent use-after-free (safe leak).","locale":"en"},"387":{"id":"/docs/Architecture/spdk-architecture-82","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"**Reuse through chunking**: Large I/Os are split into `dma_buf_size` chunks and processed serially through the same fixed buffer, avoiding the need for dynamically-sized DMA memory.","locale":"en"},"388":{"id":"/docs/Architecture/spdk-architecture-83","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dmabuf-dma-buffer","content":"**Block alignment**: All offsets are aligned down to the device block size. This is required by the NVMe specification — unaligned DMA addresses cause controller errors.","locale":"en"},"389":{"id":"/docs/Architecture/spdk-architecture-84","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#bdevoffsetallocator","content":"`curvine-server/src/worker/storage/dir_state.rs`","locale":"en"},"390":{"id":"/docs/Architecture/spdk-architecture-85","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#bdevoffsetallocator","content":"With `LocalFile` storage, the kernel's filesystem assigns disk blocks to each file and tracks free space. With SPDK, multiple Curvine blocks share the same raw bdev — there is no kernel filesystem in between, the NVMe device exposes a flat byte address space. `BdevOffsetAllocator` replaces the kernel's block allocator: it assigns each block a unique byte range on the bdev and reclaims the range when the block is deleted.","locale":"en"},"391":{"id":"/docs/Architecture/spdk-architecture-86","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#bdevoffsetallocator","content":"It manages this with a bump cursor that advances through the address space for new allocations, and a free-list that tracks reclaimed ranges with adjacent coalescing to reduce fragmentation. The allocator is thread-safe. On restart, the cursor position and free-list are restored from RocksDB snapshots (via `SpdkMetaStore`), ensuring no double-allocation. The current implementation is a straightforward bump-and-free-list design and need to optimize later.","locale":"en"},"392":{"id":"/docs/Architecture/spdk-architecture-87","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkmetastore","content":"`curvine-server/src/worker/storage/spdk_meta_store.rs`","locale":"en"},"393":{"id":"/docs/Architecture/spdk-architecture-88","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#spdkmetastore","content":"RocksDB-backed persistent map: `block_id → (dir_id, offset, size, len, finalized)`. Metadata is written on block create and finalize, restored on Worker restart.","locale":"en"},"394":{"id":"/docs/Architecture/spdk-architecture-89","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"The handler calls `SpdkBdev::read_region(enable_send_file, len)`, which reads from the bdev's current position. The underlying `spdk_read()` splits large reads into DMA-buffer-sized chunks (1 MB by default) and processes each through the poller:","locale":"en"},"395":{"id":"/docs/Architecture/spdk-architecture-90","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"Submit an `IoRequest` to the poller thread via crossbeam channel. If the poller is idle, wake it via `eventfd`.","locale":"en"},"396":{"id":"/docs/Architecture/spdk-architecture-91","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"The handler blocks on a condition variable waiting for completion.","locale":"en"},"397":{"id":"/docs/Architecture/spdk-architecture-92","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"The poller submits `spdk_nvme_ns_cmd_read` to the NVMe-oF target, polls for completion, then signals the handler.","locale":"en"},"398":{"id":"/docs/Architecture/spdk-architecture-93","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"The handler copies data from the DMA buffer into a heap `BytesMut`, then advances to the next chunk.","locale":"en"},"399":{"id":"/docs/Architecture/spdk-architecture-94","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#read-path","content":"All I/O is block-aligned (aligned down to the device block size). Unaligned reads read the full aligned block and extract the requested bytes into the result.","locale":"en"},"400":{"id":"/docs/Architecture/spdk-architecture-95","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#write-path","content":"NVMe commands require block-aligned offsets and lengths. When a write offset or length is not aligned to the device block size, a **read-modify-write** cycle is needed:","locale":"en"},"401":{"id":"/docs/Architecture/spdk-architecture-96","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#write-path","content":"Read the full aligned block into the DMA buffer (e.g., 4096 bytes at offset 0 for a write at offset 7)","locale":"en"},"402":{"id":"/docs/Architecture/spdk-architecture-97","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#write-path","content":"Copy the user's data into the DMA buffer at the correct offset, preserving bytes outside the write range","locale":"en"},"403":{"id":"/docs/Architecture/spdk-architecture-98","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#write-path","content":"Submit the write command for the full aligned block","locale":"en"},"404":{"id":"/docs/Architecture/spdk-architecture-99","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#write-path","content":"For aligned writes, only step 3 is needed — the NVMe write command is submitted directly.","locale":"en"},"405":{"id":"/docs/Architecture/spdk-architecture-100","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dma-buffer-management","content":"Read and write buffers are `dma_buf_size` 1 MB each by default, pre-allocated at `SpdkBdev::open()`","locale":"en"},"406":{"id":"/docs/Architecture/spdk-architecture-101","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dma-buffer-management","content":"Larger I/Os are split into `dma_buf_size` chunks, processed serially","locale":"en"},"407":{"id":"/docs/Architecture/spdk-architecture-102","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#dma-buffer-management","content":"Each chunk requires a DMA memcpy: `DmaBuf → heap BytesMut` (read) or `heap → DmaBuf` (write)","locale":"en"},"408":{"id":"/docs/Architecture/spdk-architecture-103","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#alignment-constraints","content":"NVMe commands require block-aligned offsets and lengths:","locale":"en"},"409":{"id":"/docs/Architecture/spdk-architecture-104","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#alignment-constraints","content":"For writes, unaligned offsets or lengths trigger a read-modify-write cycle (see Write Path).","locale":"en"},"410":{"id":"/docs/Architecture/spdk-architecture-105","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#configuration","content":"TBP","locale":"en"},"411":{"id":"/docs/Architecture/spdk-architecture-106","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#quick-start","content":"TBP","locale":"en"},"412":{"id":"/docs/Architecture/spdk-architecture-107","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#optimization-experiment-next-steps","content":"**Target-side hybrid mode**: Apply active/idle state transitions to the SPDK NVMe-oF target to reduce CPU usage when idle.","locale":"en"},"413":{"id":"/docs/Architecture/spdk-architecture-108","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#optimization-experiment-next-steps","content":"**Allocator improvements**: Enhance performance, reduce fragmentation, contention, and time complexity under high workload.","locale":"en"},"414":{"id":"/docs/Architecture/spdk-architecture-109","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#optimization-experiment-next-steps","content":"**I/O submission and polling**: Experiment with batch submission and multi-poller approaches to scale throughput.","locale":"en"},"415":{"id":"/docs/Architecture/spdk-architecture-110","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                      | Purpose                                              |\n| ------------------------- | ---------------------------------------------------- |\n| `orpc/src/io/spdk_env.rs` | Global SPDK environment init, SpdkEnvState lifecycle |","locale":"en","table":"table-0"},"416":{"id":"/docs/Architecture/spdk-architecture-111","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                         | Purpose                                                                          |\n| ---------------------------- | -------------------------------------------------------------------------------- |\n| `orpc/src/io/spdk_poller.rs` | Poller thread, I/O submission, completion callbacks, IoOp/IoRequest/IoCompletion |","locale":"en","table":"table-0"},"417":{"id":"/docs/Architecture/spdk-architecture-112","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                       | Purpose                                                 |\n| -------------------------- | ------------------------------------------------------- |\n| `orpc/src/io/spdk_bdev.rs` | SpdkBdev read/write, SpdkIoChannel, DmaBuf, chunked I/O |","locale":"en","table":"table-0"},"418":{"id":"/docs/Architecture/spdk-architecture-113","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                      | Purpose                            |\n| ------------------------- | ---------------------------------- |\n| `orpc/src/io/spdk_ffi.rs` | Raw FFI bindings to SPDK C library |","locale":"en","table":"table-0"},"419":{"id":"/docs/Architecture/spdk-architecture-114","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                           | Purpose                               |\n| ------------------------------ | ------------------------------------- |\n| `orpc/csrc/spdk_opts_helper.c` | C helper for SPDK opts initialization |","locale":"en","table":"table-0"},"420":{"id":"/docs/Architecture/spdk-architecture-115","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                      | Purpose                            |\n| ------------------------- | ---------------------------------- |\n| `orpc/src/io/block_io.rs` | BlockIO trait and BlockDevice enum |","locale":"en","table":"table-0"},"421":{"id":"/docs/Architecture/spdk-architecture-116","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"| File                                             | Purpose             |\n| ------------------------------------------------ | ------------------- |\n| `curvine-server/src/worker/storage/dir_state.rs` | BdevOffsetAllocator |","locale":"en","table":"table-0"},"422":{"id":"/docs/Architecture/spdk-architecture-117","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-archite