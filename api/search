eded, then starts:","locale":"en"},"1916":{"id":"/docs/Deploy/quick-start-10","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"`curvine-master`","locale":"en"},"1917":{"id":"/docs/Deploy/quick-start-11","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"`curvine-worker`","locale":"en"},"1918":{"id":"/docs/Deploy/quick-start-12","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"`curvine-transfer` (only when `[transfer].enabled = true`)","locale":"en"},"1919":{"id":"/docs/Deploy/quick-start-13","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"`curvine-fuse`","locale":"en"},"1920":{"id":"/docs/Deploy/quick-start-14","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"The Web UI is not started as a separate process. Static UI assets are bundled in `webui/` and served on the service web ports.","locale":"en"},"1921":{"id":"/docs/Deploy/quick-start-15","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"`CURVINE_MASTER_HOSTNAME=localhost` is suitable for single-node local use. In multi-node or containerized environments, set `CURVINE_MASTER_HOSTNAME`, `CURVINE_WORKER_HOSTNAME`, and `CURVINE_CLIENT_HOSTNAME` to addresses that other nodes and clients can actually reach.","locale":"en"},"1922":{"id":"/docs/Deploy/quick-start-16","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"By default, FUSE is mounted at `/curvine-fuse`.","locale":"en"},"1923":{"id":"/docs/Deploy/quick-start-17","page_id":"/docs/D