cale":"en"},"1912":{"id":"/docs/Deploy/kubernetes-quick-start-18","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"Save the cluster config:","locale":"en"},"1913":{"id":"/docs/Deploy/kubernetes-quick-start-19","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"Create the cluster:","locale":"en"},"1914":{"id":"/docs/Deploy/kubernetes-quick-start-20","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"The CSI node plugin mounts volumes with FUSE, so the kind node needs `/dev/fuse`. kind nodes run as privileged containers and see the host's devices, so no extra mount is required. Check that the device is there:","locale":"en"},"1915":{"id":"/docs/Deploy/kubernetes-quick-start-21","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"If `/dev/fuse` is missing on a Linux host, load the kernel module with `sudo modprobe fuse` and recreate the cluster. Docker Desktop on macOS already provides the device.","locale":"en"},"1916":{"id":"/docs/Deploy/kubernetes-quick-start-22","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#1-create-a-kind-cluster","content":"kind installs a default StorageClass named `standard` (local-path provisioner). The runtime chart below uses it for master metadata, the Raft journal, and worker data:","locale":"en"},"1917":{"id":"/docs/Deploy/kubernetes-quick-start-23","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Save a values file sized for a laptop. It runs one master and one worker, uses the `standard` StorageClass, and lowers the default resource requests:","locale":"en"},"1918":{"id":"/docs/Deploy/kubernetes-quick-start-24","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"The worker `size` also sets the capacity Curvine reports for that data directory (`2Gi` becomes `[SSD:2GB]/data/data1`).","locale":"en"},"1919":{"id":"/docs/Deploy/kubernetes-quick-start-25","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Add the Helm repository and install the chart:","locale":"en"},"1920":{"id":"/docs/Deploy/kubernetes-quick-start-26","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"`0.5.2-alpha` is a pre-release, so Helm does not pick it unless you pass `--version` (or `--devel`). Run `helm search repo curvine --devel --versions` to list the published versions.","locale":"en"},"1921":{"id":"/docs/Deploy/kubernetes-quick-start-27","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"Check that the master and worker are running and their PVCs are bound:","locale":"en"},"1922":{"id":"/docs/Deploy/kubernetes-quick-start-28","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#2-install-the-curvine-runtime","content":"The worker should have registered with the master:","locale":"en"},"1923":{"id":"/docs/Deploy/kubernetes-quick-start-29","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#3-install-the-csi-driver","content":"Save the CSI values. They lower the node plugin's memory request and avoid pulling the image again on every restart:","locale":"en"},"1924":{"id":"/docs/Deploy/kubernetes-quick-start-30","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#3-install-the-csi-driver","content":"Install the chart:","locale":"en"},"1925":{"id":"/docs/Deploy/kubernetes-quick-start-31","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#3-install-the-csi-driver","content":"Create a StorageClass that points at the master. Each PVC gets its own directory under `fs-path` in Curvine:","locale":"en"},"1926":{"id":"/docs/Deploy/kubernetes-quick-start-32","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"Save a PVC and a test pod that mounts it at `/data`:","locale":"en"},"1927":{"id":"/docs/Deploy/kubernetes-quick-start-33","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"Apply it and wait for the pod. The pod becomes Ready only after the PVC is bound and the volume is mounted:","locale":"en"},"1928":{"id":"/docs/Deploy/kubernetes-quick-start-34","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"Write a file and read it back:","locale":"en"},"1929":{"id":"/docs/Deploy/kubernetes-quick-start-35","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"`/data` is a Curvine FUSE mount:","locale":"en"},"1930":{"id":"/docs/Deploy/kubernetes-quick-start-36","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"The file is stored in Curvine, not in the pod. List it with the `cv` CLI in the master container:","locale":"en"},"1931":{"id":"/docs/Deploy/kubernetes-quick-start-37","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#4-mount-a-volume-in-a-pod","content":"To confirm the data outlives the pod, recreate the pod and read the file again:","locale":"en"},"1932":{"id":"/docs/Deploy/kubernetes-quick-start-38","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#5-clean-up","content":"Delete the test resources and both releases:","locale":"en"},"1933":{"id":"/docs/Deploy/kubernetes-quick-start-39","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#5-clean-up","content":"`helm uninstall` keeps the master and worker PVCs created by the StatefulSets. Delete the namespaces to remove them, then delete the cluster:","locale":"en"},"1934":{"id":"/docs/Deploy/kubernetes-quick-start-40","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#minikube","content":"The same values files and manifests work on minikube with the Docker driver. minikube's default StorageClass is also named `standard`.","locale":"en"},"1935":{"id":"/docs/Deploy/kubernetes-quick-start-41","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#minikube","content":"Then follow steps 2 to 4 unchanged. To clean up, run step 5 up to the `kind delete` command, then:","locale":"en"},"1936":{"id":"/docs/Deploy/kubernetes-quick-start-42","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#troubleshooting","content":"| Symptom                        | Check                                                                                                                                     |\n| ------------------------------ | ----------------------------------------------------------------------------------------------------------------------------------------- |\n| Master or worker pod `Pending` | `kubectl describe pod -n curvine <pod>`. Usually not enough memory in Docker, or no `standard` StorageClass (`kubectl get storageclass`). |","locale":"en","table":"table-1"},"1937":{"id":"/docs/Deploy/kubernetes-quick-start-43","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#troubleshooting","content":"| Symptom                                | Check                                                                                                                                           |\n| -------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------- |\n| PVC `curvine-test-pvc` stays `Pending` | `kubectl logs -n curvine-system -l app=curvine-csi-controller -c csi-plugin`. Make sure `kubectl get pods -n curvine` shows the master running. |","locale":"en","table":"table-1"},"1938":{"id":"/docs/Deploy/kubernetes-quick-start-44","page_id":"/docs/Deploy/kubernetes-quick-start","tags":[],"type":"text","url":"/docs/Deploy/kubernetes-quick-start#troubleshooting","content":"| Symptom                               | Check                                                                                                                                                              |\n| ------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| Test pod stuck in `ContainerCreating` | `kubectl describe pod curvine-test`, then `kubectl logs -n curvine-system -l app=curvine-csi-node -c csi-plugin`. A missing `/dev/fuse` on the node shows up here. |","locale":"en","table":"table-1"},"1939":{"id":"/docs/Deploy/quick-start","page_id":"/docs/Deploy/quick-start","type":"page","content":"Quick Start","breadcrumbs":["Documents","Deploy"],"tags":[],"url":"/docs/Deploy/quick-start","locale":"en"},"1940":{"id":"/docs/Deploy/quick-start-0","page_id":"/docs/Deploy/quick-start","type":"heading","tags":[],"url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"Start from a Release Package","locale":"en"},"1941":{"id":"/docs/Deploy/quick-start-1","page_id":"/docs/Deploy/quick-start","type":"heading","tags":[],"url":"/docs/Deploy/quick-start#verify-the-cluster","content":"Verify the Cluster","locale":"en"},"1942":{"id":"/docs/Deploy/quick-start-2","page_id":"/docs/Deploy/quick-start","type":"heading","tags":[],"url":"/docs/Deploy/quick-start#optional-compatibility-shell","content":"Optional Compatibility Shell","locale":"en"},"1943":{"id":"/docs/Deploy/quick-start-3","page_id":"/docs/Deploy/quick-start","type":"heading","tags":[],"url":"/docs/Deploy/quick-start#web-ui","content":"Web UI","locale":"en"},"1944":{"id":"/docs/Deploy/quick-start-4","page_id":"/docs/Deploy/quick-start","type":"heading","tags":[],"url":"/docs/Deploy/quick-start#about-benchmark-scripts","content":"About Benchmark Scripts","locale":"en"},"1945":{"id":"/docs/Deploy/quick-start-5","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start","content":"This chapter shows the shortest path to bring up a single-node Curvine cluster from a release package or a local `build/dist` directory, then verify that CLI and FUSE access both work.","locale":"en"},"1946":{"id":"/docs/Deploy/quick-start-6","page_id":"/docs/Deploy/quick-start","tags":[],"type":"text","url":"/docs/Deploy/quick-start#start-from-a-release-package","content":"Download the prebuilt package from https://github.com/CurvineIO/curvine/releases. If your target environment is not covered by a published package, build from source first; see Download and Compile Curvine.",