h-cn"},"4928":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-0","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"部署顺序","locale":"zh-cn"},"4929":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-1","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Deployment-Overview#文档边界","content":"文档边界","locale":"zh-cn"},"4930":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-2","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Deployment-Overview#生产变更","content":"生产变更","locale":"zh-cn"},"4931":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-3","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview","content":"本章区分集群安装与可选服务。先部署并验证 Curvine Master 和 Worker；只有在希望\nLoad 或 Export 任务脱离 Master 进程运行时，才部署 Transfer 服务。","locale":"zh-cn"},"4932":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-4","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"选择集群形态。","locale":"zh-cn"},"4933":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-5","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"本地体验使用快速开始。","locale":"zh-cn"},"4934":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-6","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"单机集群使用单机模式。","locale":"zh-cn"},"4935":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-7","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"分布式集群使用物理机\n或 Kubernetes。","locale":"zh-cn"},"4936":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-8","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"确认 Master 和 Worker 健康，并使用 `cv mount --check` 验证必需的 UFS 挂载。","locale":"zh-cn"},"4937":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-9","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"如需独立调度 Load 和 Export，部署 Transfer 服务。","locale":"zh-cn"},"4938":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-10","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#部署顺序","content":"逐步在需要切换的客户端启用 Transfer。未启用的客户端在灰度期间仍可使用旧的\nMaster Job 路径。","locale":"zh-cn"},"4939":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-11","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#文档边界","content":"集群部署页面说明 Master、Worker、存储和网络。","locale":"zh-cn"},"4940":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-12","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#文档边界","content":"Transfer 页面说明独立调度器、状态存储和客户端路由。","locale":"zh-cn"},"4941":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-13","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#文档边界","content":"配置参考\n是默认值的唯一来源；部署页面只展示对应拓扑的必填项。","locale":"zh-cn"},"4942":{"id":"/zh-cn/docs/Deploy/Deployment-Overview-14","page_id":"/zh-cn/docs/Deploy/Deployment-Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deployment-Overview#生产变更","content":"升级应作为独立操作执行。修改线上集群前，先在非生产环境验证版本兼容性和配置变更。\n如果需要运行多个 Transfer 实例，必须使用共享的 MySQL Store。","locale":"zh-cn"},"4943":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"page","content":"物理机部署 Transfer","breadcrumbs":["Documents","部署","Transfer 服务"],"tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","locale":"zh-cn"},"4944":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-0","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#准备服务配置","content":"准备服务配置","locale":"zh-cn"},"4945":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-1","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#启动与停止","content":"启动与停止","locale":"zh-cn"},"4946":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-2","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#使用-systemd-运行","content":"使用 systemd 运行","locale":"zh-cn"},"4947":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-3","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#验证","content":"验证","locale":"zh-cn"},"4948":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-4","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#高可用","content":"高可用","locale":"zh-cn"},"4949":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-5","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","content":"本指南在现有 Curvine 集群旁部署一个独立的 Transfer 进程。Master 和 Worker 必须已经\n运行，并且使用支持 Transfer task 的版本。","locale":"zh-cn"},"4950":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-6","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#准备服务配置","content":"以已包含 Master 地址的集群配置为基础，创建一份仅供 Transfer 使用的副本。下面的\n`[transfer]` 是单实例 SQLite 部署唯一需要新增的配置段。","locale":"zh-cn"},"4951":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-7","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#准备服务配置","content":"当 `endpoints` 为空时，Curvine 会公布 `hostname:rpc_port`。只有当客户端必须通过其他地址访问（例如经过负载均衡）时，才需要显式设置 `endpoints`。","locale":"zh-cn"},"4952":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-8","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#准备服务配置","content":"使用运行服务的同一个操作系统用户创建 Store 目录。SQLite 数据库必须位于持久化本地盘\n或块存储上；不要放在共享文件系统上，也不要再启动第二个进程访问该数据库。","locale":"zh-cn"},"4953":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-9","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#启动与停止","content":"发行包包含 Transfer 启动脚本。它会加载 `curvine-env.sh`，写入\n`logs/transfer.out`，并维护 `transfer.pid`。","locale":"zh-cn"},"4954":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-10","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#使用-systemd-运行","content":"使用发行包内置脚本，以便服务拥有正常的 Curvine shell 环境。将下列内容保存为\n`/etc/systemd/system/curvine-transfer.service`。","locale":"zh-cn"},"4955":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-11","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#验证","content":"客户端地址必须可被所有 CLI 使用者和可能执行 Transfer task 的 Worker 访问。","locale":"zh-cn"},"4956":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal-12","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Bare-Metal#高可用","content":"运行多个 Transfer 进程时，将 SQLite URL 改为一个共享的 MySQL `store_url`。每个进程\n必须具有唯一且可访问的地址，并通过负载均衡或 DNS 向客户端提供一个稳定地址。不要将\n多个彼此独立的 SQLite 数据库作为故障切换目标。","locale":"zh-cn"},"4957":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"page","content":"Kubernetes 部署 Transfer","breadcrumbs":["Documents","部署","Transfer 服务"],"tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","locale":"zh-cn"},"4958":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-0","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#helm-chart","content":"Helm Chart","locale":"zh-cn"},"4959":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-1","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#前置条件","content":"前置条件","locale":"zh-cn"},"4960":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-2","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#sqlite-单副本清单","content":"SQLite 单副本清单","locale":"zh-cn"},"4961":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-3","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#配置客户端","content":"配置客户端","locale":"zh-cn"},"4962":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-4","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#mysql-多副本部署","content":"MySQL 多副本部署","locale":"zh-cn"},"4963":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-5","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","content":"Transfer 与 Master、Worker 工作负载分开运行。Curvine Helm Chart 在\n`transfer.enabled=true` 时会创建该服务，因此通常应使用 Chart 部署。下方独立清单适用于\n不使用 Chart 或需要自定义工作负载的场景。SQLite 清单固定为单副本，并使用专用 RWO 卷。","locale":"zh-cn"},"4964":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-6","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#helm-chart","content":"Chart 会创建 `curvine-transfer` Deployment 和 Service，将其 Service FQDN 写入\n`[transfer].hostname`，并根据该 hostname 与 `transfer.rpcPort` 推导客户端端点。请保持\n`endpoints` 未设置。`transfer.storeUrl` 为空时使用单 Pod SQLite 默认配置，并由 Chart\n管理 PVC。完整参数见 Kubernetes 部署。","locale":"zh-cn"},"4965":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-7","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#前置条件","content":"命名空间中已部署 Curvine Master 和 Worker。","locale":"zh-cn"},"4966":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-8","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#前置条件","content":"存在包含 `curvine-cluster.toml` 键的集群配置 ConfigMap。示例使用\n`curvine-cluster-config`，请替换为实际名称。","locale":"zh-cn"},"4967":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-9","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#前置条件","content":"集群存在支持 `ReadWriteOnce` 的默认 `StorageClass`，或者在 PVC 上配置\n`storageClassName`。","locale":"zh-cn"},"4968":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-10","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#前置条件","content":"镜像版本与 Master、Worker 一致。","locale":"zh-cn"},"4969":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-11","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#sqlite-单副本清单","content":"将下列内容保存为 `transfer-sqlite.yaml`，并替换镜像和命名空间。","locale":"zh-cn"},"4970":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-12","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#sqlite-单副本清单","content":"主容器只能挂载生成后的 `curvine-cluster.toml` 文件。若用 `emptyDir` 覆盖整个\n`/app/curvine/conf`，会遮蔽镜像中的 `curvine-env.sh`，导致发行包内置客户端脚本异常。","locale":"zh-cn"},"4971":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-13","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#sqlite-单副本清单","content":"应用并验证服务：","locale":"zh-cn"},"4972":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-14","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#配置客户端","content":"集群内客户端使用 Service DNS。当 `endpoints` 为空时，客户端会根据 `hostname` 与 `rpc_port` 推导端点：","locale":"zh-cn"},"4973":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-15","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#配置客户端","content":"集群外客户端必须使用自身可访问的地址；`.svc.cluster.local` 仅在集群网络内可用。","locale":"zh-cn"},"4974":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes-16","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Kubernetes#mysql-多副本部署","content":"如需运行多个 Transfer 副本，应通过 Secret 提供共享 MySQL `store_url`，移除 SQLite\nPVC，并让所有副本使用同一个 ClusterIP Service。所有副本必须使用同一数据库和兼容的\n镜像版本。不要将 SQLite Deployment 扩容到一个以上副本。","locale":"zh-cn"},"4975":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"page","content":"Transfer 服务","breadcrumbs":["Documents","部署","Transfer 服务"],"tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview","locale":"zh-cn"},"4976":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-0","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"配置边界","locale":"zh-cn"},"4977":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-1","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#选择状态存储","content":"选择状态存储","locale":"zh-cn"},"4978":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-2","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#必填配置","content":"必填配置","locale":"zh-cn"},"4979":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-3","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#部署与验证","content":"部署与验证","locale":"zh-cn"},"4980":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-4","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#灰度与回滚","content":"灰度与回滚","locale":"zh-cn"},"4981":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-5","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview","content":"Transfer 是用于 Load 和 Export 任务的独立服务。它持久化任务状态，基于 mount 和\nWorker 信息规划任务，向 Worker 下发任务并接收回报。它不会保存完整 Curvine 元数据树\n的副本。","locale":"zh-cn"},"4982":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-6","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview","content":"应在 Master 和 Worker 健康后再部署 Transfer。它是可选服务：未启用 Transfer 的集群\n继续使用原有的 Master Load 和 Export 路径。","locale":"zh-cn"},"4983":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-7","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"服务端与客户端使用不同的 Transfer 配置。部署 Transfer 时，不要修改正在运行的 Master\n或 Worker 配置。","locale":"zh-cn"},"4984":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-8","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"| 组件          | 必需变更                                                        | 说明                        |\n| ----------- | ----------------------------------------------------------- | ------------------------- |\n| Transfer 服务 | 配置 `transfer.enabled = true`、持久化 `store_url` 和可访问 endpoint。 | 服务配置还必须包含现有集群的 Master 地址。 |","locale":"zh-cn","table":"table-0"},"4985":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-9","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"| 组件            | 必需变更                                                                          | 说明                                               |\n| ------------- | ----------------------------------------------------------------------------- | ------------------------------------------------ |\n| CLI 或 SDK 客户端 | 配置 `transfer.enabled = true` 以及可访问的端点（`endpoints`，或 `hostname` 与 `rpc_port`）。 | `cv load`、`cv export` 及兼容的查询/取消命令会自动使用 Transfer。 |","locale":"zh-cn","table":"table-0"},"4986":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-10","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"| 组件     | 必需变更 | 说明                                                      |\n| ------ | ---- | ------------------------------------------------------- |\n| Master | 无。   | Master 无需修改配置；未启用 Transfer 的客户端继续使用旧 Load 和 Export RPC。 |","locale":"zh-cn","table":"table-0"},"4987":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-11","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"| 组件     | 必需变更 | 说明                                                 |\n| ------ | ---- | -------------------------------------------------- |\n| Worker | 无。   | Worker 只需使用支持 Transfer task 的版本；回报 endpoint 随任务下发。 |","locale":"zh-cn","table":"table-0"},"4988":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-12","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#配置边界","content":"客户端配置中不需要数据库 URL。状态存储只属于 Transfer 服务端。","locale":"zh-cn"},"4989":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-13","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#选择状态存储","content":"| Store  | 拓扑                       | 适用场景         |\n| ------ | ------------------------ | ------------ |\n| SQLite | 一个 Transfer 实例和一个持久化本地卷。 | 评估、开发或单实例部署。 |","locale":"zh-cn","table":"table-1"},"4990":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-14","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#选择状态存储","content":"| Store | 拓扑                         | 适用场景        |\n| ----- | -------------------------- | ----------- |\n| MySQL | 两个及以上 Transfer 实例共享同一个数据库。 | 生产高可用和滚动升级。 |","locale":"zh-cn","table":"table-1"},"4991":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-15","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#选择状态存储","content":"不要让多个 Transfer 实例使用彼此独立的 SQLite 文件。它们会持有不同的 Job 状态，无法\n正确故障切换。","locale":"zh-cn"},"4992":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-16","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#必填配置","content":"Transfer 服务端需要一份完整的集群配置，其中包括 `[client]` 的 Master 地址。只在\nTransfer 服务端配置中增加以下段落：","locale":"zh-cn"},"4993":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-17","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#必填配置","content":"使用 MySQL 时，将 `store_url` 改为共享的 MySQL URL。不要在客户端配置或 ConfigMap\n中写入数据库凭据。","locale":"zh-cn"},"4994":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-18","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#必填配置","content":"客户端只需要路由配置：","locale":"zh-cn"},"4995":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-19","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#必填配置","content":"未配置 `endpoints` 时，Curvine 使用 `hostname:rpc_port` 推导一个地址。在 Kubernetes\n中优先使用这种形式，Chart 会把 Service FQDN 写入 `hostname`。仅当客户端通过其他地址\n（例如负载均衡）访问服务时，才需要显式设置 `endpoints`。","locale":"zh-cn"},"4996":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-20","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#部署与验证","content":"物理机部署","locale":"zh-cn"},"4997":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-21","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#部署与验证","content":"Kubernetes 部署","locale":"zh-cn"},"4998":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-22","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#部署与验证","content":"Transfer 配置参考","locale":"zh-cn"},"4999":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-23","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#部署与验证","content":"部署后，在已启用 Transfer 的客户端执行 `cv transfer list`。再对一个小型已挂载 UFS\n文件执行 `cv load <path> --watch`，确认任务进入 `Completed`，并使用\n`cv fs --cache-only get` 读取目标。","locale":"zh-cn"},"5000":{"id":"/zh-cn/docs/Deploy/Transfer-Service/Overview-24","page_id":"/zh-cn/docs/Deploy/Transfer-Service/Overview","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Transfer-Service/Overview#灰度与回滚","content":"按客户端逐步启用 Transfer。`transfer.enabled = false` 的客户端继续调用旧 Master Job\nAPI，因此单独部署 Transfer 不会改变已有工作负载。回滚客户端时只需关闭该客户端的\nTransfer；存在运行中任务时，不要删除 Transfer Store。","locale":"zh-cn"},"5001":{"id":"/zh-cn/docs/Deploy/Transfer-Service","page_id":"/zh-cn/docs/Deploy/Transfer-Service","type":"page","content":"Transfer Service","breadcrumbs":["Documents","部署","Transfer 服务"],"tags":[],"url":"/zh-cn/docs/Deploy/Transfer-Service","locale":"zh-cn"},"5002":{"id":"/zh-cn/docs/Deploy/build-instructions","page_id":"/zh-cn/docs/Deploy/build-instructions","type":"page","content":"构建指南","breadcrumbs":["Documents","部署"],"tags":[],"url":"/zh-cn/docs/Deploy/build-instructions","locale":"zh-cn"},"5003":{"id":"/zh-cn/docs/Deploy/build-instructions-0","page_id":"/zh-cn/docs/Deploy/build-instructions","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/build-instructions#先决条件","content":"先决条件","locale":"zh-cn"},"5004":{"id":"/zh-cn/docs/Deploy/build-instructions-1","page_id":"/zh-cn/docs/Deploy/build-instructions","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/build-instructions#构建步骤linux---ubuntudebian-示例","content":"构建步骤（Linux - Ubuntu/Debian 示例）","locale":"zh-cn"},"5005":{"id":"/zh-cn/docs/Deploy/build-instructions-2","page_id":"/zh-cn/docs/Deploy/build-instructions","type":"heading","tags":[],"url":"/zh-cn/docs/Deploy/build-instructions#启动单节点集群","content":"启动单节点集群","locale":"zh-cn"},"5006":{"id":"/zh-cn/docs/Deploy/build-instructions-3","page_id":"/zh-cn/docs/Deploy/build-instructions","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/build-instructions","content":"本页内容与仓库 README 中的构建指南保持一致。如需完整的编译指南（Docker 编译、UFS 模块、安装包打包等），请参考下载和编译 Curvine。","locale":"zh-cn"},"5007":{"id":"/zh-cn/docs/Deploy/build-instructions-4","page_id":"/zh-cn/docs/Deploy/build-instructions","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/build-instructions","content":"本项目需要以下依赖项，请确保在继续之前已安装：","locale":"zh-cn"},"5008":{"id":"/zh-cn/docs/Deploy/build-instru