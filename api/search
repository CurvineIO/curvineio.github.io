ose                   |\n| ------------------------------------------------------ | ------------------------- |\n| `curvine-docker/deploy/spdk/curvine-cluster-spdk.toml` | SPDK worker configuration |","locale":"en","table":"table-0"},"425":{"id":"/docs/Architecture/spdk-architecture-120","page_id":"/docs/Architecture/spdk-architecture","tags":[],"type":"text","url":"/docs/Architecture/spdk-architecture#code-references","content":"[[1]] 10.39M Storage I/O Per Second From One Thread","locale":"en"},"426":{"id":"/docs/Benchmark/concurrent","page_id":"/docs/Benchmark/concurrent","type":"page","content":"Concurrent Read/Write Benchmark","breadcrumbs":["Documents","Benchmark"],"tags":[],"url":"/docs/Benchmark/concurrent","locale":"en"},"427":{"id":"/docs/Benchmark/concurrent-0","page_id":"/docs/Benchmark/concurrent","type":"heading","tags":[],"url":"/docs/Benchmark/concurrent#supported-benchmark-modes","content":"Supported benchmark modes","locale":"en"},"428":{"id":"/docs/Benchmark/concurrent-1","page_id":"/docs/Benchmark/concurrent","type":"heading","tags":[],"url":"/docs/Benchmark/concurrent#default-checked-in-workload","content":"Default checked-in workload","locale":"en"},"429":{"id":"/docs/Benchmark/concurrent-2","page_id":"/docs/Benchmark/concurrent","type":"heading","tags":[],"url":"/docs/Benchmark/concurrent#how-the-rust-benchmark-behaves","content":"How the Rust benchmark behaves","locale":"en"},"430":{"id":"/docs/Benchmark/concurrent-3","page_id":"/docs/Benchmark/concurrent","type":"heading","tags":[],"url":"/docs/Benchmark/concurrent#how-to-run","content":"How to run","locale":"en"},"431":{"id":"/docs/Benchmark/concurrent-4","page_id":"/docs/Benchmark/concurrent","type":"heading","tags":[],"url":"/docs/Benchmark/concurrent#results","content":"Results","locale":"en"},"432":{"id":"/docs/Benchmark/concurrent-5","page_id":"/docs/Benchmark/concurrent","tags":[],"type":"text","url":"/docs/Benchmark/concurrent","content":"This page reflects the benchmark wrappers in 