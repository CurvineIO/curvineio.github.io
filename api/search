ble-2"},"978":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-60","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#cluster-level-flags","content":"`format_master` deletes RocksDB metadata and `format_worker` deletes the Worker data directory. Always set both to `false` in an existing production deployment; the shipped `etc/curvine-cluster.toml` does so.","locale":"en"},"979":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-61","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#master","content":"| Field      | Default     | Meaning                                                                     |\n| ---------- | ----------- | --------------------------------------------------------------------------- |\n| `hostname` | `localhost` | Master hostname; overridden by `net_interface` or `CURVINE_MASTER_HOSTNAME` |","locale":"en","table":"table-3"},"980":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-62","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#master","content":"| Field      | Default | Meaning         |\n| ---------- | ------- | --------------- |\n| `rpc_port` | `8995`  | Master RPC port |","locale":"en","table":"table-3"},"981":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-63","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#master","content":"| Field      | Default | Meaning                   |\n| ---------- | ------- | ------------------------- |\n| `web_port` | `9001`  | Master web UI / REST port |","locale":"en","table":"table-3"},"982":{"id":"/docs/Deploy