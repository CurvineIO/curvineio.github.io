s.","locale":"en"},"1225":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-307","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"The top-level `[log]` section is shared by the Rust client and FUSE. Each service also has its own nested `log` table (`master.log`, `worker.log`, `mds.log`, `transfer.log`) and the CLI has `[cli].log`.","locale":"en"},"1226":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-308","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field   | Default | Meaning   |\n| ------- | ------- | --------- |\n| `level` | `INFO`  | Log level |","locale":"en","table":"table-9"},"1227":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-309","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field     | Default  | Meaning                                             |\n| --------- | -------- | --------------------------------------------------- |\n| `log_dir` | `stdout` | `stdout`, `stderr`, or a directory for file logging |","locale":"en","table":"table-9"},"1228":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-310","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field       | Default | Meaning                                   |\n| ----------- | ------- | ----------------------------------------- |\n| `file_name` | empty   | Base log file name; empty means `curvine` |","locale":"en","table":"table-9"},"1229":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-311","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field           | Default | Meaning               |\n| --------------- | ------- | --------------------- |\n| `max_log_files` | `10`    | Rotated files to keep |","locale":"en","table":"table-9"},"1230":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-312","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field              | Default | Meaning                                                |\n| ------------------ | ------- | ------------------------------------------------------ |\n| `max_file_size_mb` | `100`   | Size-based rotation threshold; `0` means no size limit |","locale":"en","table":"table-9"},"1231":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-313","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field           | Default | Meaning                                                 |\n| --------------- | ------- | ------------------------------------------------------- |\n| `time_rotation` | empty   | `daily` or `hourly`; empty means no time-based rotation |","locale":"en","table":"table-9"},"1232":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-314","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#global-log","content":"| Field            | Default | Meaning                    |\n| ---------------- | ------- | -------------------------- |\n| `display_thread` | `false` | Include thread name and ID |","locale":"en","table":"table-9"},"1233":{"id":