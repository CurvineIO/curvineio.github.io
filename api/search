-Cluster/Distributed-Mode/conf#webobservability","content":"| 字段                       | 默认值     | 含义         |\n| ------------------------ | ------- | ---------- |\n| `max_samples_per_series` | `10000` | 每个序列保留的样本数 |","locale":"zh-cn","table":"table-10"},"4904":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-352","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityfuse","content":"FUSE 指标抓取默认关闭。`enabled = true` 且 `targets` 为空时，采集器会抓取 `127.0.0.1:{fuse.web_port}`。","locale":"zh-cn"},"4905":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-353","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityfuse","content":"| 字段        | 默认值     | 含义                         |\n| --------- | ------- | -------------------------- |\n| `enabled` | `false` | 是否发现并抓取 FUSE `/metrics` 端点 |","locale":"zh-cn","table":"table-11"},"4906":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-354","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityfuse","content":"| 字段        | 默认值  | 含义                                             |\n| --------- | ---- | ---------------------------------------------- |\n| `targets` | `[]` | `host:port` 或完整的 `http://host:port/metrics` 地址 |","locale":"zh-cn","table":"table-11"},"4907":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-355","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityprometheus","content":"| 字段    | 默认值 | 含义                                          |\n| ----- | --- | ------------------------------------------- |\n| `url` | 空   | Prometheus 基础地址，例如 `http://prometheus:9090` |","locale":"zh-cn","table":"table-12"},"4908":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-356","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityprometheus","content":"| 字段              | 默认值  | 含义                   |\n| --------------- | ---- | -------------------- |\n| `query_timeout` | `5s` | Prometheus 查询 API 超时 |","locale":"zh-cn","table":"table-12"},"4909":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-357","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityprometheus","content":"| 字段                 | 默认值    | 含义                                        |\n| ------------------ | ------ | ----------------------------------------- |\n| `fallback_builtin` | `true` | `mode = \"auto\"` 时，Prometheus 不可用则回退到内置采集器 |","locale":"zh-cn","table":"table-12"},"4910":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-358","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityprometheus","content":"| 字段                 | 默认值   | 含义                        |\n| ------------------ | ----- | ------------------------- |\n| `target_cache_ttl` | `30s` | `/api/v1/targets` 响应的缓存时长 |","locale":"zh-cn","table":"table-12"},"4911":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-359","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#webobservabilityprometheus","content":"当 `mode = \"prometheus\"` 时，还需要按 `etc/prometheus-curvine.yml` 中的说明加上目标标签，大盘才能把指标归属到正确的角色。","locale":"zh-cn"},"4912":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-360","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"S3 兼容网关是一个独立服务（二进制 `curvine-s3-gateway`，通过 `bin/curvine-s3-gateway.sh start` 启动）。本段只被网关进程读取，Master 和 Worker 会忽略它。支持的 API 范围见 S3 对象存储网关。","locale":"zh-cn"},"4913":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-361","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段       | 默认值            | 含义           |\n| -------- | -------------- | ------------ |\n| `listen` | `0.0.0.0:9900` | S3 HTTP 监听地址 |","locale":"zh-cn","table":"table-13"},"4914":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-362","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段       | 默认值         | 含义                                       |\n| -------- | ----------- | ---------------------------------------- |\n| `region` | `us-east-1` | `GetBucketLocation` 返回的区域，也用于 SigV4 签名范围 |","locale":"zh-cn","table":"table-13"},"4915":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-363","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段             | 默认值                 | 含义                  |\n| -------------- | ------------------- | ------------------- |\n| `put_temp_dir` | `/tmp/curvine-temp` | PUT 暂存目录（分片和普通上传共用） |","locale":"zh-cn","table":"table-13"},"4916":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-364","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                            | 默认值       | 含义                                  |\n| ----------------------------- | --------- | ----------------------------------- |\n| `put_memory_buffer_threshold` | `1048576` | 低于该大小的 PUT 在内存中缓冲，不落 `put_temp_dir` |","locale":"zh-cn","table":"table-13"},"4917":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-365","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                      | 默认值        | 含义     |\n| ----------------------- | ---------- | ------ |\n| `put_max_memory_buffer` | `16777216` | 内存缓冲上限 |","locale":"zh-cn","table":"table-13"},"4918":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-366","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                          | 默认值 | 含义               |\n| --------------------------- | --- | ---------------- |\n| `access_key` / `secret_key` | 空   | 不使用分布式凭证存储时的静态密钥 |","locale":"zh-cn","table":"table-13"},"4919":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-367","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                        | 默认值     | 含义                       |\n| ------------------------- | ------- | ------------------------ |\n| `enable_distributed_auth` | `false` | 从 Curvine 加载凭证，而不是使用静态密钥 |","locale":"zh-cn","table":"table-13"},"4920":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-368","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                 | 默认值 | 含义                 |\n| ------------------ | --- | ------------------ |\n| `credentials_path` | 空   | 存放凭证文件的 Curvine 路径 |","locale":"zh-cn","table":"table-13"},"4921":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-369","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                            | 默认值  | 含义       |\n| ----------------------------- | ---- | -------- |\n| `cache_refresh_interval_secs` | `30` | 凭证缓存刷新间隔 |","locale":"zh-cn","table":"table-13"},"4922":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-370","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                  | 默认值   | 含义                        |\n| ------------------- | ----- | ------------------------- |\n| `get_chunk_size_mb` | `1.0` | 读块大小（MB），可选 `0.5`、`1`、`2` |","locale":"zh-cn","table":"table-13"},"4923":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-371","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                       | 默认值                         | 含义                                                        |\n| ------------------------ | --------------------------- | --------------------------------------------------------- |\n| `signed_chunk_spool_dir` | `/tmp/curvine-signed-spool` | 大于 16 MiB 的已签名 `aws-chunked` 记录在签名校验通过前缓存到的绝对路径目录；请使用私有目录 |","locale":"zh-cn","table":"table-13"},"4924":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-372","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段                             | 默认值                   | 含义                                                               |\n| ------------------------------ | --------------------- | ---------------------------------------------------------------- |\n| `signed_chunk_spool_max_bytes` | `10GB`（`10737418240`） | 每个网关进程的缓存上限；无法预留完整大小的记录返回 `503 SlowDown`。至少保留 5 GiB，以容纳任何合法的单条记录 |","locale":"zh-cn","table":"table-13"},"4925":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-373","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"| 字段         | 默认值    | 含义                  |\n| ---------- | ------ | ------------------- |\n| `web_port` | `9003` | 网关健康检查 / 指标 HTTP 端口 |","locale":"zh-cn","table":"table-13"},"4926":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-374","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#s3_gateway","content":"`worker.enable_s3_gateway`（默认 `false`）决定分片上传的暂存位置：`false` 时存放在网关宿主机的本地文件系统，`true` 时使用 Curvine DFS，从而允许多个网关实例共同处理同一次上传。","locale":"zh-cn"},"4927":{"id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-375","page_id":"/zh-cn/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/zh-cn/docs/Deploy/Deploy-Curv