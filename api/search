view/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#architecture-overview","content":"In addition, Curvine provides foundational components:","locale":"en"},"1992":{"id":"/docs/Overview/architecture-45","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#architecture-overview","content":"**orpc**: High-performance RPC framework (Tokio-based, zero-copy)","locale":"en"},"1993":{"id":"/docs/Overview/architecture-46","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#architecture-overview","content":"**curvine-web**: Admin UI and cluster management","locale":"en"},"1994":{"id":"/docs/Overview/architecture-47","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#architecture-overview","content":"**Metrics**: Prometheus-based monitoring (master/worker/client, job, cache)","locale":"en"},"1995":{"id":"/docs/Overview/architecture-48","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#architecture-overview","content":"For deployment topology and component roles, see Deployment Architecture. For internal data flow (journal, replay, client read/write), see Basic Architecture.","locale":"en"},"1996":{"id":"/docs/Overview/architecture-49","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"To achieve high performance, high concurrency, and low resource consumption, Curvine adopts the following technologies and design principles:","locale":"en"},"1997":{"id":"/docs/Overview/architecture-50","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"**Pure Rust Implementation**: Curvine is implemented entirely in Rust, avoiding performance bottlenecks and resource consumption of traditional languages while ensuring code safety and stability","locale":"en"},"1998":{"id":"/docs/Overview/architecture-51","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"**High-Performance RPC Framework**: Curvine implements a custom RPC communication framework supporting efficient data transmission with asynchronous I/O and zero-copy implementation within the framework","locale":"en"},"1999":{"id":"/docs/Overview/architecture-52","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"**Zero-Cost Abstractions**: Zero-cost abstraction design where core modules directly interface with underlying systems, avoiding unnecessary abstraction layers and improving system performance and resource utilization","locale":"en"},"2000":{"id":"/docs/Overview/architecture-53","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"**Asynchronous I/O**: Asynchronous I/O design fully utilizes system resources, avoiding blocking waits and improving system concurrent processing capabilities","locale":"en"},"2001":{"id":"/docs/Overview/architecture-54","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-performance-design","content":"**Zero-Copy**: Zero-copy design avoids data copying and memory allocation, reducing system memory usage and resource consumption","locale":"en"},"2002":{"id":"/docs/Overview/architecture-55","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-availability-design","content":"Curvine adopts distributed architecture design with multi-replica mechanisms and failover mechanisms to ensure system high availability:","locale":"en"},"2003":{"id":"/docs/Overview/architecture-56","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-availability-design","content":"**Raft Protocol**: Uses Raft protocol to implement distributed consistency, ensuring data consistency and reliability","locale":"en"},"2004":{"id":"/docs/Overview/architecture-57","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-availability-design","content":"**Automatic Failover**: Automatic failover mechanism that switches to backup nodes when primary nodes fail, ensuring system high availability","locale":"en"},"2005":{"id":"/docs/Overview/architecture-58","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-availability-design","content":"**Multi-Replica Mechanism**: Multi-replica mechanism ensures data redundancy backup, improving system reliability and fault tolerance","locale":"en"},"2006":{"id":"/docs/Overview/architecture-59","page_id":"/docs/Overview/architecture","tags":[],"type":"text","url":"/docs/Overview/architecture#high-availability-design","content":"**Snapshot Mechanism**: Lightweight snapshot mechanism for periodic data backup, improving system recovery speed and stability","locale":"en"},"2007":{"id":"/docs/Overview","page_id":"/docs/Overview","type":"page","content":"Overview","breadcrumbs":["Documents","Overview"],"tags":[],"url":"/docs/Overview","locale":"en"},"2008":{"id":"/docs/Overview/introduction","page_id":"/docs/Overview/introduction","type":"page","content":"Curvine Overview","breadcrumbs":["Documents","Overview"],"tags":[],"url":"/docs/Overview/introduction","locale":"en"},"2009":{"id":"/docs/Overview/introduction-0","page_id":"/docs/Overview/introduction","type":"heading","tags":[],"url":"/docs/Overview/introduction#core-features","content":"Core Features","locale":"en"},"2010":{"id":"/docs/Overview/introduction-1","page_id":"/docs/Overview/introduction","type":"heading","tags":[],"url":"/docs/Overview/introduction#use-cases","content":"Use Cases","locale":"en"},"2011":{