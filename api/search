g","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#61-write-strategies","content":"6.1 Write Strategies","locale":"en"},"2215":{"id":"/docs/User-Manuals/Key-Features/cache-12","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#62-read-verification","content":"6.2 Read Verification","locale":"en"},"2216":{"id":"/docs/User-Manuals/Key-Features/cache-13","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#7-data-expiration-management-ttl","content":"7. Data Expiration Management (TTL)","locale":"en"},"2217":{"id":"/docs/User-Manuals/Key-Features/cache-14","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#71-basic-configuration-example","content":"7.1 Basic Configuration Example","locale":"en"},"2218":{"id":"/docs/User-Manuals/Key-Features/cache-15","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"7.2 Per-Mount TTL","locale":"en"},"2219":{"id":"/docs/User-Manuals/Key-Features/cache-16","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#73-expiration-actions","content":"7.3 Expiration Actions","locale":"en"},"2220":{"id":"/docs/User-Manuals/Key-Features/cache-17","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#74-notes-mtime-and-data-copy","content":"7.4 Notes: mtime and Data Copy","locale":"en"},"2221":{"id":"/docs/User-Manuals/Key-Features/cache-18","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"7.5 Master TTL Checker","locale":"en"},"2222":{"id":"/docs/User-Manuals/Key-Features/cache-19","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#76-execution-flow","content":"7.6 Execution Flow","locale":"en"},"2223":{"id":"/docs/User-Manuals/Key-Features/cache-20","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#8-data-eviction-quota-and-lru","content":"8. Data Eviction: Quota and LRU","locale":"en"},"2224":{"id":"/docs/User-Manuals/Key-Features/cache-21","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#81-how-it-works","content":"8.1 How It Works","locale":"en"},"2225":{"id":"/docs/User-Manuals/Key-Features/cache-22","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#82-configuration-example","content":"8.2 Configuration Example","locale":"en"},"2226":{"id":"/docs/User-Manuals/Key-Features/cache-23","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#83-relationship-with-ttl","content":"8.3 Relationship with TTL","locale":"en"},"2227":{"id":"/docs/User-Manuals/Key-Features/cache-24","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#9-caching-methods","content":"9. Caching Methods","locale":"en"},"2228":{"id":"/docs/User-Manuals/Key-Features/cache-25","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#91-automatic-caching","content":"9.1 Automatic Caching","locale":"en"},"2229":{"id":"/docs/User-Manuals/Key-Features/cache-26","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#92-proactive-caching","content":"9.2 Proactive Caching","locale":"en"},"2230":{"id":"/docs/User-Manuals/Key-Features/cache-27","page_id":"/docs/User-Manuals/Key-Features/cache","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"10. Quick Summary","locale":"en"},"2231":{"id":"/docs/User-Manuals/Key-Features/cache-28","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache","content":"For first-time users, Curvine can be understood as a distributed file cache that can be used like a local disk. Users do not need to care which machine in the cluster stores the data or which storage type is used. Through a single mount point, users can easily use distributed caching capabilities for most daily file operation scenarios.","locale":"en"},"2232":{"id":"/docs/User-Manuals/Key-Features/cache-29","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#1-what-is-curvine","content":"Curvine is a distributed file cache system. It integrates storage media inside the cluster and remote storage resources to build a unified file directory space, and provides a directly mountable filesystem to external users.","locale":"en"},"2233":{"id":"/docs/User-Manuals/Key-Features/cache-30","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#1-what-is-curvine","content":"Unlike traditional distributed filesystems, Curvine's biggest highlight is full compatibility with POSIX semantics. Its user experience is almost the same as a local disk. Users do not need to learn complex extra commands or modify existing applications. Whether for daily development, data caching, `git clone`, database file storage, log writing, or temporary file storage, users only need to point file paths to the Curvine mount point.","locale":"en"},"2234":{"id":"/docs/User-Manuals/Key-Features/cache-31","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#2-core-features","content":"| Core Capability   | Plain Explanation                                                                                                                                                                                         |\n| ----------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Unified namespace | A single mount point can access all file directories. Users do not need to care which Worker node or storage medium stores the data. File paths and permissions are consistent with the local filesystem. |","locale":"en","table":"table-0"},"2235":{"id":"/docs/User-Manuals/Key-Features/cache-32","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#2-core-features","content":"| Core Capability                               | Plain Explanation                                                                                                                                                                             |\n| --------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| High-speed cache for smoother repeated access | Frequently used working data stays on faster media inside the cluster. Repeated access greatly reduces I/O requests to remote or slower storage, making file open and read operations faster. |","locale":"en","table":"table-0"},"2236":{"id":"/docs/User-Manuals/Key-Features/cache-33","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#2-core-features","content":"| Core Capability            | Plain Explanation                                                                                                                                                                                                                                                    |\n| -------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Intelligent tiered storage | Supports multiple storage tiers such as memory (MEM), SSD, and HDD. Administrators configure paths for each tier in advance, and users can specify the preferred write medium. When the preferred tier lacks space, data automatically spills over to the next tier. |","locale":"en","table":"table-0"},"2237":{"id":"/docs/User-Manuals/Key-Features/cache-34","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#2-core-features","content":"| Core Capability              | Plain Explanation                                                                                                                       |\n| ---------------------------- | --------------------------------------------------------------------------------------------------------------------------------------- |\n| Intelligent space management | Uses TTL expiration and quota plus LRU eviction to manage storage space, preventing cache from occupying cluster capacity indefinitely. |","locale":"en","table":"table-0"},"2238":{"id":"/docs/User-Manuals/Key-Features/cache-35","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#2-core-features","content":"| Core Capability               | Plain Explanation                                                                                                                                                                                                           |\n| ----------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Complete POSIX file semantics | Supports standard file operations, including random writes, concurrent writes, file locks, extended attributes, symbolic and hard links, sparse files, and preallocation. Existing local applications can migrate directly. |","locale":"en","table":"table-0"},"2239":{"id":"/docs/User-Manuals/Key-Features/cache-36","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#3-local-disk-like-user-experience","content":"Curvine follows local disk usage habits.","locale":"en"},"2240":{"id":"/docs/User-Manuals/Key-Features/cache-37","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#31-multi-process-concurrent-writes","content":"Multiple clients and processes can write to the same file at the same time. Applications do not need to coordinate this themselves. As long as writes target different file offsets, data will not become inconsistent, matching local multi-process file write semantics.","locale":"en"},"2241":{"id":"/docs/User-Manuals/Key-Features/cache-38","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#32-free-random-writes","content":"Curvine is not limited to sequential or append-only writes. It supports writing at any file position at any time, which fits scenarios such as databases and large-file modification that require random reads and writes.","locale":"en"},"2242":{"id":"/docs/User-Manuals/Key-Features/cache-39","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#33-common-commands-are-fully-compatible","content":"Common Linux file commands such as `cp`, `mv`, `rm`, `mkdir`, `ls`, and `find` can be used normally on the Curvine mount point. Users do not need to change their operation habits.","locale":"en"},"2243":{"id":"/docs/User-Manuals/Key-Features/cache-40","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"Curvine supports advanced POSIX features to meet complex business requirements.","locale":"en"},"2244":{"id":"/docs/User-Manuals/Key-Features/cache-41","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature                             | Description                                                                                                                                                                           |\n| ----------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Random writes and concurrent writes | Supports writing at any file position. Multiple clients can operate different regions of the same file at the same time, fitting logs, databases, and other flexible write scenarios. |","locale":"en","table":"table-1"},"2245":{"id":"/docs/User-Manuals/Key-Features/cache-42","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature                       | Description                                                                                                           |\n| ----------------------------- | --------------------------------------------------------------------------------------------------------------------- |\n| Extended attributes (`xattr`) | Supports file extended attributes, allowing users to store custom metadata for file tagging and business association. |","locale":"en","table":"table-1"},"2246":{"id":"/docs/User-Manuals/Key-Features/cache-43","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature        | Description                                                                                                                                                                                                           |\n| -------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Symbolic links | Supports symbolic links. It is recommended that link targets point to Curvine internal paths. If a link points to a local path on one machine, other nodes may not be able to access it in a distributed environment. |","locale":"en","table":"table-1"},"2247":{"id":"/docs/User-Manuals/Key-Features/cache-44","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature    | Description                                                                                                                                          |\n| ---------- | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Hard links | Supports hard links with semantics consistent with local filesystems. This only applies inside the same Curvine filesystem and cannot cross systems. |","locale":"en","table":"table-1"},"2248":{"id":"/docs/User-Manuals/Key-Features/cache-45","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature    | Description                                                                                                                                                                                        |\n| ---------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| File locks | Compatible with POSIX locks and BSD locks. In a distributed environment, file locks have a default 5-minute timeout auto-release mechanism to avoid deadlocks caused by abnormal clients or nodes. |","locale":"en","table":"table-1"},"2249":{"id":"/docs/User-Manuals/Key-Features/cache-46","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature      | Description                                                                                                                             |\n| ------------ | --------------------------------------------------------------------------------------------------------------------------------------- |\n| Sparse files | Supports sparse files. Hole regions without actual written data do not occupy physical storage space, saving cluster storage resources. |","locale":"en","table":"table-1"},"2250":{"id":"/docs/User-Manuals/Key-Features/cache-47","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature             | Description                                                                                                                         |\n| ------------------- | ----------------------------------------------------------------------------------------------------------------------------------- |\n| Space preallocation | Supports preallocating storage space for files, avoiding insufficient space during large file writes and improving write stability. |","locale":"en","table":"table-1"},"2251":{"id":"/docs/User-Manuals/Key-Features/cache-48","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#4-posix-advanced-features","content":"| Feature                | Description                                                                                                           |\n| ---------------------- | --------------------------------------------------------------------------------------------------------------------- |\n| Common file attributes | Basic inode semantics such as permission bits, access/modification timestamps, and truncation follow POSIX standards. |","locale":"en","table":"table-1"},"2252":{"id":"/docs/User-Manuals/Key-Features/cache-49","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#5-tiered-storage-usage","content":"Curvine supports multiple storage media tiers. With simple configuration, users can specify data storage priority to balance speed and cost.","locale":"en"},"2253":{"id":"/docs/User-Manuals/Key-Features/cache-50","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#51-how-it-works","content":"Worker nodes configure storage tier paths and labels. Users specify the preferred storage type on the client. Data is written to the target tier first. When that tier lacks capacity, data automatically falls back to the next tier without manual intervention.","locale":"en"},"2254":{"id":"/docs/User-Manuals/Key-Features/cache-51","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#52-configuration-example","content":"Worker configuration:","locale":"en"},"2255":{"id":"/docs/User-Manuals/Key-Features/cache-52","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#52-configuration-example","content":"Client configuration:","locale":"en"},"2256":{"id":"/docs/User-Manuals/Key-Features/cache-53","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#52-configuration-example","content":"Configuration effect: newly created files are stored in the memory tier first. When memory is insufficient, data automatically falls back to SSD and then HDD.","locale":"en"},"2257":{"id":"/docs/User-Manuals/Key-Features/cache-54","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#61-write-strategies","content":"Write strategies control how data is written for mounted paths. They are configured per mount through `cv mount ... --write-type <type>`. The CLI default is `fs_mode`.","locale":"en"},"2258":{"id":"/docs/User-Manuals/Key-Features/cache-55","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#61-write-strategies","content":"| Strategy  | CLI Value    | Behavior                                                                                                  | Use Case                                           |\n| --------- | ------------ | --------------------------------------------------------------------------------------------------------- | -------------------------------------------------- |\n| CacheMode | `cache_mode` | Writes through to the underlying UFS path. Curvine mainly acts as a unified-access and cached-read layer. | Data whose primary source of truth remains in UFS. |","locale":"en","table":"table-2"},"2259":{"id":"/docs/User-Manuals/Key-Features/cache-56","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#61-write-strategies","content":"| Strategy | CLI Value | Behavior                                                                                | Use Case                                            |\n| -------- | --------- | --------------------------------------------------------------------------------------- | --------------------------------------------------- |\n| FsMode   | `fs_mode` | Writes into the Curvine namespace first. The first mount may trigger metadata `resync`. | Curvine-managed cached namespace over mounted data. |","locale":"en","table":"table-2"},"2260":{"id":"/docs/User-Manuals/Key-Features/cache-57","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#62-read-verification","content":"The current read-side validation control is `--read-verify-ufs` on the mount:","locale":"en"},"2261":{"id":"/docs/User-Manuals/Key-Features/cache-58","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#62-read-verification","content":"| Strategy | Behavior                                                                   |\n| -------- | -------------------------------------------------------------------------- |\n| disabled | Cached data is trusted and normal unified filesystem fallback rules apply. |","locale":"en","table":"table-3"},"2262":{"id":"/docs/User-Manuals/Key-Features/cache-59","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#62-read-verification","content":"| Strategy | Behavior                                                                                                          |\n| -------- | ----------------------------------------------------------------------------------------------------------------- |\n| enabled  | On reads, Curvine compares cached file metadata against UFS (`mtime` and file length) before serving cached data. |","locale":"en","table":"table-3"},"2263":{"id":"/docs/User-Manuals/Key-Features/cache-60","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#62-read-verification","content":"When validation fails, or when the cache misses, data is read directly from UFS. If automatic caching is enabled for that mount, Curvine can also submit a background load job. With `[transfer] enabled = true`, that job is owned by the standalone Transfer service; otherwise it uses the legacy Master job path.","locale":"en"},"2264":{"id":"/docs/User-Manuals/Key-Features/cache-61","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#7-data-expiration-management-ttl","content":"To manage cache space properly, Curvine supports configuring expiration time and expiration actions for files and directories.","locale":"en"},"2265":{"id":"/docs/User-Manuals/Key-Features/cache-62","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#71-basic-configuration-example","content":"Configuration effect: the file expiration time is calculated from the last modification time (`mtime`). After 1 day, the file expires and the delete action is executed.","locale":"en"},"2266":{"id":"/docs/User-Manuals/Key-Features/cache-63","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"When mounting UFS with `cv mount`, TTL can be set for that mount:","locale":"en"},"2267":{"id":"/docs/User-Manuals/Key-Features/cache-64","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"| Option     | Type     | Default | Description                | Example            |\n| ---------- | -------- | ------- | -------------------------- | ------------------ |\n| `--ttl-ms` | duration | `7d`    | Cache data expiration time | `24h`, `7d`, `30d` |","locale":"en","table":"table-4"},"2268":{"id":"/docs/User-Manuals/Key-Features/cache-65","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"For mount points, the expiration action is derived from `write_type`:","locale":"en"},"2269":{"id":"/docs/User-Manuals/Key-Features/cache-66","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"`cache_mode` mounts default to `delete`","locale":"en"},"2270":{"id":"/docs/User-Manuals/Key-Features/cache-67","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#72-per-mount-ttl","content":"`fs_mode` mounts default to `free`","locale":"en"},"2271":{"id":"/docs/User-Manuals/Key-Features/cache-68","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#73-expiration-actions","content":"| Action | Meaning                                                                                               |\n| ------ | ----------------------------------------------------------------------------------------------------- |\n| `none` | Disables time-based expiration. Data is retained until manually deleted or cleaned by other policies. |","locale":"en","table":"table-5"},"2272":{"id":"/docs/User-Manuals/Key-Features/cache-69","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#73-expiration-actions","content":"| Action   | Meaning                                                                                                                                                  |\n| -------- | -------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `delete` | Deletes file data and metadata after expiration. This is the most common expiration cleanup strategy, calculated from the file's last modification time. |","locale":"en","table":"table-5"},"2273":{"id":"/docs/User-Manuals/Key-Features/cache-70","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#73-expiration-actions","content":"| Action | Meaning                                                                                                                                                                                     |\n| ------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `free` | Releases only file data blocks after expiration while preserving directories and metadata. This is suitable for scenarios that need to keep directory structure while cleaning cached data. |","locale":"en","table":"table-5"},"2274":{"id":"/docs/User-Manuals/Key-Features/cache-71","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#74-notes-mtime-and-data-copy","content":"When using tools such as `rclone` to copy files to Curvine, the tool may preserve the original modification time (`mtime`) of the source file. If the source file has existed for a long time, it may immediately trigger TTL expiration after being copied, causing the file to be deleted or freed.","locale":"en"},"2275":{"id":"/docs/User-Manuals/Key-Features/cache-72","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#74-notes-mtime-and-data-copy","content":"Before large-scale data import, confirm the TTL configuration, manually adjust file `mtime` after import, or temporarily disable TTL to avoid accidental cleanup.","locale":"en"},"2276":{"id":"/docs/User-Manuals/Key-Features/cache-73","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"In the `[master]` section of the cluster configuration, use the following TOML keys:","locale":"en"},"2277":{"id":"/docs/User-Manuals/Key-Features/cache-74","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"| Parameter              | Type     | Default | Description                             |\n| ---------------------- | -------- | ------- | --------------------------------------- |\n| `ttl_checker_interval` | duration | `1h`    | Interval at which the TTL checker runs. |","locale":"en","table":"table-6"},"2278":{"id":"/docs/User-Manuals/Key-Features/cache-75","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"| Parameter                    | Type | Default | Description                                       |\n| ---------------------------- | ---- | ------- | ------------------------------------------------- |\n| `ttl_checker_retry_attempts` | u32  | `3`     | Maximum retry attempts for failed TTL operations. |","locale":"en","table":"table-6"},"2279":{"id":"/docs/User-Manuals/Key-Features/cache-76","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"| Parameter             | Type     | Default | Description                                  |\n| --------------------- | -------- | ------- | -------------------------------------------- |\n| `ttl_bucket_interval` | duration | `1h`    | Bucket interval for batching expired inodes. |","locale":"en","table":"table-6"},"2280":{"id":"/docs/User-Manuals/Key-Features/cache-77","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"| Parameter                | Type     | Default | Description                                          |\n| ------------------------ | -------- | ------- | ---------------------------------------------------- |\n| `ttl_max_retry_duration` | duration | `10m`   | Maximum duration for retrying failed TTL operations. |","locale":"en","table":"table-6"},"2281":{"id":"/docs/User-Manuals/Key-Features/cache-78","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#75-master-ttl-checker","content":"| Parameter            | Type     | Default | Description                      |\n| -------------------- | -------- | ------- | -------------------------------- |\n| `ttl_retry_interval` | duration | `1s`    | Interval between retry attempts. |","locale":"en","table":"table-6"},"2282":{"id":"/docs/User-Manuals/Key-Features/cache-79","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#8-data-eviction-quota-and-lru","content":"In addition to time-based expiration, Curvine supports automatic eviction based on storage quotas to prevent cluster storage from being filled and to keep the system stable.","locale":"en"},"2283":{"id":"/docs/User-Manuals/Key-Features/cache-80","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#81-how-it-works","content":"After quota eviction is enabled, when cluster storage usage reaches the configured high watermark, the system automatically cleans data that has not been accessed for a long time according to the LRU rule until storage usage returns to a safe range.","locale":"en"},"2284":{"id":"/docs/User-Manuals/Key-Features/cache-81","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#83-relationship-with-ttl","content":"If `ttl_action = \"none\"` is configured, disabling time-based expiration, the data will not be evicted and deleted by the quota LRU mechanism. This is suitable for important data that needs to be retained for a long time.","locale":"en"},"2285":{"id":"/docs/User-Manuals/Key-Features/cache-82","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#91-automatic-caching","content":"Automatic caching is enabled for a mount when that mount has a non-zero TTL, for example `cv mount s3://bucket/prefix /path --ttl-ms 7d`. On the first read of a UFS file under that mount, Curvine submits an asynchronous load job to bring the data into Curvine. The read is served from UFS while the job runs in the background. The job follows the same Transfer routing as a manual `cv load` command.","locale":"en"},"2286":{"id":"/docs/User-Manuals/Key-Features/cache-83","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#91-automatic-caching","content":"Example log output:","locale":"en"},"2287":{"id":"/docs/User-Manuals/Key-Features/cache-84","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#91-automatic-caching","content":"When the client has Transfer enabled, automatic caching creates a Transfer job.\nUse the job ID to query its status:","locale":"en"},"2288":{"id":"/docs/User-Manuals/Key-Features/cache-85","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#91-automatic-caching","content":"`load-status` remains a compatibility command. A client without Transfer\nenabled continues to query the legacy Master job path.","locale":"en"},"2289":{"id":"/docs/User-Manuals/Key-Features/cache-86","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#92-proactive-caching","content":"Mount the UFS first, then proactively load its Curvine path:","locale":"en"},"2290":{"id":"/docs/User-Manuals/Key-Features/cache-87","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#92-proactive-caching","content":"Automatic caching and proactive caching are not mutually exclusive. Proactive caching can reduce the time required for the first read of a UFS file.","locale":"en"},"2291":{"id":"/docs/User-Manuals/Key-Features/cache-88","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#92-proactive-caching","content":"With Transfer enabled in the client configuration, `cv load` automatically\nsubmits a Transfer job. Use `cv transfer list` and `cv transfer status <job_id>`\nfor job-wide operations. Deployment and client routing are described in\nTransfer Service.","locale":"en"},"2292":{"id":"/docs/User-Manuals/Key-Features/cache-89","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#92-proactive-caching","content":"Before loading data, the UFS must first be mounted to Curvine with `cv mount`.\nAutomatic and proactive caching both store files at fixed cache paths and maintain the same directory structure as the UFS.","locale":"en"},"2293":{"id":"/docs/User-Manuals/Key-Features/cache-90","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension           | Curvine Key Point                                                                              |\n| ------------------- | ---------------------------------------------------------------------------------------------- |\n| Product positioning | Distributed file cache with POSIX mounting, with a user experience equivalent to a local disk. |","locale":"en","table":"table-7"},"2294":{"id":"/docs/User-Manuals/Key-Features/cache-91","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension       | Curvine Key Point                                                                                        |\n| --------------- | -------------------------------------------------------------------------------------------------------- |\n| Core advantages | Unified namespace, intelligent tiered storage, TTL + LRU space management, and complete POSIX semantics. |","locale":"en","table":"table-7"},"2295":{"id":"/docs/User-Manuals/Key-Features/cache-92","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension        | Curvine Key Point                                                           |\n| ---------------- | --------------------------------------------------------------------------- |\n| Write capability | Supports random writes and multi-client concurrent writes to the same file. |","locale":"en","table":"table-7"},"2296":{"id":"/docs/User-Manuals/Key-Features/cache-93","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension         | Curvine Key Point                                                                                                 |\n| ----------------- | ----------------------------------------------------------------------------------------------------------------- |\n| Advanced features | Supports extended attributes, symbolic and hard links, timeout-based file locks, sparse files, and preallocation. |","locale":"en","table":"table-7"},"2297":{"id":"/docs/User-Manuals/Key-Features/cache-94","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension          | Curvine Key Point                                                                                                          |\n| ------------------ | -------------------------------------------------------------------------------------------------------------------------- |\n| Storage management | Multi-media tiered storage. The client can specify priority, and data falls back automatically when space is insufficient. |","locale":"en","table":"table-7"},"2298":{"id":"/docs/User-Manuals/Key-Features/cache-95","page_id":"/docs/User-Manuals/Key-Features/cache","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/cache#10-quick-summary","content":"| Dimension        | Curvine Key Point                                              |\n| ---------------- | -------------------------------------------------------------- |\n| Space management | `mtime`-based TTL expiration plus optional quota LRU eviction. |","locale":"en","table":"table-7"},"2299":{"id":"/docs/User-Manuals/Key-Features/fuse","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"page","content":"FUSE","breadcrumbs":["Documents","User Manuals","Key Features"],"tags":[],"url":"/docs/User-Manuals/Key-Features/fuse","locale":"en"},"2300":{"id":"/docs/User-Manuals/Key-Features/fuse-0","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#1-basic-understanding-of-fuse","content":"1. Basic Understanding of FUSE","locale":"en"},"2301":{"id":"/docs/User-Manuals/Key-Features/fuse-1","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#1-what-is-fuse","content":"1. What Is FUSE?","locale":"en"},"2302":{"id":"/docs/User-Manuals/Key-Features/fuse-2","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#2-core-role-of-fuse-in-curvine","content":"2. Core Role of FUSE in Curvine","locale":"en"},"2303":{"id":"/docs/User-Manuals/Key-Features/fuse-3","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#2-data-consistency","content":"2. Data Consistency","locale":"en"},"2304":{"id":"/docs/User-Manuals/Key-Features/fuse-4","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#1-conventional-distributed-storage-close-to-open-semantics","content":"1. Conventional Distributed Storage: Close-to-Open Semantics","locale":"en"},"2305":{"id":"/docs/User-Manuals/Key-Features/fuse-5","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#2-curvine-consistency-visible-after-flush","content":"2. Curvine Consistency: Visible After Flush","locale":"en"},"2306":{"id":"/docs/User-Manuals/Key-Features/fuse-6","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#3-notes-on-concurrent-reads-and-writes","content":"3. Notes on Concurrent Reads and Writes","locale":"en"},"2307":{"id":"/docs/User-Manuals/Key-Features/fuse-7","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#3-metadata-cache","content":"3. Metadata Cache","locale":"en"},"2308":{"id":"/docs/User-Manuals/Key-Features/fuse-8","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"1. Kernel Metadata Cache","locale":"en"},"2309":{"id":"/docs/User-Manuals/Key-Features/fuse-9","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#2-client-metadata-cache","content":"2. Client Metadata Cache","locale":"en"},"2310":{"id":"/docs/User-Manuals/Key-Features/fuse-10","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#3-comparison-and-usage-recommendations","content":"3. Comparison and Usage Recommendations","locale":"en"},"2311":{"id":"/docs/User-Manuals/Key-Features/fuse-11","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#4-data-cache","content":"4. Data Cache","locale":"en"},"2312":{"id":"/docs/User-Manuals/Key-Features/fuse-12","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-page-cache","content":"1. Kernel Page Cache","locale":"en"},"2313":{"id":"/docs/User-Manuals/Key-Features/fuse-13","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#2-kernel-writeback-cache","content":"2. Kernel Writeback Cache","locale":"en"},"2314":{"id":"/docs/User-Manuals/Key-Features/fuse-14","page_id":"/docs/User-Manuals/Key-Features/fuse","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/fuse#5-fuse-version-selection","content":"5. FUSE Version Selection","locale":"en"},"2315":{"id":"/docs/User-Manuals/Key-Features/fuse-15","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-what-is-fuse","content":"FUSE stands for Filesystem in Userspace. It is a general mechanism provided by the Linux kernel. Its biggest advantage is that it turns distributed or custom storage into an operating experience like a local disk.","locale":"en"},"2316":{"id":"/docs/User-Manuals/Key-Features/fuse-16","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-core-role-of-fuse-in-curvine","content":"FUSE is the most important and most general API entry point of Curvine, and it is also the simplest way to access Curvine:","locale":"en"},"2317":{"id":"/docs/User-Manuals/Key-Features/fuse-17","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-core-role-of-fuse-in-curvine","content":"Zero-code-change usage: users do not need to modify business code or perform extra adaptation. Like operating a local C drive or D drive, users can operate Curvine storage through system-native file commands such as `ls`, `cat`, `vim`, and `git`.","locale":"en"},"2318":{"id":"/docs/User-Manuals/Key-Features/fuse-18","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-core-role-of-fuse-in-curvine","content":"High-performance foundation: Curvine is based on Rust and has fully asynchronously reconstructed FUSE. It only depends on the kernel-native FUSE module and has no extra redundant dependencies. This is the core underlying guarantee for supporting high concurrency and high performance.","locale":"en"},"2319":{"id":"/docs/User-Manuals/Key-Features/fuse-19","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-conventional-distributed-storage-close-to-open-semantics","content":"Most distributed storage systems follow Close-to-Open by default: after a file is written, the written data becomes visible to other clients only after the file is closed. Content written in the middle is not exposed.","locale":"en"},"2320":{"id":"/docs/User-Manuals/Key-Features/fuse-20","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-curvine-consistency-visible-after-flush","content":"Curvine does not follow Close-to-Open. Instead, it is fully consistent with local disk file semantics:","locale":"en"},"2321":{"id":"/docs/User-Manuals/Key-Features/fuse-21","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-curvine-consistency-visible-after-flush","content":"Core rule: as long as data is flushed to storage, it immediately becomes visible to all clients without waiting for the file to be closed.","locale":"en"},"2322":{"id":"/docs/User-Manuals/Key-Features/fuse-22","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-curvine-consistency-visible-after-flush","content":"Core value: this is the key for Curvine to support complex application scenarios such as `git clone` and database storage, which require file semantics fully consistent with local disks.","locale":"en"},"2323":{"id":"/docs/User-Manuals/Key-Features/fuse-23","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-notes-on-concurrent-reads-and-writes","content":"Curvine supports multiple clients concurrently reading and writing the same file, but it has clear characteristics:","locale":"en"},"2324":{"id":"/docs/User-Manuals/Key-Features/fuse-24","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-notes-on-concurrent-reads-and-writes","content":"To fully support POSIX semantics, Curvine removes write protection.","locale":"en"},"2325":{"id":"/docs/User-Manuals/Key-Features/fuse-25","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-notes-on-concurrent-reads-and-writes","content":"Risk point: without write protection, if multiple clients write to the same file at the same time, data overwrite or dirty reads may occur.","locale":"en"},"2326":{"id":"/docs/User-Manuals/Key-Features/fuse-26","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-notes-on-concurrent-reads-and-writes","content":"One-sentence summary of the difference: Curvine consistency equals local disk semantics, sacrificing part of write protection in exchange for concurrency and random write capability. Other distributed storage systems use write protection plus Close-to-Open, sacrificing visibility in exchange for strong consistency.","locale":"en"},"2327":{"id":"/docs/User-Manuals/Key-Features/fuse-27","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-metadata-cache","content":"Metadata can be simply understood as the identity information of a file, such as file name, size, permission, modification time, and file or directory type. Caching metadata can greatly improve file query performance. Curvine divides metadata cache into kernel metadata cache and client metadata cache.","locale":"en"},"2328":{"id":"/docs/User-Manuals/Key-Features/fuse-28","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"The Curvine FUSE client can control kernel-level metadata cache through configuration. The default cache time is 1 second, which significantly improves query efficiency.","locale":"en"},"2329":{"id":"/docs/User-Manuals/Key-Features/fuse-29","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"Core configuration parameters:","locale":"en"},"2330":{"id":"/docs/User-Manuals/Key-Features/fuse-30","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"| Configuration Item | Default Value | Function                                                      |\n| ------------------ | ------------- | ------------------------------------------------------------- |\n| `attr_timeout`     | 1 second      | File attribute cache time, accelerating `getattr` operations. |","locale":"en","table":"table-0"},"2331":{"id":"/docs/User-Manuals/Key-Features/fuse-31","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"| Configuration Item | Default Value | Function                                                          |\n| ------------------ | ------------- | ----------------------------------------------------------------- |\n| `entry_timeout`    | 1 second      | File/directory type cache time, accelerating `lookup` operations. |","locale":"en","table":"table-0"},"2332":{"id":"/docs/User-Manuals/Key-Features/fuse-32","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"| Configuration Item | Default Value | Function                                                                                |\n| ------------------ | ------------- | --------------------------------------------------------------------------------------- |\n| `negative_timeout` | 1 second      | Cache time for failed queries of nonexistent files, avoiding repeated invalid requests. |","locale":"en","table":"table-0"},"2333":{"id":"/docs/User-Manuals/Key-Features/fuse-33","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"Cache meaning:","locale":"en"},"2334":{"id":"/docs/User-Manuals/Key-Features/fuse-34","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"When accessing a path such as `/a/b/c.log`, the kernel looks up `/`, `/a`, `/a/b`, and `/a/b/c.log` in sequence. Without cache, more than 4 remote RPC requests are required. With cache, data is directly retrieved from the kernel. In massive small-file scenarios, the performance improvement is extremely obvious. When file data does not change frequently, the cache time can be appropriately increased.","locale":"en"},"2335":{"id":"/docs/User-Manuals/Key-Features/fuse-35","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"Core characteristics:","locale":"en"},"2336":{"id":"/docs/User-Manuals/Key-Features/fuse-36","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"Reduces context switching between kernel mode and user mode. When the cache hits, the Curvine user-space program is not accessed.","locale":"en"},"2337":{"id":"/docs/User-Manuals/Key-Features/fuse-37","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-metadata-cache","content":"Only accelerates a few interfaces such as `lookup` and `getattr`, and the cached content is limited.","locale":"en"},"2338":{"id":"/docs/User-Manuals/Key-Features/fuse-38","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-client-metadata-cache","content":"The client-level cache developed by Curvine itself caches more complete content than kernel cache:","locale":"en"},"2339":{"id":"/docs/User-Manuals/Key-Features/fuse-39","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-client-metadata-cache","content":"Caches complete file attributes, file block information, and all file lists under directories.","locale":"en"},"2340":{"id":"/docs/User-Manuals/Key-Features/fuse-40","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-client-metadata-cache","content":"Advantage: repeatedly opening the same file does not require accessing the metadata service, greatly reducing remote RPC calls.","locale":"en"},"2341":{"id":"/docs/User-Manuals/Key-Features/fuse-41","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-client-metadata-cache","content":"Limitation: it only guarantees data consistency within a single client. Files created by the current client can be seen immediately by itself. Files created by other clients can only be seen after the current client's cache expires.","locale":"en"},"2342":{"id":"/docs/User-Manuals/Key-Features/fuse-42","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-comparison-and-usage-recommendations","content":"Kernel cache: reduces kernel-mode switching and only accelerates part of the interfaces. It delivers the best performance when the full page cache hits.","locale":"en"},"2343":{"id":"/docs/User-Manuals/Key-Features/fuse-43","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-comparison-and-usage-recommendations","content":"Client cache: caches complete content and reduces RPCs, but cannot reduce mode switching.","locale":"en"},"2344":{"id":"/docs/User-Manuals/Key-Features/fuse-44","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#3-comparison-and-usage-recommendations","content":"Usage: either cache can be used independently, or both can be used together. Adjust flexibly according to the business scenario.","locale":"en"},"2345":{"id":"/docs/User-Manuals/Key-Features/fuse-45","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-page-cache","content":"Principle: the kernel caches file data that has already been read into memory page cache. Repeated reads are served directly from memory.","locale":"en"},"2346":{"id":"/docs/User-Manuals/Key-Features/fuse-46","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-page-cache","content":"Curvine optimization: Curvine tracks opened files. If a file is modified, the page cache automatically becomes invalid to ensure the latest data is read.","locale":"en"},"2347":{"id":"/docs/User-Manuals/Key-Features/fuse-47","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-page-cache","content":"Performance: repeatedly reading the same file can achieve microsecond-level latency and throughput of dozens of GiB per second, which is extremely fast.","locale":"en"},"2348":{"id":"/docs/User-Manuals/Key-Features/fuse-48","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#1-kernel-page-cache","content":"It is enabled by default. When memory is insufficient, `direct_io = true` can be configured to disable page cache.","locale":"en"},"2349":{"id":"/docs/User-Manuals/Key-Features/fuse-49","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-kernel-writeback-cache","content":"Kernel requirement: Linux kernel 3.15 or later is required. This is a FUSE-specific feature.","locale":"en"},"2350":{"id":"/docs/User-Manuals/Key-Features/fuse-50","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-kernel-writeback-cache","content":"Principle: the kernel merges many small, high-frequency random write requests and writes them in batches, reducing the number of I/O operations and improving random write performance.","locale":"en"},"2351":{"id":"/docs/User-Manuals/Key-Features/fuse-51","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-kernel-writeback-cache","content":"Side effect: it converts sequential writes into random writes, seriously reducing sequential write performance.","locale":"en"},"2352":{"id":"/docs/User-Manuals/Key-Features/fuse-52","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#2-kernel-writeback-cache","content":"It is disabled by default and must be manually enabled. It is only suitable for scenarios with many random writes and is not recommended for sequential write scenarios.","locale":"en"},"2353":{"id":"/docs/User-Manuals/Key-Features/fuse-53","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#5-fuse-version-selection","content":"Recommended configuration: Linux kernel version 5.0 or later, such as Ubuntu 22.04 and Rocky Linux 9. This can deliver the best FUSE performance, and the asynchronous and cache features are fully adapted.","locale":"en"},"2354":{"id":"/docs/User-Manuals/Key-Features/fuse-54","page_id":"/docs/User-Manuals/Key-Features/fuse","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/fuse#5-fuse-version-selection","content":"Low-kernel risk: when the kernel version is lower than 4.15, FUSE concurrency capability is poor and performance bottlenecks are obvious. It is not recommended for production environments.","locale":"en"},"2355":{"id":"/docs/User-Manuals/Key-Features","page_id":"/docs/User-Manuals/Key-Features","type":"page","content":"Key Features","breadcrumbs":["Documents","User Manuals","Key Features"],"tags":[],"url":"/docs/User-Manuals/Key-Features","locale":"en"},"2356":{"id":"/docs/User-Manuals/Key-Features/ufs","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"page","content":"Unified Namespace","breadcrumbs":["Documents","User Manuals","Key Features"],"tags":[],"url":"/docs/User-Manuals/Key-Features/ufs","locale":"en"},"2357":{"id":"/docs/User-Manuals/Key-Features/ufs-0","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"1. UFS Mounting","locale":"en"},"2358":{"id":"/docs/User-Manuals/Key-Features/ufs-1","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#mounting","content":"2. Mount Commands","locale":"en"},"2359":{"id":"/docs/User-Manuals/Key-Features/ufs-2","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#21-local-directory-mounting","content":"2.1 Local Directory Mounting","locale":"en"},"2360":{"id":"/docs/User-Manuals/Key-Features/ufs-3","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"2.2 External Storage Mounting","locale":"en"},"2361":{"id":"/docs/User-Manuals/Key-Features/ufs-4","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"2.3 Complete Mount Parameter Table","locale":"en"},"2362":{"id":"/docs/User-Manuals/Key-Features/ufs-5","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"3. View Existing Mount Points","locale":"en"},"2363":{"id":"/docs/User-Manuals/Key-Features/ufs-6","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#mount-modes","content":"4. Mount Modes","locale":"en"},"2364":{"id":"/docs/User-Manuals/Key-Features/ufs-7","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"4.1 cache_mode: High-Performance Read Cache","locale":"en"},"2365":{"id":"/docs/User-Manuals/Key-Features/ufs-8","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"4.2 fs_mode: Layered File System","locale":"en"},"2366":{"id":"/docs/User-Manuals/Key-Features/ufs-9","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#5-unified-access","content":"5. Unified Access","locale":"en"},"2367":{"id":"/docs/User-Manuals/Key-Features/ufs-10","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"6. Space Release","locale":"en"},"2368":{"id":"/docs/User-Manuals/Key-Features/ufs-11","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#7-disable-unified-access","content":"7. Disable Unified Access","locale":"en"},"2369":{"id":"/docs/User-Manuals/Key-Features/ufs-12","page_id":"/docs/User-Manuals/Key-Features/ufs","type":"heading","tags":[],"url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"8. Summary","locale":"en"},"2370":{"id":"/docs/User-Manuals/Key-Features/ufs-13","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs","content":"Curvine provides a UFS (Unified File System) view to manage all supported distributed storage systems, including local filesystems, S3/MinIO, HDFS, and others. In simple terms, Curvine UFS mounting creates a path mapping that integrates external storage systems into Curvine's own filesystem. Users no longer need to remember different storage access methods and can access all storage through one unified interface.","locale":"en"},"2371":{"id":"/docs/User-Manuals/Key-Features/ufs-14","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"Two core path concepts are involved in UFS mounting:","locale":"en"},"2372":{"id":"/docs/User-Manuals/Key-Features/ufs-15","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"UFS path: the original external storage address. It must include a dedicated scheme prefix, which is the native address of the storage system. Common formats include local directories such as `file://fs/cache_mode`, object storage such as `s3://bucket/prefix`, and big data storage such as `hdfs://nn/path`.","locale":"en"},"2373":{"id":"/docs/User-Manuals/Key-Features/ufs-16","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"Curvine path, or CV path: the unified logical path inside the cluster. It always starts with `/` and belongs to Curvine's `cv://` namespace. On the client side, it is the mount point directory that users can directly access.","locale":"en"},"2374":{"id":"/docs/User-Manuals/Key-Features/ufs-17","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"The core value of mounting is that after the mount is complete, regardless of whether the underlying storage is a local disk, S3 object storage, or HDFS, users only need one set of Curvine commands to operate it and do not need to care about differences between storage types.","locale":"en"},"2375":{"id":"/docs/User-Manuals/Key-Features/ufs-18","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"Curvine persists the mount table in metadata, so there is no need to remount when Curvine restarts. However, some rules must be followed:","locale":"en"},"2376":{"id":"/docs/User-Manuals/Key-Features/ufs-19","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"Mounting to the root path is not allowed.","locale":"en"},"2377":{"id":"/docs/User-Manuals/Key-Features/ufs-20","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"Mounting another UFS under an existing mounted path is not allowed.","locale":"en"},"2378":{"id":"/docs/User-Manuals/Key-Features/ufs-21","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#1-ufs-mounting","content":"The same Curvine mount path cannot be mounted to different UFS paths.","locale":"en"},"2379":{"id":"/docs/User-Manuals/Key-Features/ufs-22","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#mounting","content":"All mount commands are executed under the Curvine installation directory. The basic command format is fixed:","locale":"en"},"2380":{"id":"/docs/User-Manuals/Key-Features/ufs-23","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#21-local-directory-mounting","content":"This is suitable for local testing and quickly trying the unified namespace without connecting to external storage.","locale":"en"},"2381":{"id":"/docs/User-Manuals/Key-Features/ufs-24","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#21-local-directory-mounting","content":"This command mounts the local `file://fs/cache_mode` directory to the internal Curvine path `/fs/cache_mode`, using cache mode (`cache_mode`) as the write mode.","locale":"en"},"2382":{"id":"/docs/User-Manuals/Key-Features/ufs-25","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"When connecting to object storage such as S3 or OSS, additional parameters such as endpoint, credentials, and region are required. Replace them with your own storage information.","locale":"en"},"2383":{"id":"/docs/User-Manuals/Key-Features/ufs-26","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"Required parameters for beginners:","locale":"en"},"2384":{"id":"/docs/User-Manuals/Key-Features/ufs-27","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"`s3.endpoint_url`: access address of the S3/MinIO service.","locale":"en"},"2385":{"id":"/docs/User-Manuals/Key-Features/ufs-28","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"`s3.credentials.access` / `s3.credentials.secret`: access key and secret of the storage service.","locale":"en"},"2386":{"id":"/docs/User-Manuals/Key-Features/ufs-29","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"`s3.region_name`: region of the storage service. Use `cn` if there is no special requirement.","locale":"en"},"2387":{"id":"/docs/User-Manuals/Key-Features/ufs-30","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"`s3.force.path.style`: addressing mode passed to the S3 client. `true` (default) uses path-style (`http://endpoint/bucket/key`), which is what AWS S3, MinIO, Ceph RGW, localstack and most on-prem gateways expect. Set to `false` for buckets that only accept virtual-host-style addressing (e.g. Volcengine TOS, Alibaba Cloud OSS over the S3 API), where the bucket is encoded as a hostname prefix (`http://bucket.endpoint/key`).","locale":"en"},"2388":{"id":"/docs/User-Manuals/Key-Features/ufs-31","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"`s3.list_objects_version`: which S3 ListObjects API version to use when listing a bucket. `v2` (default) uses ListObjects V2. Set to `v1` for buckets that are incompatible with V2 listing — notably Baidu BOS, which returns `IsTruncated=true` without a `NextContinuationToken` and makes the V2 lister loop forever, so the mount appears to hang. V1 listing uses the last object key as the pagination marker and works around such non-compliant services.","locale":"en"},"2389":{"id":"/docs/User-Manuals/Key-Features/ufs-32","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#22-external-storage-mounting","content":"For `s3://...` mounts, the CLI can auto-fill `s3.bucket_name` from the URI. For `hdfs://...` mounts, it can infer `hdfs.namenode` and `hdfs.root` from the URI. When Kerberos keys are present without `hdfs.kerberos.ccache` or `KRB5CCNAME`, the CLI prints a warning.","locale":"en"},"2390":{"id":"/docs/User-Manuals/Key-Features/ufs-33","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter  | Default | Description                                                                                                                                 |\n| ---------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `ufs_path` | none    | External underlying storage URI path. It must include a scheme prefix such as `s3://`, `oss://`, or `file://`; otherwise the command fails. |","locale":"en","table":"table-0"},"2391":{"id":"/docs/User-Manuals/Key-Features/ufs-34","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter | Default | Description                                                                                                                     |\n| --------- | ------- | ------------------------------------------------------------------------------------------------------------------------------- |\n| `cv_path` | none    | Curvine internal logical mount path. It must start with `/` and only supports absolute paths. Relative paths are not supported. |","locale":"en","table":"table-0"},"2392":{"id":"/docs/User-Manuals/Key-Features/ufs-35","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter      | Default   | Description                                                                                  |\n| -------------- | --------- | -------------------------------------------------------------------------------------------- |\n| `--write-type` | `fs_mode` | Mount write mode. This is a core parameter. Supported values are `cache_mode` and `fs_mode`. |","locale":"en","table":"table-0"},"2393":{"id":"/docs/User-Manuals/Key-Features/ufs-36","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter  | Default | Description                                                                                                                                                                              |\n| ---------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--update` | `false` | Flag used to update configuration when the mount point already exists. The mount path (`ufs_path` + `cv_path`) cannot be changed. Without this flag, repeated mounting reports an error. |","locale":"en","table":"table-0"},"2394":{"id":"/docs/User-Manuals/Key-Features/ufs-37","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter              | Default | Description                                                                                                                                    |\n| ---------------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--check-path-consist` | `true`  | Checks whether the path parts of the UFS path and CV path are consistent when creating a mount. Set to `false` to allow different path shapes. |","locale":"en","table":"table-0"},"2395":{"id":"/docs/User-Manuals/Key-Features/ufs-38","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter           | Default | Description                                                                                                                                                                                           |\n| ------------------- | ------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--read-verify-ufs` | `false` | Only effective in `cache_mode`. When set to `true`, Curvine compares UFS file `mtime` and size before reading cache. If they are inconsistent, the cache is invalidated and data is re-read from UFS. |","locale":"en","table":"table-0"},"2396":{"id":"/docs/User-Manuals/Key-Features/ufs-39","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter  | Default | Description                                                                                                          |\n| ---------- | ------- | -------------------------------------------------------------------------------------------------------------------- |\n| `--ttl-ms` | `7d`    | Cache expiration time of the mount point. Human-readable units are supported, such as `7d`, `1h`, `30m`, and `100s`. |","locale":"en","table":"table-0"},"2397":{"id":"/docs/User-Manuals/Key-Features/ufs-40","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter    | Default | Description                                                                                           |\n| ------------ | ------- | ----------------------------------------------------------------------------------------------------- |\n| `--replicas` | none    | File replica count. If not set, file creation falls back to the client default replica configuration. |","locale":"en","table":"table-0"},"2398":{"id":"/docs/User-Manuals/Key-Features/ufs-41","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter      | Default | Description                                                                                           |\n| -------------- | ------- | ----------------------------------------------------------------------------------------------------- |\n| `--block-size` | none    | File block size. If not set, file creation falls back to the client default block size configuration. |","locale":"en","table":"table-0"},"2399":{"id":"/docs/User-Manuals/Key-Features/ufs-42","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter              | Default | Description                                                                        |\n| ---------------------- | ------- | ---------------------------------------------------------------------------------- |\n| `--storage-type`, `-s` | none    | Curvine local storage media type. Optional values include `mem`, `ssd`, and `hdd`. |","locale":"en","table":"table-0"},"2400":{"id":"/docs/User-Manuals/Key-Features/ufs-43","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"| Parameter    | Default                                  | Description                                                                                                                                |\n| ------------ | ---------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------ |\n| `--provider` | not set, underlying default is `opendal` | UFS backend implementation. Optional values include `auto`, `oss-hdfs`, and `opendal`. The default `opendal` works for most storage types. |","locale":"en","table":"table-0"},"2401":{"id":"/docs/User-Manuals/Key-Features/ufs-44","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#23-complete-mount-parameter-table","content":"Full mount command template:","locale":"en"},"2402":{"id":"/docs/User-Manuals/Key-Features/ufs-45","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"After mounting, run the following command to view all configured mount points in the cluster:","locale":"en"},"2403":{"id":"/docs/User-Manuals/Key-Features/ufs-46","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"Example output:","locale":"en"},"2404":{"id":"/docs/User-Manuals/Key-Features/ufs-47","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"`ID`: unique mount point identifier automatically generated by the system.","locale":"en"},"2405":{"id":"/docs/User-Manuals/Key-Features/ufs-48","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"`Curvine Path` / `UFS Path`: internal and external paths. Use them to check whether the configuration is correct.","locale":"en"},"2406":{"id":"/docs/User-Manuals/Key-Features/ufs-49","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"`Write Type`: core read/write mode, `cache_mode` or `fs_mode`.","locale":"en"},"2407":{"id":"/docs/User-Manuals/Key-Features/ufs-50","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#3-view-existing-mount-points","content":"`TTL Action`: cache expiration handling policy.","locale":"en"},"2408":{"id":"/docs/User-Manuals/Key-Features/ufs-51","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"`cache_mode` uses Curvine as a cache acceleration layer for external storage. Directory structure and original data are based on the external UFS, while Curvine only provides cached reads to improve read performance.","locale":"en"},"2409":{"id":"/docs/User-Manuals/Key-Features/ufs-52","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Core logic:","locale":"en"},"2410":{"id":"/docs/User-Manuals/Key-Features/ufs-53","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Directory listing and modification operations directly access external UFS to keep the view up to date.","locale":"en"},"2411":{"id":"/docs/User-Manuals/Key-Features/ufs-54","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"File attribute queries first check Curvine cache. Valid cache is returned directly, and invalid cache falls back to UFS.","locale":"en"},"2412":{"id":"/docs/User-Manuals/Key-Features/ufs-55","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"The fixed expiration policy is `ttl_action=delete`. After cache expires, files and directories in Curvine are completely deleted, while data in external UFS remains.","locale":"en"},"2413":{"id":"/docs/User-Manuals/Key-Features/ufs-56","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Read operations:","locale":"en"},"2414":{"id":"/docs/User-Manuals/Key-Features/ufs-57","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Cache miss: Curvine reads external UFS directly and asynchronously loads data into Curvine cache in the background. The next read can use cache and is faster.","locale":"en"},"2415":{"id":"/docs/User-Manuals/Key-Features/ufs-58","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Cache hit: Curvine reads directly from cache without accessing UFS.","locale":"en"},"2416":{"id":"/docs/User-Manuals/Key-Features/ufs-59","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Risk: within the cache validity period, if external UFS data is modified by other tools, Curvine cache will not automatically update and may return stale data.","locale":"en"},"2417":{"id":"/docs/User-Manuals/Key-Features/ufs-60","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Solution: for frequently updated data, add `--read-verify-ufs=true` when mounting. Before each read, Curvine compares UFS file modification time and size. If they differ, Curvine reloads data. The cost is one extra UFS query, so reads are slightly slower.","locale":"en"},"2418":{"id":"/docs/User-Manuals/Key-Features/ufs-61","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Write operations:","locale":"en"},"2419":{"id":"/docs/User-Manuals/Key-Features/ufs-62","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Writes are directly passed through to external UFS, and Curvine cache is invalidated.","locale":"en"},"2420":{"id":"/docs/User-Manuals/Key-Features/ufs-63","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Deleting a file directly deletes the original data in UFS, not only the cache. Use this operation carefully.","locale":"en"},"2421":{"id":"/docs/User-Manuals/Key-Features/ufs-64","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Capability boundaries and limits:","locale":"en"},"2422":{"id":"/docs/User-Manuals/Key-Features/ufs-65","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"POSIX file semantics fully depend on external UFS support. Operations not supported by UFS, such as symbolic links or file locks, may fail directly.","locale":"en"},"2423":{"id":"/docs/User-Manuals/Key-Features/ufs-66","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Some advanced operations, such as modifying file attributes, symbolic links, and file locks, are limited by the current Curvine version and UFS capabilities.","locale":"en"},"2424":{"id":"/docs/User-Manuals/Key-Features/ufs-67","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Cache invalidation conditions:","locale":"en"},"2425":{"id":"/docs/User-Manuals/Key-Features/ufs-68","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Cache reaches the TTL expiration time.","locale":"en"},"2426":{"id":"/docs/User-Manuals/Key-Features/ufs-69","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"Writes, modifications, or deletes are performed through Curvine.","locale":"en"},"2427":{"id":"/docs/User-Manuals/Key-Features/ufs-70","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#41-cache_mode-high-performance-read-cache","content":"After `--read-verify-ufs` is enabled, UFS file modification time or size differs from Curvine records.","locale":"en"},"2428":{"id":"/docs/User-Manuals/Key-Features/ufs-71","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"`fs_mode` breaks away from UFS semantic limitations and provides full POSIX filesystem capabilities. All operations are completed inside Curvine first and then asynchronously synchronized to external UFS. It is suitable for business scenarios requiring standard file operations.","locale":"en"},"2429":{"id":"/docs/User-Manuals/Key-Features/ufs-72","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Core logic:","locale":"en"},"2430":{"id":"/docs/User-Manuals/Key-Features/ufs-73","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"All data operations go through Curvine first instead of direct client writes to UFS. Usage is the same as a normal Curvine directory that is not mounted to external storage.","locale":"en"},"2431":{"id":"/docs/User-Manuals/Key-Features/ufs-74","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Operation logs are synchronized to all Master nodes through the Raft protocol. The Leader node replays them and synchronizes changes to external UFS, ensuring eventual consistency between Curvine and UFS.","locale":"en"},"2432":{"id":"/docs/User-Manuals/Key-Features/ufs-75","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"UFS synchronization rules:","locale":"en"},"2433":{"id":"/docs/User-Manuals/Key-Features/ufs-76","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"| Operation Type             | Behavior Synchronized to UFS                                                      |\n| -------------------------- | --------------------------------------------------------------------------------- |\n| Create directory (`mkdir`) | Leader Master automatically accesses UFS and creates the corresponding directory. |","locale":"en","table":"table-1"},"2434":{"id":"/docs/User-Manuals/Key-Features/ufs-77","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"| Operation Type                   | Behavior Synchronized to UFS                                            |\n| -------------------------------- | ----------------------------------------------------------------------- |\n| Delete file/directory (`delete`) | Leader Master automatically deletes data at the corresponding UFS path. |","locale":"en","table":"table-1"},"2435":{"id":"/docs/User-Manuals/Key-Features/ufs-78","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"| Operation Type                   | Behavior Synchronized to UFS                                             |\n| -------------------------------- | ------------------------------------------------------------------------ |\n| File write complete (`complete`) | Starts a data synchronization task to copy the file from Curvine to UFS. |","locale":"en","table":"table-1"},"2436":{"id":"/docs/User-Manuals/Key-Features/ufs-79","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"| Operation Type    | Behavior Synchronized to UFS                                                                                                                                |\n| ----------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Rename (`rename`) | If UFS supports rename, execute it directly. If UFS does not support rename, such as S3/OSS, delete the source path and fully copy data to the target path. |","locale":"en","table":"table-1"},"2437":{"id":"/docs/User-Manuals/Key-Features/ufs-80","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Object storage systems such as S3 and OSS do not support rename. Do not rename large directories on these backends. It triggers a full data copy, takes a long time, blocks subsequent operations, and may generate significant storage and bandwidth costs.","locale":"en"},"2438":{"id":"/docs/User-Manuals/Key-Features/ufs-81","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Metadata synchronization:","locale":"en"},"2439":{"id":"/docs/User-Manuals/Key-Features/ufs-82","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"In `fs_mode`, Curvine does not automatically detect external UFS data changes. If files are modified, added, or deleted directly in S3/HDFS, the Curvine directory is not updated automatically. Run a metadata alignment command manually:","locale":"en"},"2440":{"id":"/docs/User-Manuals/Key-Features/ufs-83","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Replace the path with your own Curvine mount path. In production, run this regularly or after external changes.","locale":"en"},"2441":{"id":"/docs/User-Manuals/Key-Features/ufs-84","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"Data expiration rules:","locale":"en"},"2442":{"id":"/docs/User-Manuals/Key-Features/ufs-85","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"After data expires, only the actual data in Curvine is cleaned. Metadata is retained, and external UFS data is not affected.","locale":"en"},"2443":{"id":"/docs/User-Manuals/Key-Features/ufs-86","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"When read again, data is automatically loaded back from UFS to Curvine and can be accessed normally.","locale":"en"},"2444":{"id":"/docs/User-Manuals/Key-Features/ufs-87","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#42-fs_mode-layered-file-system","content":"When writing after expiration, Curvine first copies the original data in UFS back to Curvine and then performs the write in Curvine. This is because most UFS backends, especially S3/OSS object storage, do not support standard POSIX features such as random writes, file holes, and incremental modification. Copying large files may take time and is expected behavior.","locale":"en"},"2445":{"id":"/docs/User-Manuals/Key-Features/ufs-88","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#5-unified-access","content":"After UFS is mounted, Curvine provides a unified filesystem view. Clients, command-line tools, FUSE, and APIs can all access UFS files through the unified Curvine path.","locale":"en"},"2446":{"id":"/docs/User-Manuals/Key-Features/ufs-89","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#5-unified-access","content":"If using the `cv` command, you can use `--cache-only` to temporarily disable unified access and view only files cached in Curvine. See the CLI page for details.","locale":"en"},"2447":{"id":"/docs/User-Manuals/Key-Features/ufs-90","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"In `cache_mode`, deleting a file directly deletes the original UFS data. If you only want to release Curvine local cache space while retaining UFS original data and metadata, use the `free` command. It is safe and does not delete data that does not meet cleanup conditions.","locale":"en"},"2448":{"id":"/docs/User-Manuals/Key-Features/ufs-91","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"`-r`: recursively cleans all eligible cache under the directory.","locale":"en"},"2449":{"id":"/docs/User-Manuals/Key-Features/ufs-92","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"Applicable scope: `fs_mode`, `cache_mode`, and normal directories not mounted to UFS.","locale":"en"},"2450":{"id":"/docs/User-Manuals/Key-Features/ufs-93","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"Safety guarantee: files that do not meet cleanup conditions are automatically skipped, such as files without TTL or data not synchronized to UFS.","locale":"en"},"2451":{"id":"/docs/User-Manuals/Key-Features/ufs-94","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#6-space-release","content":"Cleanup condition: the file exists in both Curvine and UFS, and `ttl_action != none`.","locale":"en"},"2452":{"id":"/docs/User-Manuals/Key-Features/ufs-95","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#7-disable-unified-access","content":"If you do not want to use unified access, add or modify the following configuration:","locale":"en"},"2453":{"id":"/docs/User-Manuals/Key-Features/ufs-96","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"Choose the mode based on the scenario: use `cache_mode` for read-heavy workloads and `fs_mode` for write-heavy workloads.","locale":"en"},"2454":{"id":"/docs/User-Manuals/Key-Features/ufs-97","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"Mount commands must strictly follow `UFS path with scheme + Curvine path starting with /`.","locale":"en"},"2455":{"id":"/docs/User-Manuals/Key-Features/ufs-98","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"In `cache_mode`, deleting files directly deletes UFS data. Use caution.","locale":"en"},"2456":{"id":"/docs/User-Manuals/Key-Features/ufs-99","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"In `fs_mode`, do not rename large S3/OSS directories.","locale":"en"},"2457":{"id":"/docs/User-Manuals/Key-Features/ufs-100","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"After external UFS data changes, `fs_mode` must use `resync` to synchronize metadata manually.","locale":"en"},"2458":{"id":"/docs/User-Manuals/Key-Features/ufs-101","page_id":"/docs/User-Manuals/Key-Features/ufs","tags":[],"type":"text","url":"/docs/User-Manuals/Key-Features/ufs#8-summary","content":"Use `free` to release cache safely without deleting original data.","locale":"en"},"2459":{"id":"/docs/User-Manuals/Operations/cli","page_id":"/docs/User-Manuals/Operations/cli","type":"page","content":"Command Line Tools","breadcrumbs":["Documents","User Manuals","Operations"],"tags":[],"url":"/docs/User-Manuals/Operations/cli","locale":"en"},"2460":{"id":"/docs/User-Manuals/Operations/cli-0","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#native-cli-cv","content":"Native CLI: `cv`","locale":"en"},"2461":{"id":"/docs/User-Manuals/Operations/cli-1","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#1-report-cluster-status","content":"1. `report`: cluster status","locale":"en"},"2462":{"id":"/docs/User-Manuals/Operations/cli-2","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#2-node-worker-management","content":"2. `node`: worker management","locale":"en"},"2463":{"id":"/docs/User-Manuals/Operations/cli-3","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#3-fs-file-system-operations","content":"3. `fs`: file system operations","locale":"en"},"2464":{"id":"/docs/User-Manuals/Operations/cli-4","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#4-mount-mount-ufs-into-curvine","content":"4. `mount`: mount UFS into Curvine","locale":"en"},"2465":{"id":"/docs/User-Manuals/Operations/cli-5","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#5-umount-remove-a-mount","content":"5. `umount`: remove a mount","locale":"en"},"2466":{"id":"/docs/User-Manuals/Operations/cli-6","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"/docs/User-Manuals/Operations/cli#6-load-submit-a-load-job","content":"6. `load`: submit a Load job","locale":"en"},"2467":{"id":"/docs/User-Manuals/Operations/cli-7","page_id":"/docs/User-Manuals/Operations/cli","type":"heading","tags":[],"url":"