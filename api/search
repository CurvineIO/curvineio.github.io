-66","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#1-create-the-cacheruntimeclass","content":"The script runs:","locale":"en"},"69":{"id":"/docs/Architecture/fluid-integration-67","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#1-create-the-cacheruntimeclass","content":"It prints strict JSON to stdout, as required by Fluid's ReportSummary contract:","locale":"en"},"70":{"id":"/docs/Architecture/fluid-integration-68","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#1-create-the-cacheruntimeclass","content":"Curvine reports values that the master can return cheaply: cached bytes, cache capacity, and file count. `ufsTotal`, `cachedPercentage`, and `cacheHitRatio` stay `0` until Curvine has authoritative UFS total and hit-ratio metadata. This avoids showing a cache-capacity percentage as a Dataset cache percentage.","locale":"en"},"71":{"id":"/docs/Architecture/fluid-integration-69","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#2-create-the-dataset-and-cacheruntime","content":"Start from:","locale":"en"},"72":{"id":"/docs/Architecture/fluid-integration-70","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#2-create-the-dataset-and-cacheruntime","content":"Apply it:","locale":"en"},"73":{"id":"/docs/Architecture/fluid-integration-71","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#2-create-the-dataset-and-cacheruntime","content":"The example contains both resources:","locale":"en"},"74":{"id":"/docs/Architecture/fluid-integration-72","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#2-create-the-dataset-and-cacheruntime","content":"`Dataset.spec.mounts[].mountPoint` is the backend path that Curvine exposes through Fluid. The application pod later mounts the Dataset PVC, not this raw backend path.","locale":"en"},"75":{"id":"/docs/Architecture/fluid-integration-73","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#3-wait-for-the-runtime","content":"Check the Fluid resources and Curvine pods:","locale":"en"},"76":{"id":"/docs/Architecture/fluid-integration-74","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#3-wait-for-the-runtime","content":"If the Dataset is not ready, inspect the Dataset and the Curvine pod logs:","locale":"en"},"77":{"id":"/docs/Architecture/fluid-integration-75","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#4-run-the-test-pod","content":"Use the sample workload:","locale":"en"},"78":{"id":"/docs/Architecture/fluid-integration-76","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#4-run-the-test-pod","content":"Apply it and read the logs:","locale":"en"},"79":{"id":"/docs/Architecture/fluid-integration-77","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#4-run-the-test-pod","content":"The pod mounts the Fluid PVC backed by Curvine and performs a simple read/write check.","locale":"en"},"80":{"id":"/docs/Architecture/fluid-integration-78","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"/docs/Architecture/fluid-integration#how-cacheruntime-config-is-generated","content":"CacheRuntime pods do not use a static hand-written TOML file.","locale":"en"},"81":{"id":"/docs/Architecture/fluid-integration-79","page_id":"/docs/Architecture/fluid-integration","tags":[],"type":"text","url":"