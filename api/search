s are not supplied |","locale":"en","table":"table-16"},"1298":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-379","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"| Field      | Default | Meaning           |\n| ---------- | ------- | ----------------- |\n| `rpc_port` | `9010`  | Transfer RPC port |","locale":"en","table":"table-16"},"1299":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-380","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"| Field      | Default | Meaning                      |\n| ---------- | ------- | ---------------------------- |\n| `web_port` | `9011`  | Health and metrics HTTP port |","locale":"en","table":"table-16"},"1300":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-381","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"| Field       | Default                     | Meaning                                                                      |\n| ----------- | --------------------------- | ---------------------------------------------------------------------------- |\n| `endpoints` | `[\"<hostname>:<rpc_port>\"]` | Client-facing Transfer RPC addresses; use a Service or load-balancer address |","locale":"en","table":"table-16"},"1301":{"id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf-382","page_id":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf","tags":[],"type":"text","url":"/docs/Deploy/Deploy-Curvine-Cluster/Distributed-Mode/conf#transfer","content":"| Field         | Default | Meaning                                                          |\n| ------------- | ------- | -